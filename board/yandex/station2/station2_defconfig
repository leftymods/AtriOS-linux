# Architecture
BR2_aarch64=y
BR2_cortex_a53=y

# System Configuration
BR2_TARGET_GENERIC_HOSTNAME="atrios-stationmax"
BR2_TARGET_GENERIC_ISSUE="Welcome to AtriOS Linux [Yandex Station Max S905X3]"
BR2_ROOTFS_OVERLAY="../board/yandex/station2/rootfs_overlay"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# The Station Max runs the stock Amlogic 4.9.113 kernel, so the userspace
# toolchain must be built against 4.9 headers (not Buildroot's default 6.6).
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.9.113"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_9=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System utilities & Hardware
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_PYTHON3=y

# Audio Stack
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y

# Wireless & Remote Access
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_IW=y

# Target Filesystem
BR2_TARGET_ROOTFS_TAR=y
