// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree Source for AtriOS-aml Station Max (leftymods) (Quasar 2 / Station 2)
 * Based on Amlogic Meson SM1 (S905X3) SoC
 * Compatible with Mainline Linux 6.x / 7.0+
 */

/dts-v1/;

#include "meson-sm1.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/meson-g12a-gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/sound/meson-g12a-tohdmitx.h>

/ {
	compatible = "leftymods,station-max", "amlogic,sm1";
	model = "AtriOS-aml Station Max (leftymods)";
	amlogic-dt-id = "yandex_station_2g";

	aliases {
		serial0 = &uart_AO;
		serial1 = &uart_AO_B;
		serial2 = &uart_A;
		ethernet0 = &ethmac;
		spi0 = &spicc1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>; /* 2GB DDR4 */
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>; /* PWM_E at 32.768KHz */
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio GPIOX_6 GPIO_ACTIVE_LOW>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
	};

	/* Fixed voltage regulators */
	vddio_ao1v8: fixedregulator_1v8d: regulator-1v8d {
		compatible = "regulator-fixed";
		regulator-name = "1V8_D";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	fixedregulator_3v3d: regulator-3v3d {
		compatible = "regulator-fixed";
		regulator-name = "3V3_D";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	fixedregulator_20v_amp: regulator-20v-amp {
		compatible = "regulator-fixed";
		regulator-name = "20V_AMPL";
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
		gpio = <&gpio GPIOX_9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	vddio_ao18: regulator-vddio_ao18 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/* Rotary Volume Encoder (GPIOC_7 / GPIOAO_10) */
	rotary_volume: rotary-volume {
		compatible = "rotary-volume";
		status = "okay";
		gpios = <&gpio GPIOC_7 GPIO_ACTIVE_HIGH>,
			<&gpio_ao GPIOAO_10 GPIO_ACTIVE_HIGH>;
		key-codes = <KEY_VOLUMEUP KEY_VOLUMEDOWN>; /* 115, 114 */
	};

	/* Top Buttons (Action KEY_VOICECOMMAND 582, Mic Mute KEY_MICMUTE 248) */
	gpio_keypad: gpio-keypad {
		compatible = "gpio_keypad";
		status = "okay";
		scan_period = <20>;
		key_num = <2>;
		key_name = "micmute", "function";
		key_code = <KEY_MICMUTE KEY_VOICECOMMAND>;
		key-gpios = <&gpio GPIOA_14 GPIO_ACTIVE_HIGH>,
			    <&gpio GPIOA_15 GPIO_ACTIVE_HIGH>;
	};

	/* Zigbee Coordinator GPIO Control (zb-reset, zb-boot) */
	zigbee: zigbee-control {
		compatible = "leftymods,zigbee-control";
		status = "okay";
		zb-reset-gpios = <&gpio GPIOX_16 GPIO_ACTIVE_HIGH>;
		zb-boot-gpios = <&gpio GPIOX_10 GPIO_ACTIVE_HIGH>;
	};

	/* PCBA IDs Reader */
	pcba_ids: pcba-ids {
		compatible = "pcba-ids";
		status = "okay";
		i2c-bus = <0>;
		top-eeprom-addr = <0x52>;
		main-eeprom-addr = <0x50>;
		led-eeprom-addr = <0x55>;
	};

	/* Mainline ASoC Sound Card */
	sound {
		compatible = "amlogic,axg-sound-card";
		model = "ATRIOS-AML-SOUND";
		audio-widgets =
			"Headphone", "Headphone Jack",
			"Speaker", "Woofer Speaker",
			"Speaker", "Tweeter Left",
			"Speaker", "Tweeter Right",
			"Microphone", "Mic Array";
		audio-routing =
			"Headphone Jack", "Headphone LOUT",
			"Headphone Jack", "Headphone ROUT",
			"Woofer Speaker", "Woofer OUTP",
			"Woofer Speaker", "Woofer OUTN",
			"Tweeter Left", "Tweeter OUT1",
			"Tweeter Right", "Tweeter OUT2";

		dai-link-0 {
			sound-dai = <&tdmif_b>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec-0 {
				sound-dai = <&sy6045s_woofer>;
			};

			codec-1 {
				sound-dai = <&sy6045s_tweeter>;
			};

			codec-2 {
				sound-dai = <&es8156>;
			};

			codec-3 {
				sound-dai = <&es7210>;
			};
		};

		dai-link-1 {
			sound-dai = <&tdmif_c>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec {
				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_C>;
			};
		};

		dai-link-2 {
			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;

			codec {
				sound-dai = <&hdmi_tx>;
			};
		};
	};
};

/* UART_AO: Debug Console */
&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_a_pins>;
	pinctrl-names = "default";
};

/* UART_AO_B: Auxiliary / Zigbee / MCU */
&uart_AO_B {
	status = "okay";
	pinctrl-0 = <&uart_ao_b_8_9_pins>;
	pinctrl-names = "default";
};

/* UART_A: Realtek RTL8822CS Bluetooth HCI */
&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a_pins>, <&uart_a_cts_rts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth {
		compatible = "realtek,rtl8822cs-bt";
		enable-gpios = <&gpio GPIOX_18 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&gpio GPIOX_19 GPIO_ACTIVE_HIGH>;
	};
};

/* I2C0: LED Ring Controllers, ALS, EEPROM */
&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_sda_z0_pins>, <&i2c0_sck_z1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	/* Lite-On LTR-308ALS-01 Ambient Light Sensor */
	ltr308als01: light-sensor@53 {
		compatible = "liteon,ltr308als01", "liteon,ltr308";
		reg = <0x53>;
		status = "okay";
	};

	/* Top Board EEPROM */
	eeprom_top: eeprom@52 {
		compatible = "atmel,24c02";
		reg = <0x52>;
		pagesize = <16>;
	};

	/* ISSI IS31FL3236A Left LED Driver (Ring LEDs 1..12) */
	is31fl3236a_left: led-controller@3c {
		compatible = "issi,is31fl3236,gva", "issi,is31fl3236";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <0>;
		max-brightness-scale = <200>;
		status = "okay";

		/* 12 RGB LEDs = 36 channels */
		led@1 { reg = <1>; label = "station2:red:ring1"; linux,default-trigger = "led_ring_fb"; };
		led@2 { reg = <2>; label = "station2:green:ring1"; linux,default-trigger = "led_ring_fb"; };
		led@3 { reg = <3>; label = "station2:blue:ring1"; linux,default-trigger = "led_ring_fb"; };
		led@4 { reg = <4>; label = "station2:red:ring2"; linux,default-trigger = "led_ring_fb"; };
		led@5 { reg = <5>; label = "station2:green:ring2"; linux,default-trigger = "led_ring_fb"; };
		led@6 { reg = <6>; label = "station2:blue:ring2"; linux,default-trigger = "led_ring_fb"; };
		led@7 { reg = <7>; label = "station2:red:ring3"; linux,default-trigger = "led_ring_fb"; };
		led@8 { reg = <8>; label = "station2:green:ring3"; linux,default-trigger = "led_ring_fb"; };
		led@9 { reg = <9>; label = "station2:blue:ring3"; linux,default-trigger = "led_ring_fb"; };
		led@10 { reg = <10>; label = "station2:red:ring4"; linux,default-trigger = "led_ring_fb"; };
		led@11 { reg = <11>; label = "station2:green:ring4"; linux,default-trigger = "led_ring_fb"; };
		led@12 { reg = <12>; label = "station2:blue:ring4"; linux,default-trigger = "led_ring_fb"; };
		led@13 { reg = <13>; label = "station2:red:ring5"; linux,default-trigger = "led_ring_fb"; };
		led@14 { reg = <14>; label = "station2:green:ring5"; linux,default-trigger = "led_ring_fb"; };
		led@15 { reg = <15>; label = "station2:blue:ring5"; linux,default-trigger = "led_ring_fb"; };
		led@16 { reg = <16>; label = "station2:red:ring6"; linux,default-trigger = "led_ring_fb"; };
		led@17 { reg = <17>; label = "station2:green:ring6"; linux,default-trigger = "led_ring_fb"; };
		led@18 { reg = <18>; label = "station2:blue:ring6"; linux,default-trigger = "led_ring_fb"; };
		led@19 { reg = <19>; label = "station2:red:ring7"; linux,default-trigger = "led_ring_fb"; };
		led@20 { reg = <20>; label = "station2:green:ring7"; linux,default-trigger = "led_ring_fb"; };
		led@21 { reg = <21>; label = "station2:blue:ring7"; linux,default-trigger = "led_ring_fb"; };
		led@22 { reg = <22>; label = "station2:red:ring8"; linux,default-trigger = "led_ring_fb"; };
		led@23 { reg = <23>; label = "station2:green:ring8"; linux,default-trigger = "led_ring_fb"; };
		led@24 { reg = <24>; label = "station2:blue:ring8"; linux,default-trigger = "led_ring_fb"; };
		led@25 { reg = <25>; label = "station2:red:ring9"; linux,default-trigger = "led_ring_fb"; };
		led@26 { reg = <26>; label = "station2:green:ring9"; linux,default-trigger = "led_ring_fb"; };
		led@27 { reg = <27>; label = "station2:blue:ring9"; linux,default-trigger = "led_ring_fb"; };
		led@28 { reg = <28>; label = "station2:red:ring10"; linux,default-trigger = "led_ring_fb"; };
		led@29 { reg = <29>; label = "station2:green:ring10"; linux,default-trigger = "led_ring_fb"; };
		led@30 { reg = <30>; label = "station2:blue:ring10"; linux,default-trigger = "led_ring_fb"; };
		led@31 { reg = <31>; label = "station2:red:ring11"; linux,default-trigger = "led_ring_fb"; };
		led@32 { reg = <32>; label = "station2:green:ring11"; linux,default-trigger = "led_ring_fb"; };
		led@33 { reg = <33>; label = "station2:blue:ring11"; linux,default-trigger = "led_ring_fb"; };
		led@34 { reg = <34>; label = "station2:red:ring12"; linux,default-trigger = "led_ring_fb"; };
		led@35 { reg = <35>; label = "station2:green:ring12"; linux,default-trigger = "led_ring_fb"; };
		led@36 { reg = <36>; label = "station2:blue:ring12"; linux,default-trigger = "led_ring_fb"; };
	};

	/* ISSI IS31FL3236A Right LED Driver (Ring LEDs 13..24) */
	is31fl3236a_right: led-controller@3f {
		compatible = "issi,is31fl3236,gva", "issi,is31fl3236";
		reg = <0x3f>;
		#address-cells = <1>;
		#size-cells = <0>;
		max-brightness-scale = <200>;
		status = "okay";

		/* 12 RGB LEDs = 36 channels */
		led@1 { reg = <1>; label = "station2:red:ring13"; linux,default-trigger = "led_ring_fb"; };
		led@2 { reg = <2>; label = "station2:green:ring13"; linux,default-trigger = "led_ring_fb"; };
		led@3 { reg = <3>; label = "station2:blue:ring13"; linux,default-trigger = "led_ring_fb"; };
		led@4 { reg = <4>; label = "station2:red:ring14"; linux,default-trigger = "led_ring_fb"; };
		led@5 { reg = <5>; label = "station2:green:ring14"; linux,default-trigger = "led_ring_fb"; };
		led@6 { reg = <6>; label = "station2:blue:ring14"; linux,default-trigger = "led_ring_fb"; };
		led@7 { reg = <7>; label = "station2:red:ring15"; linux,default-trigger = "led_ring_fb"; };
		led@8 { reg = <8>; label = "station2:green:ring15"; linux,default-trigger = "led_ring_fb"; };
		led@9 { reg = <9>; label = "station2:blue:ring15"; linux,default-trigger = "led_ring_fb"; };
		led@10 { reg = <10>; label = "station2:red:ring16"; linux,default-trigger = "led_ring_fb"; };
		led@11 { reg = <11>; label = "station2:green:ring16"; linux,default-trigger = "led_ring_fb"; };
		led@12 { reg = <12>; label = "station2:blue:ring16"; linux,default-trigger = "led_ring_fb"; };
		led@13 { reg = <13>; label = "station2:red:ring17"; linux,default-trigger = "led_ring_fb"; };
		led@14 { reg = <14>; label = "station2:green:ring17"; linux,default-trigger = "led_ring_fb"; };
		led@15 { reg = <15>; label = "station2:blue:ring17"; linux,default-trigger = "led_ring_fb"; };
		led@16 { reg = <16>; label = "station2:red:ring18"; linux,default-trigger = "led_ring_fb"; };
		led@17 { reg = <17>; label = "station2:green:ring18"; linux,default-trigger = "led_ring_fb"; };
		led@18 { reg = <18>; label = "station2:blue:ring18"; linux,default-trigger = "led_ring_fb"; };
		led@19 { reg = <19>; label = "station2:red:ring19"; linux,default-trigger = "led_ring_fb"; };
		led@20 { reg = <20>; label = "station2:green:ring19"; linux,default-trigger = "led_ring_fb"; };
		led@21 { reg = <21>; label = "station2:blue:ring19"; linux,default-trigger = "led_ring_fb"; };
		led@22 { reg = <22>; label = "station2:red:ring20"; linux,default-trigger = "led_ring_fb"; };
		led@23 { reg = <23>; label = "station2:green:ring20"; linux,default-trigger = "led_ring_fb"; };
		led@24 { reg = <24>; label = "station2:blue:ring20"; linux,default-trigger = "led_ring_fb"; };
		led@25 { reg = <25>; label = "station2:red:ring21"; linux,default-trigger = "led_ring_fb"; };
		led@26 { reg = <26>; label = "station2:green:ring21"; linux,default-trigger = "led_ring_fb"; };
		led@27 { reg = <27>; label = "station2:blue:ring21"; linux,default-trigger = "led_ring_fb"; };
		led@28 { reg = <28>; label = "station2:red:ring22"; linux,default-trigger = "led_ring_fb"; };
		led@29 { reg = <29>; label = "station2:green:ring22"; linux,default-trigger = "led_ring_fb"; };
		led@30 { reg = <30>; label = "station2:blue:ring22"; linux,default-trigger = "led_ring_fb"; };
		led@31 { reg = <31>; label = "station2:red:ring23"; linux,default-trigger = "led_ring_fb"; };
		led@32 { reg = <32>; label = "station2:green:ring23"; linux,default-trigger = "led_ring_fb"; };
		led@33 { reg = <33>; label = "station2:blue:ring23"; linux,default-trigger = "led_ring_fb"; };
		led@34 { reg = <34>; label = "station2:red:ring24"; linux,default-trigger = "led_ring_fb"; };
		led@35 { reg = <35>; label = "station2:green:ring24"; linux,default-trigger = "led_ring_fb"; };
		led@36 { reg = <36>; label = "station2:blue:ring24"; linux,default-trigger = "led_ring_fb"; };
	};
};

/* I2C2: Codecs, Amplifiers, RTC, EEPROMs */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_sda_z_pins>, <&i2c2_sck_z_pins>;
	pinctrl-names = "default";
	clock-frequency = <300000>;

	/* NXP PCF8563 Real Time Clock */
	rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
	};

	/* Everest ES8156 Headphone DAC */
	es8156: codec@8 {
		compatible = "everest,es8156";
		reg = <0x08>;
		#sound-dai-cells = <0>;
		status = "okay";
	};

	/* Silergy SY6045S Tweeters Amplifier (Stereo) */
	sy6045s_tweeter: amplifier@2a {
		compatible = "silergy,sy6045s";
		reg = <0x2a>;
		#sound-dai-cells = <0>;
		vddio-supply = <&fixedregulator_3v3d>;
		pvdd-supply = <&fixedregulator_20v_amp>;
		firmware = "sy6045s-tweeters-settings.txt";
		restore-regs = <0x07 0x01 0xff 0x06 0x01 0x08>;
		status = "okay";
	};

	/* Silergy SY6045S Woofer Amplifier (Mono PBTL) */
	sy6045s_woofer: amplifier@2b {
		compatible = "silergy,sy6045s";
		reg = <0x2b>;
		#sound-dai-cells = <0>;
		vddio-supply = <&fixedregulator_3v3d>;
		pvdd-supply = <&fixedregulator_20v_amp>;
		pbtl-mode;
		firmware = "sy6045s-woofer-settings.txt";
		restore-regs = <0x07 0x01 0xff 0x06 0x01 0x08>;
		status = "okay";
	};

	/* Everest ES7210 4-Channel Microphone ADC */
	es7210: codec@40 {
		compatible = "everest,es7210_2ch", "everest,es7210";
		reg = <0x40>;
		#sound-dai-cells = <0>;
		status = "okay";
	};

	/* Main Board EEPROM */
	eeprom_main: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
	};

	/* Secondary EEPROM */
	eeprom_aux: eeprom@55 {
		compatible = "atmel,24c02";
		reg = <0x55>;
		pagesize = <16>;
	};
};

/* SPICC1: Gowin FPGA LED Matrix Screen Controller */
&spicc1 {
	status = "okay";
	pinctrl-0 = <&spicc1_pins>;
	pinctrl-names = "default";
	cs-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_LOW>;
	#address-cells = <1>;
	#size-cells = <0>;

	quasar_led_screen@0 {
		compatible = "ya,led_screen", "atri,led-panel";
		reg = <0>;
		spi-max-frequency = <4000000>;
		max-brightness = <200>;
		reset-gpios = <&gpio GPIOX_8 GPIO_ACTIVE_LOW>;
		jtag_reconfig-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_HIGH>;
		jtag_sel-gpios = <&gpio_ao GPIOE_2 GPIO_ACTIVE_HIGH>;
		jtag_tck-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_HIGH>;
		jtag_tdi-gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>;
		jtag_tdo-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
		jtag_tms-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/* SD_EMMC_C: On-board eMMC 5.1 */
&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_8b_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default";

	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	non-removable;
	disable-wp;

	mmc-pwrseq = <&emmc_pwrseq>;
	vmmc-supply = <&fixedregulator_3v3d>;
	vqmmc-supply = <&vddio_ao18>;
};

/* SD_EMMC_A: SDIO Wi-Fi (Realtek RTL8822CS) */
&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	max-frequency = <100000000>;
	non-removable;
	disable-wp;
	keep-power-in-suspend;

	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&fixedregulator_3v3d>;
	vqmmc-supply = <&vddio_ao18>;

	rtl8822cs: wifi@1 {
		reg = <1>;
		compatible = "realtek,rtl8822cs";
		interrupt-parent = <&gpio>;
		interrupts = <GPIOX_7 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
	};
};

&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
	clocks = <&xtal>;
	clock-names = "clkin0";
};

/* USB 2.0 / 3.0 Controllers */
&usb {
	status = "okay";
	dr_mode = "otg";
};

/* Ethernet MAC */
&ethmac {
	status = "okay";
	phy-mode = "rmii";
	phy-handle = <&internal_ephy>;
};

/* HDMI Output */
&hdmi_tx {
	status = "okay";
	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
	pinctrl-names = "default";
	hdmi-supply = <&fixedregulator_3v3d>;
};

&hdmi_tx_tmds_port {
	hdmi_tx_tmds_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};
