diff --git a/drivers/net/wireless/realtek/rtw88/coex.c b/drivers/net/wireless/realtek/rtw88/coex.c
index 289fcfc..bb124ad 100644
--- a/drivers/net/wireless/realtek/rtw88/coex.c
+++ b/drivers/net/wireless/realtek/rtw88/coex.c
@@ -2746,6 +2746,16 @@ static void __rtw_coex_init_hw_config(struct rtw_dev *rtwdev, bool wifi_only)
 		rtw_coex_write_scbd(rtwdev, COEX_SCBD_ACTIVE | COEX_SCBD_ONOFF,
 				    true);
 		coex->stop_dm = true;
+		/* Vendor Realtek ex_hal8822e_wifi_only_hw_config: */
+		/* Byte 0x73 = 0x0e (WLAN path owner) */
+		rtw_write8(rtwdev, 0x73, 0x0e);
+		/* LTE indirect 0x38 = 0x7700 (GNT_WL=1, GNT_BT=0) */
+		rtw_coex_write_indirect_reg(rtwdev, 0x38, 0xffff, 0x7700);
+		/* LTE indirect 0xa0 = 0xffff, 0xa4 = 0xffff */
+		rtw_coex_write_indirect_reg(rtwdev, 0xa0, 0xffff, 0xffff);
+		rtw_coex_write_indirect_reg(rtwdev, 0xa4, 0xffff, 0xffff);
+		/* 100% WLAN priority in arbitration tables */
+		rtw_write32(rtwdev, REG_BT_COEX_TABLE0, 0xaaaaaaaa);
+		rtw_write32(rtwdev, REG_BT_COEX_TABLE1, 0xaaaaaaaa);
+		pr_info("[RTW88] wifi_only hardware configured (0x73=0x0e, 0x38=0x7700, tbl=0xaaaaaaaa)\n");
+		return;
 	} else {
 		rtw_coex_set_ant_path(rtwdev, true, COEX_SET_ANT_INIT);
 		rtw_coex_write_scbd(rtwdev, COEX_SCBD_ACTIVE | COEX_SCBD_ONOFF,
@@ -2824,7 +2834,7 @@ void rtw_coex_ips_notify(struct rtw_dev *rtwdev, u8 type)
 	case COEX_IPS_ENTER:
 		coex_stat->ips_mode = true;
 		__rtw_coex_init_hw_config(rtwdev, false);
 		break;
 	case COEX_IPS_LEAVE:
 		coex_stat->ips_mode = false;
-		__rtw_coex_init_hw_config(rtwdev, false);
+		__rtw_coex_init_hw_config(rtwdev, !rtwdev->efuse.btcoex);
 		break;
 	default:
 		break;
