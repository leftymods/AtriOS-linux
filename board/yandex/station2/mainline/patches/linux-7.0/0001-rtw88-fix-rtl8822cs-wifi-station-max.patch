@@ -1183,7 +1183,7 @@ static bool check_positive(struct rtw_dev *rtwdev, struct rtw_phy_cond cond,
 		if ((cond.rfe & BIT(3)) && cond2.type_apa != drv_cond2.type_apa)
 			return false;
 	} else {
-		if (cond.rfe != drv_cond.rfe)
+		if (cond.rfe && cond.rfe != drv_cond.rfe)
 			return false;
 	}
 
@@ -1198,6 +1198,7 @@ void rtw_parse_tbl_phy_cond(struct rtw_dev *rtwdev, const struct rtw_table *tbl)
 	struct rtw_phy_cond pos_cond = {};
 	struct rtw_phy_cond2 pos_cond2 = {};
 	bool is_matched = true, is_skipped = false;
+	u32 count = 0;
 
 	BUILD_BUG_ON(sizeof(union phy_table_tile) != sizeof(struct phy_cfg_pair));
 
@@ -1231,7 +1232,9 @@ void rtw_parse_tbl_phy_cond(struct rtw_dev *rtwdev, const struct rtw_table *tbl)
 			}
 		} else if (is_matched) {
 			(*tbl->do_cfg)(rtwdev, tbl, p->cfg.addr, p->cfg.data);
+			count++;
