 	}
+	pr_info("[RTW88-PHY] table configured %u entries\n", count);
 }
 EXPORT_SYMBOL(rtw_parse_tbl_phy_cond);
diff --git a/drivers/net/wireless/realtek/rtw88/rtw8822c.c b/drivers/net/wireless/realtek/rtw88/rtw8822c.c
