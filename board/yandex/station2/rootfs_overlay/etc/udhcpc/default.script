#!/bin/sh
[ -z "$1" ] && exit 1
case "$1" in
  deconfig)
    ip addr flush dev "$interface"
    ;;
  renew|bound)
    ip addr replace "$ip/$mask" dev "$interface"
    if [ -n "$router" ]; then
      ip route del default dev "$interface" 2>/dev/null || true
      for i in $router; do
        ip route replace default via "$i" dev "$interface"
        break
      done
    fi
    if [ -n "$dns" ]; then
      : > /etc/resolv.conf
      for i in $dns; do
        echo "nameserver $i" >> /etc/resolv.conf
      done
    fi
    ;;
esac
exit 0
