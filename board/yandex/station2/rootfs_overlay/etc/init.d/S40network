#!/bin/sh
#
# Start the network....
#

mkdir -p /run/network /var/run/network

case "$1" in
  start)
	printf "Starting network: "
	ip link set lo up 2>/dev/null || true
	/usr/lib/atrios/rotaryd ifup wlan0 2>/dev/null || ip link set wlan0 up 2>/dev/null || true
	if [ -f /etc/wpa_supplicant.conf ] && command -v wpa_supplicant >/dev/null 2>&1; then
		if ! pgrep -x wpa_supplicant >/dev/null 2>&1; then
			wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf -D nl80211,wext >/dev/null 2>&1 || true
		fi
		if command -v iw >/dev/null 2>&1; then
			iw dev wlan0 set power_save off >/dev/null 2>&1 || true
		fi
		if command -v udhcpc >/dev/null 2>&1 && ! pgrep -f "udhcpc.*wlan0" >/dev/null 2>&1; then
			udhcpc -b -i wlan0 -x hostname:atrios -p /var/run/udhcpc.wlan0.pid >/dev/null 2>&1 || true
		fi
	fi
	echo "OK"
	;;
  stop)
	printf "Stopping network: "
	pkill -f "udhcpc.*wlan0" 2>/dev/null || true
	pkill -x wpa_supplicant 2>/dev/null || true
	echo "OK"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
