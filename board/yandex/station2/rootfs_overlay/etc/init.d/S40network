#!/bin/sh
#
# Start the network....
#

mkdir -p /run/network /var/run/network

case "$1" in
  start)
	printf "Starting network: "
	python3 -c "import socket, struct, fcntl; s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); ifr = struct.pack('16sH', b'wlan0', 0); res = fcntl.ioctl(s.fileno(), 0x8913, ifr); flags = struct.unpack('16sH', res)[1] | 1; fcntl.ioctl(s.fileno(), 0x8914, struct.pack('16sH', b'wlan0', flags))" 2>/dev/null || true
	echo "OK"
	;;
  stop)
	printf "Stopping network: "
	echo "OK"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
