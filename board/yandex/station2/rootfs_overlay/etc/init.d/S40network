#!/bin/sh
#
# Start the network....
#

mkdir -p /run/network /var/run/network

case "$1" in
  start)
	printf "Starting network: "
	ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || true
	/sbin/ifup -a 2>/dev/null || true
	echo "OK"
	;;
  stop)
	printf "Stopping network: "
	/sbin/ifdown -a 2>/dev/null || true
	echo "OK"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
