#!/bin/sh
# /etc/init.d/S01modules - Load Amlogic & Station 2 hardware modules in dependency order

case "$1" in
  start)
    echo "[AtriOS] Loading hardware drivers..."
    # Remove duplicate cfg80211.ko if present since cfg80211 is already built into vmlinux
    rm -f /lib/modules/4.9.113/cfg80211.ko 2>/dev/null || true
    depmod -a 2>/dev/null || true

    # 1. Audio drivers & codecs
    insmod /lib/modules/4.9.113/snd-soc-pcm1774.ko 2>/dev/null || modprobe snd-soc-pcm1774 2>/dev/null
    insmod /lib/modules/4.9.113/snd-soc-pcm1774-i2c.ko 2>/dev/null || modprobe snd-soc-pcm1774-i2c 2>/dev/null
    insmod /lib/modules/4.9.113/snd-soc-es7210.ko 2>/dev/null || modprobe snd-soc-es7210 2>/dev/null
    insmod /lib/modules/4.9.113/snd-soc-es8156.ko 2>/dev/null || modprobe snd-soc-es8156 2>/dev/null
    insmod /lib/modules/4.9.113/snd-soc-sy6045s.ko 2>/dev/null || modprobe snd-soc-sy6045s 2>/dev/null
    insmod /lib/modules/4.9.113/snd-soc-tas5825m.ko 2>/dev/null || modprobe snd-soc-tas5825m 2>/dev/null

    # 2. Rotary knob & sensors
    insmod /lib/modules/4.9.113/rotary-volume.ko 2>/dev/null || modprobe rotary-volume 2>/dev/null
    insmod /lib/modules/4.9.113/ltr308als01.ko 2>/dev/null || modprobe ltr308als01 2>/dev/null

    # 3. Displays: Gowin 25x16 screen & IS31FL32xx LED ring
    insmod /lib/modules/4.9.113/gowin_led_device.ko 2>/dev/null || modprobe gowin_led_device 2>/dev/null
    insmod /lib/modules/4.9.113/quasar_led_screen.ko 2>/dev/null || modprobe quasar_led_screen 2>/dev/null
    insmod /lib/modules/4.9.113/leds-is31fl32xx.ko 2>/dev/null || modprobe leds-is31fl32xx 2>/dev/null
    insmod /lib/modules/4.9.113/quasar_led_ring.ko 2>/dev/null || modprobe quasar_led_ring 2>/dev/null
    for t in /sys/class/leds/*ring*/trigger /sys/class/leds/*led_ring*/trigger; do
      [ -f "$t" ] && echo led_ring_fb > "$t" 2>/dev/null || true
    done

    # 4. Wireless (Realtek RTL8822CS/ES) - Power up SDIO & BT reset GPIO before driver attachment
    if [ -x /usr/lib/atrios/wifi-power ]; then
      /usr/lib/atrios/wifi-power 1 2>/dev/null || true
    elif [ -c /dev/wifi_power ]; then
      python3 -c "import fcntl; f = open('/dev/wifi_power', 'wb'); fcntl.ioctl(f.fileno(), 0x6d03); f.close()" 2>/dev/null || true
    fi
    # Pulse the Bluetooth radio off -> on and LEAVE IT ON.  rfkill state
    # 0 means "unblocked" -> bt_set_block(blocked=0) -> BT_RADIO going: on
    # -> bt_power_on(); state 1 is blocked and cuts the chip's power, which
    # is what left the controller silent in earlier images.  Filter by
    # type so the WLAN rfkill is not touched.
    BT_RESET_DONE=0
    for rfk in /sys/class/rfkill/rfkill*; do
      [ -f "$rfk/state" ] || continue
      [ "$(cat "$rfk/type" 2>/dev/null)" = "bluetooth" ] || continue
      # Amlogic rfkill polarity: state=1 is POWER ON (AML_BT: going ON), state=0 is POWER OFF
      echo 0 > "$rfk/state" 2>/dev/null || true
      usleep 150000 2>/dev/null || sleep 1
      echo 1 > "$rfk/state" 2>/dev/null || true
      usleep 400000 2>/dev/null || sleep 1
      echo "[AtriOS] Bluetooth rfkill state=$(cat "$rfk/state" 2>/dev/null) (powered on)"
      BT_RESET_DONE=1
    done
    # Hardware Bluetooth Power & Reset (GPIO 493 = BT_EN, GPIO 494 = BT_RST)
    for g in 493 494; do
      if [ ! -e "/sys/class/gpio/gpio$g" ]; then
        echo "$g" > /sys/class/gpio/export 2>/dev/null || true
      fi
      if [ -d "/sys/class/gpio/gpio$g" ]; then
        echo out > "/sys/class/gpio/gpio$g/direction" 2>/dev/null || true
      fi
    done
    # BT Power Enable HIGH
    [ -d "/sys/class/gpio/gpio493" ] && echo 1 > /sys/class/gpio/gpio493/value 2>/dev/null || true
    # Pulse Hardware Reset: LOW -> 50ms -> HIGH
    if [ -d "/sys/class/gpio/gpio494" ]; then
      echo 0 > /sys/class/gpio/gpio494/value 2>/dev/null || true
      usleep 50000 2>/dev/null || sleep 1
      echo 1 > /sys/class/gpio/gpio494/value 2>/dev/null || true
    fi
    usleep 200000 2>/dev/null || sleep 1

    # Load 88x2es directly via insmod to avoid modprobe attempting duplicate cfg80211.ko load
    insmod /lib/modules/4.9.113/88x2es.ko 2>/dev/null || modprobe 88x2es 2>/dev/null
    insmod /lib/modules/4.9.113/zigbee-control.ko 2>/dev/null || modprobe zigbee-control 2>/dev/null

    # 5. VPU & Video decoders
    for m in media_clock firmware decoder_common stream_input vpu encoder amvdec_h265 amvdec_h264 amvdec_vp9; do
      insmod /lib/modules/4.9.113/${m}.ko 2>/dev/null || modprobe $m 2>/dev/null
    done

    echo "[AtriOS] Drivers loaded."
    ;;
  stop)
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0
