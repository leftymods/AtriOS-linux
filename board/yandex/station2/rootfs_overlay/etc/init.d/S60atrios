#!/bin/sh
# /etc/init.d/S60atrios - Launch AtriOS user interaction daemons (rotary & screen)

case "$1" in
  start)
    echo "[AtriOS] Starting user interface daemons..."
    mkdir -p /var/lib/atrios /var/log 2>/dev/null || true
    # keep the serial console quiet (hide driver debug spam)
    echo "3 3 1 3" > /proc/sys/kernel/printk 2>/dev/null || true
    dmesg -n 3 2>/dev/null || true

    # Disable fbcon cursor/console on screen framebuffer to prevent screen clipping
    for vt in /sys/class/vtconsole/vtcon*; do
      if [ -f "$vt/name" ] && grep -q "frame buffer" "$vt/name" 2>/dev/null; then
        echo 0 > "$vt/bind" 2>/dev/null || true
      fi
    done
    echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null || true

    # Link framebuffers for screen and ring
    for fb in /sys/class/graphics/fb*; do
      if [ -f "$fb/name" ]; then
        name=$(cat "$fb/name" 2>/dev/null | tr '[:upper:]' '[:lower:]')
        dev="/dev/$(basename $fb)"
        case "$name" in
          *screen*|*panel*|*gowin*|*yandex*)
            ln -sfn "$dev" /dev/fb_screen
            [ ! -e /dev/fb4 ] && ln -sfn "$dev" /dev/fb4
            ;;
          *ring*|*is31fl*|*quasar*)
            ln -sfn "$dev" /dev/fb_ring
            [ ! -e /dev/fb5 ] && ln -sfn "$dev" /dev/fb5
            ;;
        esac
      fi
    done
    if [ -x /usr/lib/atrios/rotaryd ]; then
      /usr/lib/atrios/rotaryd >/var/log/atrios-rotaryd.log 2>&1 &
    fi
    if [ -x /usr/lib/atrios/screend ]; then
      /usr/lib/atrios/screend >/var/log/atrios-screend.log 2>&1 &
    fi
    ;;
  stop)
    # Turn off LED ring
    if [ -x /usr/bin/atrios ]; then
      /usr/bin/atrios ring off 2>/dev/null || true
    fi
    [ -e /dev/fb_ring ] && dd if=/dev/zero of=/dev/fb_ring bs=1 count=576 2>/dev/null || true
    pkill -f /usr/lib/atrios/rotaryd 2>/dev/null; pkill -f /usr/lib/atrios/screend 2>/dev/null; true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0
