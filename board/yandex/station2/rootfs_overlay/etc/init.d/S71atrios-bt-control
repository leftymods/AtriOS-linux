#!/bin/sh
# /etc/init.d/S71atrios-bt-control - Bluetooth Speaker & RFCOMM Remote Control Daemons

case "$1" in
  start)
    # Rebind Bluetooth serdev driver if hci0 failed to load firmware during early boot
    if [ ! -d /sys/class/bluetooth/hci0 ]; then
      echo serial0-0 > /sys/bus/serial/drivers/hci_uart_h5/unbind 2>/dev/null || true
      sleep 0.5
      echo serial0-0 > /sys/bus/serial/drivers/hci_uart_h5/bind 2>/dev/null || true
      sleep 1
    fi

    echo "Starting AtriOS Bluetooth Speaker Daemon (SDP + A2DP Sink + AVRCP)..."
    if [ -x /usr/sbin/bt-speaker-daemon ] && ! pgrep -f /usr/sbin/bt-speaker-daemon >/dev/null 2>&1; then
      /usr/sbin/bt-speaker-daemon >/var/log/bt-speaker-daemon.log 2>&1 &
    fi

    echo "Starting AtriOS Bluetooth Remote Control Daemon (RFCOMM channel 1)..."
    if [ -x /usr/lib/atrios/bt-control ] && ! pgrep -f /usr/lib/atrios/bt-control >/dev/null 2>&1; then
      python3 /usr/lib/atrios/bt-control >/var/log/atrios-bt-control.log 2>&1 &
    fi
    ;;
  stop)
    echo "Stopping AtriOS Bluetooth Daemons..."
    killall bt-speaker-daemon 2>/dev/null || true
    pkill -f /usr/lib/atrios/bt-control 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
