#!/bin/sh
# fastfetch - Universal AtriOS system info & logo

# Amber palette (256-color gradient with basic ANSI fallback for vt100/dumb)
case "${TERM:-xterm}" in
    vt100|dumb)
        C_AMB1=$(printf '\033[1;33m')
        C_AMB2=$(printf '\033[1;33m')
        C_AMB3=$(printf '\033[0;33m')
        C_AMB4=$(printf '\033[0;33m')
        C_CORE=$(printf '\033[1;37m')
        C_TITLE=$(printf '\033[1;33m')
        C_KEY=$(printf '\033[1;33m')
        ;;
    *)
        C_AMB1=$(printf '\033[38;5;220m')
        C_AMB2=$(printf '\033[38;5;214m')
        C_AMB3=$(printf '\033[38;5;208m')
        C_AMB4=$(printf '\033[38;5;202m')
        C_CORE=$(printf '\033[38;5;229m')
        C_TITLE=$(printf '\033[1;38;5;214m')
        C_KEY=$(printf '\033[1;38;5;220m')
        ;;
esac
C_WHITE=$(printf '\033[1;37m')
C_DIM=$(printf '\033[0;37m')
C_RST=$(printf '\033[0m')

OS_NAME=$(sed -n 's/^PRETTY_NAME="\([^"]*\)"/\1/p' /etc/os-release 2>/dev/null)
[ -z "$OS_NAME" ] && OS_NAME="AtriOS"
ARCH=$(uname -m)
KERNEL=$(uname -r)

HOST=$(hostname 2>/dev/null)
if [ -z "$HOST" ] || [ "$HOST" = "(none)" ]; then
    HOST=$(cat /etc/hostname 2>/dev/null || echo "atrios")
fi
[ -z "$HOST" ] && HOST="atrios"
USER_NAME=$(id -un 2>/dev/null || echo "root")

# Load board profile (DT compatible -> /etc/atrios-device override)
if [ -r /usr/lib/atrios/device-detect ]; then
    . /usr/lib/atrios/device-detect
else
    DEVICE_NAME=$(tr -d '\0' </proc/device-tree/model 2>/dev/null || echo "AtriOS Device")
    DEVICE_REV=""
    DEVICE_CODENAME=""
    DEVICE_SOC=$(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null | awk '{print $NF}')
fi

HOST_LINE="$DEVICE_NAME"
[ -n "$DEVICE_REV" ] && HOST_LINE="$HOST_LINE $DEVICE_REV"
[ -n "$DEVICE_CODENAME" ] && HOST_LINE="$HOST_LINE (codename $DEVICE_CODENAME)"

# Uptime
UP_SEC=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
UP_H=$((UP_SEC / 3600))
UP_M=$(((UP_SEC % 3600) / 60))
UP_S=$((UP_SEC % 60))
if [ "$UP_H" -gt 0 ]; then
    UPTIME="${UP_H}h ${UP_M}m ${UP_S}s"
elif [ "$UP_M" -gt 0 ]; then
    UPTIME="${UP_M}m ${UP_S}s"
else
    UPTIME="${UP_S}s"
fi

# Memory
MEM_TOTAL_KB=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
MEM_AVAIL_KB=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)
if [ -n "$MEM_TOTAL_KB" ] && [ -n "$MEM_AVAIL_KB" ]; then
    MEM_TOTAL_MB=$((MEM_TOTAL_KB / 1024))
    MEM_USED_MB=$(((MEM_TOTAL_KB - MEM_AVAIL_KB) / 1024))
    MEM_STR="${MEM_USED_MB} MiB / ${MEM_TOTAL_MB} MiB"
else
    MEM_STR="unknown"
fi

# CPU & thermal
CPU_CORES=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
CPU_PART=$(awk -F: '/CPU part/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
case "$CPU_PART" in
    0xd05) CPU_ARCH="Cortex-A55" ;;
    0xd03) CPU_ARCH="Cortex-A53" ;;
    0xd07) CPU_ARCH="Cortex-A57" ;;
    0xd09) CPU_ARCH="Cortex-A73" ;;
    0xd0b) CPU_ARCH="Cortex-A76" ;;
    *)     CPU_ARCH="$ARCH" ;;
esac
CPU_STR="${CPU_CORES}x ${CPU_ARCH}"
[ -n "$DEVICE_SOC" ] && CPU_STR="${DEVICE_SOC} (${CPU_STR})"

TEMP_RAW=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
[ -n "$TEMP_RAW" ] && CPU_STR="${CPU_STR} [$((TEMP_RAW / 1000))°C]"

# Display / LEDs (detected dynamically)
DISP_PARTS=""
for fb in /sys/class/graphics/fb*/name; do
    [ -r "$fb" ] || continue
    fbname=$(cat "$fb" 2>/dev/null)
    [ -n "$fbname" ] && DISP_PARTS="${DISP_PARTS:+${DISP_PARTS}, }${fbname}"
done
if ls -d /sys/class/leds/*ring* >/dev/null 2>&1; then
    DISP_PARTS="${DISP_PARTS:+${DISP_PARTS} + }LED Ring"
fi
[ -z "$DISP_PARTS" ] && DISP_PARTS="none"

# Audio cards (detected dynamically)
AUDIO_STR=$(awk -F' - ' '/^[[:space:]]*[0-9]+ \[/ {gsub(/^[[:space:]]+/, "", $2); if (s!="") s=s", "; s=s $2} END {print s}' /proc/asound/cards 2>/dev/null)
[ -z "$AUDIO_STR" ] && AUDIO_STR="none"

SHELL_NAME=$(basename "${SHELL:-fish}")

printf "\n"
printf "  ${C_AMB1}             /\\             ${C_RST}  ${C_TITLE}${USER_NAME}${C_RST}@${C_TITLE}${HOST}${C_RST}\n"
printf "  ${C_AMB1}            /**\\            ${C_RST}  ${C_DIM}------------------------${C_RST}\n"
printf "  ${C_AMB1}           /*##*\\           ${C_RST}  ${C_KEY}OS:${C_RST} ${OS_NAME} ${ARCH}\n"
printf "  ${C_AMB2}          /*####*\\          ${C_RST}  ${C_KEY}Host:${C_RST} ${HOST_LINE}\n"
printf "  ${C_AMB2}         /*##/\\##*\\         ${C_RST}  ${C_KEY}Kernel:${C_RST} ${KERNEL}\n"
printf "  ${C_AMB2}        /*##/  \\##*\\        ${C_RST}  ${C_KEY}Uptime:${C_RST} ${UPTIME}\n"
printf "  ${C_AMB3}       /*##/    \\##*\\       ${C_RST}  ${C_KEY}Shell:${C_RST} ${SHELL_NAME}\n"
printf "  ${C_AMB3}      /*##/  ${C_CORE}/\\${C_AMB3}  \\##*\\      ${C_RST}  ${C_KEY}CPU:${C_RST} ${CPU_STR}\n"
printf "  ${C_AMB3}     /*##/  ${C_AMB1}/##\\${C_AMB3}  \\##*\\     ${C_RST}  ${C_KEY}Memory:${C_RST} ${MEM_STR}\n"
printf "  ${C_AMB4}    /*##/  ${C_AMB1}/____\\${C_AMB4}  \\##*\\    ${C_RST}  ${C_KEY}Display:${C_RST} ${DISP_PARTS}\n"
printf "  ${C_AMB4}   /*##/            \\##*\\   ${C_RST}  ${C_KEY}Audio:${C_RST} ${AUDIO_STR}\n"
printf "  ${C_AMB4}  /___/              \\___\\  ${C_RST}\n"
printf "  ${C_AMB1}      A  T  R  I  O  S      ${C_RST}  \033[48;5;202m   \033[48;5;208m   \033[48;5;214m   \033[48;5;220m   \033[48;5;229m   \033[47m   ${C_RST}\n"
printf "\n"
