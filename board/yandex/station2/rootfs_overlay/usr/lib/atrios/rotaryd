#!/usr/bin/env python3
"""
AtriOS Hardware Interaction Daemon (atrios-rotaryd)
Handles:
  - Rotary Knob: Volume up/down with animated LED ring arc feedback
  - Top Button #2 (KEY_MICMUTE [248]): Software Microphone Mute toggle
  - Top Button #1 (KEY_VOICECOMMAND [582] / KEY_POWER [116]): Alice/Assistant call, Play/Pause

Volume authority:
  /var/lib/atrios/volume is the single source of truth (percent 0..100).
  Only the knob, `atrios volume` and this daemon write it.  A watchdog
  re-applies the saved value to the ALSA masters once per second, so
  another program (or S03/alsactl) cannot raise/lower it behind the user's
  back.  PipeWire is not used for volume: the Buildroot image has no
  PipeWire ALSA backend, and the AML card is driven directly through ALSA.
"""

import sys
import os
import glob
import struct
import time
import subprocess
import select
import shutil
import re
import math

def find_fb_by_name(keywords):
    for path in sorted(glob.glob("/sys/class/graphics/fb*/name")):
        try:
            with open(path, "r") as f:
                name = f.read().strip().lower()
                for kw in keywords:
                    if kw.lower() in name:
                        dev = "/dev/" + os.path.basename(os.path.dirname(path))
                        return dev
        except Exception:
            pass
    return None

def get_fb_ring():
    dev = find_fb_by_name(["ring", "yndx led ring"])
    if dev and os.path.exists(dev):
        return dev
    for fallback in ("/dev/fb5", "/dev/fb4", "/dev/fb3", "/dev/fb2", "/dev/fb1", "/dev/fb0"):
        if os.path.exists(fallback):
            return fallback
    return "/dev/fb5"

FB_RING = get_fb_ring()
NUM_LEDS = 24
CARD = "AMLAUGESOUND"
VOLUME_STEP = 2  # percent per detent; finer volume control (50 detents full scale)
STATE_DIR = "/var/lib/atrios"
STATE_FILE = STATE_DIR + "/volume"
DEFAULT_VOLUME = 60
AMIXER = shutil.which("amixer") or "/usr/bin/amixer"

KEY_VOICECOMMAND = 582
KEY_POWER = 116
KEY_MICMUTE = 248
# The gpio_keypad reports the mic-mute key active-low: the physical press
# arrives as value 0.  Flip this if the button feels inverted.
MIC_MUTE_ACTIVE_LOW = True
KEY_PAGEUP = 104    # Knob CW
KEY_PAGEDOWN = 109  # Knob CCW

mic_muted = False
current_volume = DEFAULT_VOLUME
display_volume = float(DEFAULT_VOLUME)


def volume_to_raw(pct, zero_db_raw):
    """Map UI 0..100 to the raw ALSA value using a wide dynamic range perceptual curve.

    Provides true quiet night listening at 1-2% (-100 dB) up to 0 dB at 100%.
    Speaker masters have their 0 dB point at raw 255; the ES8156 headphone DAC at raw 191.
    Writing 255 to the headphone control would be +32 dB, so never share the raw
    value between the two.
    """
    pct = max(0, min(100, int(pct)))
    if pct <= 0:
        return 1
    max_db = (zero_db_raw * 0.5) - 12.0
    db = -max_db * (1.0 - math.sqrt(pct / 100.0))
    raw = int(round(zero_db_raw + 2.0 * db))
    return max(1, min(zero_db_raw, raw))


def read_state_volume():
    try:
        with open(STATE_FILE, "r") as f:
            value = int(f.read().strip())
        return max(0, min(100, value))
    except Exception:
        return None


def save_state_volume(pct):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            f.write("%d\n" % int(pct))
        os.replace(tmp, STATE_FILE)
    except Exception:
        pass


def read_alsa_controls():
    """Return (woofer, tweeters, headphone) raw values or None."""
    values = []
    for ctl in ("Woofer Master Playback Volume",
                "Tweeters Master Playback Volume",
                "Headphone DAC Playback Volume"):
        try:
            out = subprocess.check_output(
                [AMIXER, "-c", CARD, "cget", "name=" + ctl],
                stderr=subprocess.DEVNULL, text=True, timeout=0.5)
            match = re.search(r": values=(\d+)", out)
            if not match:
                return None
            values.append(int(match.group(1)))
        except Exception:
            return None
    return tuple(values)


def set_volume(pct, force_switches=False):
    """Apply volume to ALSA, hardware I2C master registers, and PipeWire."""
    pct = max(0, min(100, int(pct)))
    raw = volume_to_raw(pct, 255)
    raw_hp = volume_to_raw(pct, 191)
    sw = "0" if pct == 0 else "1"
    mute_i2c = "0x08" if pct == 0 else "0x00"
    mute_es = "0x00" if pct == 0 else "0x11"
    hex_raw = "0x%02x" % raw
    hex_hp = "0x%02x" % raw_hp

    # 1. ALSA Hardware Controls
    for card in (CARD, "0"):
        try:
            for ctl, val in (
                ("Woofer Master Playback Volume", raw),
                ("Tweeters Master Playback Volume", raw),
                ("Headphone DAC Playback Volume", raw_hp),
            ):
                subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", str(val)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            if force_switches:
                for ctl in (
                    "Woofer Ch1 Playback Volume", "Woofer Ch2 Playback Volume",
                    "Tweeters Ch1 Playback Volume", "Tweeters Ch2 Playback Volume",
                ):
                    subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", "159"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            # Always keep switches unmuted if pct > 0, mute only if pct == 0
            for ctl in (
                "Woofer Master Playback Switch", "Woofer Ch1 Playback Switch",
                "Woofer Ch2 Playback Switch", "Tweeters Master Playback Switch",
                "Tweeters Ch1 Playback Switch", "Tweeters Ch2 Playback Switch",
                "Headphone Headphone Switch",
            ):
                subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", sw],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([AMIXER, "-c", card, "cset", "name=SPK mute", "1" if pct == 0 else "0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
        except Exception:
            pass

    # 2. Fast direct I2C master volume (bus 2)
    try:
        subprocess.run(["i2cset", "-y", "-f", "2", "0x2a", "0x07", hex_raw],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["i2cset", "-y", "-f", "2", "0x2b", "0x07", hex_raw],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["i2cset", "-y", "-f", "2", "0x08", "0x14", hex_hp],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if pct == 0 or force_switches:
            subprocess.run(["i2cset", "-y", "-f", "2", "0x2a", "0x06", mute_i2c],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["i2cset", "-y", "-f", "2", "0x2b", "0x06", mute_i2c],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["i2cset", "-y", "-f", "2", "0x08", "0x13", mute_es],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 3. Synchronize PipeWire software sink
    try:
        pw_vol = f"{pct / 100.0:.2f}"
        env = dict(os.environ, XDG_RUNTIME_DIR="/var/run/pipewire")
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", pw_vol],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if pct == 0 else "0"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    except Exception:
        pass


volume_dirty = False
last_volume_change_time = 0.0
last_volume_time = 0.0


