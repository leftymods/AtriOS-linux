#!/usr/bin/env python3
"""
AtriOS Hardware Interaction Daemon (atrios-rotaryd)
Handles:
  - Rotary Knob: Volume up/down with animated LED ring arc feedback
  - Top Button #2 (KEY_MICMUTE [248]): Software Microphone Mute toggle
  - Top Button #1 (KEY_VOICECOMMAND [582] / KEY_POWER [116]): Alice/Assistant call, Play/Pause

Volume authority:
  /var/lib/atrios/volume is the single source of truth (percent 0..100).
  Only the knob, `atrios volume` and this daemon write it.  A watchdog
  re-applies the saved value to the ALSA masters once per second, so
  another program (or S03/alsactl) cannot raise/lower it behind the user's
  back.  PipeWire is not used for volume: the Buildroot image has no
  PipeWire ALSA backend, and the AML card is driven directly through ALSA.
"""

import sys
import os
import glob
import struct
import time
import subprocess
import select
import shutil
import re
import math
import fcntl
import threading

def find_fb_by_name(keywords):
    for path in sorted(glob.glob("/sys/class/graphics/fb*/name")):
        try:
            with open(path, "r") as f:
                name = f.read().strip().lower()
                for kw in keywords:
                    if kw.lower() in name:
                        dev = "/dev/" + os.path.basename(os.path.dirname(path))
                        return dev
        except Exception:
            pass
    return None

_fb_ring_cache = None


def get_fb_ring():
    global _fb_ring_cache
    if _fb_ring_cache and os.path.exists(_fb_ring_cache):
        return _fb_ring_cache
    dev = find_fb_by_name(["ring", "yndx led ring"])
    if dev and os.path.exists(dev):
        _fb_ring_cache = dev
        return dev
    for fallback in ("/dev/fb5", "/dev/fb4", "/dev/fb3", "/dev/fb2", "/dev/fb1", "/dev/fb0"):
        if os.path.exists(fallback):
            _fb_ring_cache = fallback
            return fallback
    return "/dev/fb5"

FB_RING = get_fb_ring()
NUM_LEDS = 24
CARD = "AMLAUGESOUND"
VOLUME_STEP = 5  # percent per detent (20 detents full scale 0..100%)
STATE_DIR = "/var/lib/atrios"
STATE_FILE = STATE_DIR + "/volume"
DEFAULT_VOLUME = 60
AMIXER = shutil.which("amixer") or "/usr/bin/amixer"

KEY_VOICECOMMAND = 582
KEY_POWER = 116
KEY_MICMUTE = 248
# The gpio_keypad reports the mic-mute key active-low: the physical press
# arrives as value 0.  Flip this if the button feels inverted.
MIC_MUTE_ACTIVE_LOW = True
KEY_PAGEUP = 104    # Knob CW
KEY_PAGEDOWN = 109  # Knob CCW

import json

BUTTONS_STATE_FILE = "/var/run/atrios/buttons.json"

mic_muted = False
action_pressed = False
ring_active = False
is_fading = False
current_volume = DEFAULT_VOLUME
display_volume = float(DEFAULT_VOLUME)
_alsa_lock = threading.Lock()


def write_buttons_state():
    """Persist top button states for bt-control / companion app."""
    try:
        os.makedirs(os.path.dirname(BUTTONS_STATE_FILE), exist_ok=True)
        tmp = BUTTONS_STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({
                "action_pressed": bool(action_pressed),
                "mic_muted": bool(mic_muted),
            }, f)
        os.replace(tmp, BUTTONS_STATE_FILE)
    except Exception:
        pass


def volume_to_raw(pct, zero_db_raw):
    """Map UI 0..100 to the raw ALSA value using an audible -40..0 dB perceptual curve."""
    pct = max(0, min(100, int(pct)))
    if pct <= 0:
        return 0
    db = -40.0 * (1.0 - (pct / 100.0) ** 0.65)
    raw = int(round(zero_db_raw + 2.0 * db))
    return max(1, min(zero_db_raw, raw))


def woofer_volume_to_raw(pct, zero_db_raw):
    """Apply smooth low-volume bass loudness compensation (+8 dB at 1%, fading to 0 dB at 30%)."""
    raw = volume_to_raw(pct, zero_db_raw)
    if pct <= 0 or pct >= 30:
        return raw
    boost = int(round(16.0 * (1.0 - pct / 30.0)))
    return min(zero_db_raw, raw + boost)


def read_state_volume():
    try:
        with open(STATE_FILE, "r") as f:
            value = int(f.read().strip())
        return max(0, min(100, value))
    except Exception:
        return None


def save_state_volume(pct):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            f.write("%d\n" % int(pct))
        os.replace(tmp, STATE_FILE)
    except Exception:
        pass


def read_alsa_controls():
    """Return (woofer, tweeters) raw values or None."""
    values = []
    for ctl in ("Woofer Master Playback Volume",
                "Tweeters Master Playback Volume"):
        try:
            out = subprocess.check_output(
                [AMIXER, "-c", CARD, "cget", "name=" + ctl],
                stderr=subprocess.DEVNULL, text=True, timeout=0.5)
            match = re.search(r": values=(\d+)", out)
            if not match:
                return None
            values.append(int(match.group(1)))
        except Exception:
            return None
    return tuple(values)


_last_raw_i2c = None


def set_volume_i2c(pct, force_switches=False):
    """Fast direct I2C master volume update with smooth gain ramp."""
    global _last_raw_i2c
    pct = max(0, min(100, int(pct)))
    raw = volume_to_raw(pct, 255)
    raw_wfr = woofer_volume_to_raw(pct, 255)
    raw_hp = volume_to_raw(pct, 191)
    mute_i2c = 0x08 if pct == 0 else 0x00
    mute_es = 0x00 if pct == 0 else 0x11
    try:
        fd = os.open("/dev/i2c-2", os.O_RDWR)
        try:
            prev = _last_raw_i2c
            if prev is not None and abs(raw - prev) > 2:
                step = 2 if raw > prev else -2
                vals = list(range(prev + step, raw, step)) + [raw]
            else:
                vals = [raw]
            boost = raw_wfr - raw
            for v in vals:
                fcntl.ioctl(fd, 0x0706, 0x2a)  # Tweeters
                os.write(fd, bytes([0x07, v]))
                vw = 0 if v == 0 else min(255, v + boost)
                fcntl.ioctl(fd, 0x0706, 0x2b)  # Woofer
                os.write(fd, bytes([0x07, vw]))
                if len(vals) > 1:
                    time.sleep(0.001)
            if force_switches:
                for addr in (0x2a, 0x2b):
                    fcntl.ioctl(fd, 0x0706, addr)
                    os.write(fd, bytes([0x06, mute_i2c]))
            _last_raw_i2c = raw
            try:
                fcntl.ioctl(fd, 0x0706, 0x08)
                os.write(fd, bytes([0x14, raw_hp]))
                if force_switches:
                    os.write(fd, bytes([0x13, mute_es]))
            except Exception:
                pass
        finally:
            os.close(fd)
    except Exception:
        pass


def set_volume(pct, force_switches=False):
    """Apply volume to hardware I2C master registers, ALSA, and PipeWire."""
    pct = max(0, min(100, int(pct)))
    set_volume_i2c(pct, force_switches=force_switches)

    raw = volume_to_raw(pct, 255)
    raw_wfr = woofer_volume_to_raw(pct, 255)
    sw = "0" if pct == 0 else "1"
    master_sw = "3" if pct == 0 else "0"

    # 1. ALSA Hardware Controls
    for card in (CARD, "0"):
        try:
            for ctl, val in (
                ("Woofer Master Playback Volume", raw_wfr),
                ("Tweeters Master Playback Volume", raw),
            ):
                subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", str(val)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            if force_switches:
                for ctl in (
                    "Woofer Ch1 Playback Volume", "Woofer Ch2 Playback Volume",
                    "Tweeters Ch1 Playback Volume", "Tweeters Ch2 Playback Volume",
                ):
                    subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", "159"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for ctl in ("Woofer Master Playback Switch", "Tweeters Master Playback Switch"):
                    subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", master_sw],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for ctl in (
                    "Woofer Ch1 Playback Switch", "Woofer Ch2 Playback Switch",
                    "Tweeters Ch1 Playback Switch", "Tweeters Ch2 Playback Switch",
                ):
                    subprocess.run([AMIXER, "-c", card, "cset", f"name={ctl}", sw],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
        except Exception:
            pass

    # 2. Keep PipeWire software sink at unity (100%) to avoid double-scaling glitches
    try:
        env = dict(os.environ, XDG_RUNTIME_DIR="/var/run/pipewire")
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "1.00"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        if force_switches:
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if pct == 0 else "0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    except Exception:
        pass


volume_dirty = False
last_volume_change_time = 0.0
last_volume_time = 0.0




def apply_saved_volume():
    global current_volume, display_volume, volume_dirty
    value = read_state_volume()
    if value is None:
        value = DEFAULT_VOLUME
        save_state_volume(value)
    current_volume = value
    display_volume = float(value)
    volume_dirty = False
    # At boot the ring must stay dark; it is a feedback element for the
    # knob, not a power indicator.
    clear_ring()
    set_volume(current_volume, force_switches=True)


def _sync_alsa_async(pct, force_switches=False):
    with _alsa_lock:
        set_volume(pct, force_switches=force_switches)


_render_wake = threading.Event()


def adjust_volume(step):
    global current_volume, volume_dirty, last_volume_change_time, ring_active, is_fading, last_volume_time
    prev_volume = current_volume
    current_volume = max(0, min(100, current_volume + step))
    now = time.time()
    ring_active = True
    is_fading = False
    last_volume_time = now
    last_volume_change_time = now
    set_volume_i2c(current_volume, force_switches=(prev_volume == 0 or current_volume == 0))
    volume_dirty = True
    _render_wake.set()


def flush_state_volume():
    global volume_dirty
    if volume_dirty:
        vol = current_volume
        save_state_volume(vol)
        threading.Thread(target=_sync_alsa_async, args=(vol,), daemon=True).start()
        volume_dirty = False


def enforce_volume(allow_while_ring=False):
    """Watchdog: the state file wins over any external ALSA writer."""
    global current_volume, last_volume_time, ring_active, is_fading
    if volume_dirty or (ring_active and not allow_while_ring):
        return
    saved = read_state_volume()
    if saved is not None and saved != current_volume:
        prev_volume = current_volume
        current_volume = saved
        ring_active = True
        is_fading = False
        last_volume_time = time.time()
        set_volume_i2c(current_volume, force_switches=(prev_volume == 0 or current_volume == 0))
        _render_wake.set()
        threading.Thread(
            target=_sync_alsa_async,
            args=(current_volume, prev_volume == 0 or current_volume == 0),
            daemon=True,
        ).start()
        return

    expected = (woofer_volume_to_raw(current_volume, 255),
                volume_to_raw(current_volume, 255))
    actual = read_alsa_controls()
    if actual is None:
        return
    if any(abs(a - b) > 1 for a, b in zip(actual, expected)):
        threading.Thread(target=_sync_alsa_async, args=(current_volume,), daemon=True).start()


_fb_ring_fd = None


def set_ring_frame(frame):
    global _fb_ring_fd
    try:
        if _fb_ring_fd is None:
            fb = get_fb_ring()
            _fb_ring_fd = os.open(fb, os.O_WRONLY)
        os.lseek(_fb_ring_fd, 0, os.SEEK_SET)
        os.write(_fb_ring_fd, frame)
    except Exception:
        if _fb_ring_fd is not None:
            try:
                os.close(_fb_ring_fd)
            except Exception:
                pass
            _fb_ring_fd = None


def show_mute_ring():
    # No ring indication for mic mute
    set_ring_frame(b"\x00" * (NUM_LEDS * 3))


def calc_led_color(ratio, vol_pct):
    """Return (r, g, 0) for LED position ratio (0.0..1.0): stable green -> yellow -> red."""
    if ratio < 0.5:
        r = int(255 * (ratio * 2.0))
        g = 255
    else:
        r = 255
        g = int(255 * (2.0 - ratio * 2.0))
    return r, g, 0


def show_volume_ring(vol_pct, brightness=1.0):
    if vol_pct <= 0 or brightness <= 0.001:
        set_ring_frame(b"\x00" * (NUM_LEDS * 3))
        return
    brightness = max(0.0, min(1.0, float(brightness)))
    exact = NUM_LEDS * max(0.0, min(100.0, float(vol_pct))) / 100.0
    full = int(exact)
    frac = exact - full
    frame = bytearray(NUM_LEDS * 3)
    for i in range(full):
        ratio = i / max(1, NUM_LEDS - 1)
        r, g, _ = calc_led_color(ratio, vol_pct)
        # quasar_led_ring uses BGR byte order (0=blue, 1=green, 2=red)
        frame[i * 3 + 0] = 0
        frame[i * 3 + 1] = int(g * brightness)
        frame[i * 3 + 2] = int(r * brightness)
    if full < NUM_LEDS and frac > 0.02:
        eased_frac = (frac ** 1.4) * brightness
        ratio = full / max(1, NUM_LEDS - 1)
        r, g, _ = calc_led_color(ratio, vol_pct)
        frame[full * 3 + 0] = 0
        frame[full * 3 + 1] = int(g * eased_frac)
        frame[full * 3 + 2] = int(r * eased_frac)
    set_ring_frame(frame)


def clear_ring():
    global ring_active, is_fading
    ring_active = False
    is_fading = False
    set_ring_frame(b"\x00" * (NUM_LEDS * 3))


def set_software_mic_mute(muted):
    global mic_muted
    mic_muted = bool(muted)
    write_buttons_state()

    alsa_cmd = "mute" if mic_muted else "unmute"
    alsa_vol = "0%" if mic_muted else "100%"
    sw_val = "0" if mic_muted else "1"
    adc_mute = "1" if mic_muted else "0"

    # ALSA AMLAUGESOUND hardware capture mute.  PipeWire has no ALSA
    # backend in this image, so there is nothing to do through wpctl.
    for card in ["AMLAUGESOUND", "0"]:
        try:
            subprocess.run([AMIXER, "-c", card, "sset", "Capture", alsa_cmd],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([AMIXER, "-c", card, "sset", "Capture", alsa_vol],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for ctrl in ["Capture Switch", "ADC Capture Switch",
                         "Mic Capture Switch", "TDMIN_A Switch",
                         "TDMIN_B Switch"]:
                subprocess.run([AMIXER, "-c", card, "cset", "name=" + ctrl, sw_val],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for i in (1, 2, 3, 4):
                subprocess.run([AMIXER, "-c", card, "cset", f"name=Loopback ADC{i}_MUTE", adc_mute],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass


def ensure_input_nodes():
    """Ensure /dev/input/event* device nodes exist if /sys/class/input/event* are present."""
    try:
        os.makedirs("/dev/input", exist_ok=True)
        for sys_ev in glob.glob("/sys/class/input/event*"):
            dev_file = os.path.join(sys_ev, "dev")
            if os.path.exists(dev_file):
                node_name = os.path.basename(sys_ev)
                dev_node = os.path.join("/dev/input", node_name)
                if not os.path.exists(dev_node):
                    with open(dev_file, "r") as f:
                        parts = f.read().strip().split(":")
                    if len(parts) == 2:
                        maj, min_ = parts[0], parts[1]
                        subprocess.run(["mknod", dev_node, "c", str(maj), str(min_)],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def find_devices():
    return sorted(glob.glob("/dev/input/event*"))


def scan_and_open_devices(open_fds):
    """Scan for event devices and add newly discovered ones to open_fds."""
    ensure_input_nodes()
    opened_paths = set(open_fds.values())
    for path in find_devices():
        if path not in opened_paths:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                open_fds[fd] = path
            except Exception:
                pass


def init_ring_triggers():
    """Ensure all 24 RGB ring LEDs are bound to the led_ring_fb trigger."""
    for path in glob.glob("/sys/class/leds/*ring*/trigger") + glob.glob("/sys/class/leds/*led_ring*/trigger"):
        try:
            with open(path, "w") as f:
                f.write("led_ring_fb\n")
        except Exception:
            pass


def _render_loop():
    """Dedicated LED ring renderer thread so 12ms I2C fb writes never block input."""
    global display_volume, last_volume_time
    FADE_START_DELAY = 0.8
    FADE_DURATION = 0.35
    FRAME_INTERVAL = 0.025  # ~40 FPS max (matches ~12ms I2C fb_write bandwidth)
    last_anim_time = time.time()
    last_drawn = None

    while True:
        now = time.time()
        target = current_volume
        lvt = last_volume_time
        active = (lvt > 0 or abs(display_volume - target) > 0.05)
        if not active:
            last_drawn = None
            _render_wake.wait(timeout=0.5)
            _render_wake.clear()
            last_anim_time = time.time()
            continue

        dt = max(0.001, min(0.08, now - last_anim_time))
        last_anim_time = now

        diff = target - display_volume
        if abs(diff) > 1.5:
            display_volume += diff * min(1.0, dt * 28.0)
        else:
            display_volume = float(target)

        elapsed = (now - lvt) if lvt > 0 else 0.0
        if elapsed > FADE_START_DELAY:
            t = min(1.0, (elapsed - FADE_START_DELAY) / FADE_DURATION)
            fade_factor = 1.0 - (3.0 * t * t - 2.0 * t * t * t) if t < 1.0 else 0.0
        else:
            fade_factor = 1.0

        t_start = time.time()
        if fade_factor <= 0.001:
            clear_ring()
            last_volume_time = 0.0
            last_drawn = None
        else:
            key = (round(display_volume, 2), round(fade_factor, 3))
            if key != last_drawn:
                show_volume_ring(display_volume, brightness=fade_factor)
                last_drawn = key

        spent = time.time() - t_start
        sleep_s = FRAME_INTERVAL - spent
        if sleep_s > 0.002:
            _render_wake.wait(timeout=sleep_s)
            _render_wake.clear()


def main():
    global current_volume, display_volume, last_volume_time
    EVENT_FORMAT = "QQHHi"
    EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
    open_fds = {}

    init_ring_triggers()
    scan_and_open_devices(open_fds)

    top_press_time = 0
    last_volume_time = 0.0
    apply_saved_volume()
    write_buttons_state()
    last_enforce = time.time()
    last_scan = time.time()
    last_flush = time.time()
    last_state_mtime = 0.0
    try:
        last_state_mtime = os.stat(STATE_FILE).st_mtime
    except OSError:
        pass

    threading.Thread(target=_render_loop, daemon=True).start()

    try:
        while True:
            fds_to_watch = list(open_fds.keys())
            rlist, _, _ = select.select(fds_to_watch, [], [], 0.05) if fds_to_watch else ([], [], 0.05)
            now = time.time()

            for fd in rlist:
                try:
                    data = os.read(fd, EVENT_SIZE * 64)
                    net_vol_step = 0
                    for offset in range(0, len(data), EVENT_SIZE):
                        chunk = data[offset:offset + EVENT_SIZE]
                        if len(chunk) < EVENT_SIZE:
                            continue
                        sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, chunk)
                        if ev_type == 1:  # EV_KEY
                            # Inverted rotary polarity per user request
                            if ev_code == KEY_PAGEUP and ev_value == 1:
                                net_vol_step -= VOLUME_STEP
                            elif ev_code == KEY_PAGEDOWN and ev_value == 1:
                                net_vol_step += VOLUME_STEP
                            # Top Button 2: Dedicated Physical Microphone Mute
                            elif ev_code == KEY_MICMUTE and ev_value in (0, 1):
                                pressed = (ev_value == 0) if MIC_MUTE_ACTIVE_LOW else (ev_value == 1)
                                set_software_mic_mute(pressed)
                            # Top Button 1: Assistant / Play-Pause
                            elif ev_code in (KEY_VOICECOMMAND, KEY_POWER):
                                global action_pressed
                                if ev_value == 1:
                                    top_press_time = time.time()
                                    action_pressed = True
                                    write_buttons_state()
                                elif ev_value == 0:
                                    action_pressed = False
                                    write_buttons_state()
                                    duration = time.time() - top_press_time
                                    if duration >= 2.5:
                                        pass
                                    else:
                                        try:
                                            with open("/var/run/atrios/ai_trigger", "w") as tf:
                                                tf.write(str(time.time()))
                                        except Exception:
                                            pass
                                        try:
                                            if os.path.exists("/var/run/atrios/atriai.pid"):
                                                with open("/var/run/atrios/atriai.pid") as pf:
                                                    os.kill(int(pf.read().strip()), signal.SIGUSR1)
                                        except Exception:
                                            pass
                                        try:
                                            subprocess.run(["playerctl", "play-pause"],
                                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                        except Exception:
                                            pass
                    if net_vol_step != 0:
                        adjust_volume(net_vol_step)
                except OSError:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    open_fds.pop(fd, None)
                except Exception:
                    pass

            # Fast state flush: write every 80ms while rotating for real-time BT sync
            if volume_dirty and (now - last_flush > 0.08):
                flush_state_volume()
                last_flush = now
                try:
                    last_state_mtime = os.stat(STATE_FILE).st_mtime
                except OSError:
                    pass

            # Fast sync on external STATE_FILE updates (e.g. Bluetooth AVRCP SetAbsoluteVolume)
            if not volume_dirty:
                try:
                    st_mtime = os.stat(STATE_FILE).st_mtime
                    if st_mtime != last_state_mtime:
                        last_state_mtime = st_mtime
                        enforce_volume(allow_while_ring=True)
                        last_enforce = now
                except OSError:
                    pass

            # Watchdog: enforce saved volume whenever idle, polling at 2s
            if not ring_active and not volume_dirty and (now - last_enforce > 2.0):
                enforce_volume()
                last_enforce = now

            # Periodic device re-scan (every 3s if missing devices or devices changed)
            if now - last_scan > 3.0:
                scan_and_open_devices(open_fds)
                last_scan = now
    finally:
        flush_state_volume()


if __name__ == "__main__":
    main()
