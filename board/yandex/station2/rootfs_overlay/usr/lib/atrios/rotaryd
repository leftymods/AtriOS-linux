#!/usr/bin/env python3
"""
AtriOS Hardware Interaction Daemon (atrios-rotaryd)
Handles:
  - Rotary Knob: Volume up/down with animated LED ring arc feedback
  - Top Button #2 (KEY_MICMUTE [248]): Software Microphone Mute toggle
  - Top Button #1 (KEY_VOICECOMMAND [582] / KEY_POWER [116]): Alice/Assistant call, Play/Pause

Volume authority:
  /var/lib/atrios/volume is the single source of truth (percent 0..100).
  Only the knob, `atrios volume` and this daemon write it.  A watchdog
  re-applies the saved value to the ALSA masters once per second, so
  another program (or S03/alsactl) cannot raise/lower it behind the user's
  back.  PipeWire is not used for volume: the Buildroot image has no
  PipeWire ALSA backend, and the AML card is driven directly through ALSA.
"""

import sys
import os
import glob
import struct
import time
import subprocess
import select
import shutil
import re
import math

FB_RING = "/dev/fb5"
NUM_LEDS = 24
CARD = "AMLAUGESOUND"
VOLUME_STEP = 2  # percent per detent; 50 granular steps across full 0-100% volume
FADE_IDLE_DELAY = 1.0  # seconds to keep ring lit after knob stops moving
FADE_DURATION = 0.6    # seconds for silky smooth cosine fade-out
STATE_DIR = "/var/lib/atrios"
STATE_FILE = STATE_DIR + "/volume"
DEFAULT_VOLUME = 60
AMIXER = shutil.which("amixer") or "/usr/bin/amixer"

KEY_VOICECOMMAND = 582
KEY_POWER = 116
KEY_MICMUTE = 248
# The gpio_keypad reports the mic-mute key active-low: the physical press
# arrives as value 0.  Flip this if the button feels inverted.
MIC_MUTE_ACTIVE_LOW = True
KEY_PAGEUP = 104    # Knob CW
KEY_PAGEDOWN = 109  # Knob CCW

mic_muted = False
current_volume = DEFAULT_VOLUME


def volume_to_raw(pct, zero_db_raw):
    """Map UI 0..100 to the raw ALSA value using a perceptual curve.

    dB(p) = -60 * (1 - sqrt(p/100)), so 40% is about -22 dB (audible),
    100% is 0 dB and 0% is effectively muted.  Speaker masters have their
    0 dB point at raw 255; the ES8156 headphone DAC at raw 191.  Writing
    255 to the headphone control would be +32 dB, so never share the raw
    value between the two.
    """
    pct = max(0, min(100, int(pct)))
    if pct <= 0:
        return 1
    db = -60.0 * (1.0 - math.sqrt(pct / 100.0))
    raw = int(round(zero_db_raw + 2.0 * db))
    return max(1, min(zero_db_raw, raw))


def read_state_volume():
    try:
        with open(STATE_FILE, "r") as f:
            value = int(f.read().strip())
        return max(0, min(100, value))
    except Exception:
        return None


def save_state_volume(pct):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            f.write("%d\n" % int(pct))
        os.replace(tmp, STATE_FILE)
    except Exception:
        pass


def read_alsa_controls():
    """Return (woofer, tweeters, headphone) raw values or None."""
    values = []
    for ctl in ("Woofer Master Playback Volume",
                "Tweeters Master Playback Volume",
                "Headphone DAC Playback Volume"):
        try:
            out = subprocess.check_output(
                [AMIXER, "-c", CARD, "cget", "name=" + ctl],
                stderr=subprocess.DEVNULL, text=True, timeout=0.5)
            match = re.search(r": values=(\d+)", out)
            if not match:
                return None
            values.append(int(match.group(1)))
        except Exception:
            return None
    return tuple(values)


class AlsaFastMixer:
    """High-speed ALSA mixer controller using a persistent amixer process with fallback."""

    def __init__(self, card=CARD):
        self.card = card
        self._proc = None
        self._last_mute_state = None

    def _ensure_process(self):
        if self._proc is not None:
            if self._proc.poll() is None and self._proc.stdin:
                return self._proc
            try:
                self._proc.kill()
            except Exception:
                pass
            self._proc = None

        for c in (self.card, "0"):
            try:
                self._proc = subprocess.Popen(
                    [AMIXER, "-c", c, "-q", "-s"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    bufsize=1,
                )
                if self._proc.poll() is None:
                    break
            except Exception:
                self._proc = None
        return self._proc

    def set_volume(self, pct, force_switches=False):
        pct = max(0, min(100, int(pct)))
        raw = volume_to_raw(pct, 255)
        raw_hp = volume_to_raw(pct, 191)
        mute_state = (pct == 0)

        lines = [
            f"cset name='Woofer Master Playback Volume' {raw}",
            f"cset name='Tweeters Master Playback Volume' {raw}",
            f"cset name='Headphone DAC Playback Volume' {raw_hp}",
        ]

        if force_switches or mute_state != self._last_mute_state:
            sw = "0" if mute_state else "1"
            lines.extend([
                f"cset name='Woofer Master Playback Switch' {sw}",
                f"cset name='Tweeters Master Playback Switch' {sw}",
                f"cset name='Headphone Headphone Switch' {sw}",
                "cset name='SPK mute' 0",
            ])
            self._last_mute_state = mute_state

        proc = self._ensure_process()
        if proc and proc.stdin:
            try:
                for line in lines:
                    proc.stdin.write(line + "\n")
                proc.stdin.flush()
                return
            except Exception:
                self._proc = None

        batch_input = "\n".join(lines) + "\n"
        for card_id in (self.card, "0"):
            try:
                res = subprocess.run(
                    [AMIXER, "-c", card_id, "-q", "-s"],
                    input=batch_input,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=0.3,
                )
                if res.returncode == 0:
                    break
            except Exception:
                pass


fast_mixer = AlsaFastMixer()
volume_dirty = False
last_volume_change_time = 0.0


def set_volume(pct, force_switches=False):
    """Apply volume to ALSA master controls via fast batch mixer."""
    fast_mixer.set_volume(pct, force_switches=force_switches)


ring_active = False
is_fading = False
fade_start_time = 0.0

def apply_saved_volume():
    global current_volume, volume_dirty
    value = read_state_volume()
    if value is None:
        value = DEFAULT_VOLUME
        save_state_volume(value)
    current_volume = value
    volume_dirty = False
    # At boot the ring must stay dark; it is a feedback element for the
    # knob, not a power indicator.
    clear_ring()
    set_volume(current_volume, force_switches=True)


def adjust_volume(step):
    global current_volume, volume_dirty, last_volume_change_time, ring_active, is_fading
    current_volume = max(0, min(100, current_volume + step))
    ring_active = True
    is_fading = False
    # 1. Update visual feedback immediately (0ms latency, full brightness)
    show_volume_ring(current_volume, brightness=1.0)
    # 2. Update hardware master ALSA volume immediately via persistent stream
    set_volume(current_volume)
    # 3. Mark dirty to debounce flash state saving
    volume_dirty = True
    last_volume_change_time = time.time()


def flush_state_volume():
    global volume_dirty
    if volume_dirty:
        save_state_volume(current_volume)
        volume_dirty = False


def enforce_volume():
    """Watchdog: the state file wins over any external ALSA writer."""
    global current_volume
    saved = read_state_volume()
    if saved is not None and saved != current_volume:
        current_volume = saved
        if ring_active and not is_fading:
            show_volume_ring(current_volume, brightness=1.0)
        set_volume(current_volume)
        return

    expected = (volume_to_raw(current_volume, 255),
                volume_to_raw(current_volume, 255),
                volume_to_raw(current_volume, 191))
    actual = read_alsa_controls()
    if actual is None:
        return
    if any(abs(a - b) > 1 for a, b in zip(actual, expected)):
        set_volume(current_volume)


def set_ring_frame(frame):
    try:
        with open(FB_RING, "wb") as f:
            f.write(frame)
            f.flush()
    except Exception:
        pass


def show_mute_ring():
    # No ring indication for mic mute
    set_ring_frame(b"\x00" * (NUM_LEDS * 3))


def show_volume_ring(vol_pct, brightness=1.0):
    exact = NUM_LEDS * max(0, min(100, vol_pct)) / 100.0
    full = int(exact)
    frac = exact - full
    frame = bytearray(NUM_LEDS * 3)
    b = max(0.0, min(1.0, brightness))
    for i in range(full):
        ratio = i / max(1, NUM_LEDS - 1)
        frame[i * 3 + 0] = int(180 * ratio * b)
        frame[i * 3 + 1] = int(220 * (1.0 - ratio) * b)
        frame[i * 3 + 2] = int(255 * b)
    if full < NUM_LEDS and frac > 0:
        ratio = full / max(1, NUM_LEDS - 1)
        frame[full * 3 + 0] = int(180 * ratio * frac * b)
        frame[full * 3 + 1] = int(220 * (1.0 - ratio) * frac * b)
        frame[full * 3 + 2] = int(255 * frac * b)
    set_ring_frame(frame)


def clear_ring():
    global ring_active, is_fading
    ring_active = False
    is_fading = False
    if mic_muted:
        show_mute_ring()
    else:
        set_ring_frame(b"\x00" * (NUM_LEDS * 3))


def toggle_software_mic_mute():
    global mic_muted
    mic_muted = not mic_muted

    alsa_cmd = "mute" if mic_muted else "unmute"
    alsa_vol = "0%" if mic_muted else "100%"
    sw_val = "0" if mic_muted else "1"
    adc_mute = "1" if mic_muted else "0"

    # ALSA AMLAUGESOUND hardware capture mute.  PipeWire has no ALSA
    # backend in this image, so there is nothing to do through wpctl.
    for card in ["AMLAUGESOUND", "0"]:
        try:
            subprocess.run([AMIXER, "-c", card, "sset", "Capture", alsa_cmd],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([AMIXER, "-c", card, "sset", "Capture", alsa_vol],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for ctrl in ["Capture Switch", "ADC Capture Switch",
                         "Mic Capture Switch", "TDMIN_A Switch",
                         "TDMIN_B Switch"]:
                subprocess.run([AMIXER, "-c", card, "cset", "name=" + ctrl, sw_val],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for i in (1, 2, 3, 4):
                subprocess.run([AMIXER, "-c", card, "cset", f"name=Loopback ADC{i}_MUTE", adc_mute],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    if mic_muted:
        show_mute_ring()
    else:
        clear_ring()


def ensure_input_nodes():
    """Ensure /dev/input/event* device nodes exist if /sys/class/input/event* are present."""
    try:
        os.makedirs("/dev/input", exist_ok=True)
        for sys_ev in glob.glob("/sys/class/input/event*"):
            dev_file = os.path.join(sys_ev, "dev")
            if os.path.exists(dev_file):
                node_name = os.path.basename(sys_ev)
                dev_node = os.path.join("/dev/input", node_name)
                if not os.path.exists(dev_node):
                    with open(dev_file, "r") as f:
                        parts = f.read().strip().split(":")
                    if len(parts) == 2:
                        maj, min_ = int(parts[0]), int(parts[1])
                        os.mknod(dev_node, 0o660 | 0o020000, os.makedev(maj, min_))
    except Exception:
        pass


def find_devices():
    return sorted(glob.glob("/dev/input/event*"))


def scan_and_open_devices(open_fds):
    """Scan for event devices and add newly discovered ones to open_fds."""
    ensure_input_nodes()
    opened_paths = set(open_fds.values())
    for path in find_devices():
        if path not in opened_paths:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                open_fds[fd] = path
            except Exception:
                pass


def main():
    global current_volume
    EVENT_FORMAT = "QQHHi"
    EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
    open_fds = {}

    scan_and_open_devices(open_fds)

    top_press_time = 0
    last_volume_time = 0
    apply_saved_volume()
    last_enforce = time.time()
    last_scan = time.time()

    try:
        while True:
            # 100 ms wakeup keeps the fade-out and watchdog responsive; input
            # events still wake select immediately.
            fds_to_watch = list(open_fds.keys())
            select_timeout = 0.02 if (ring_active and is_fading) else 0.05
            rlist, _, _ = select.select(fds_to_watch, [], [], select_timeout) if fds_to_watch else ([], [], [])
            now = time.time()

            # Debounced state flush: write to flash 300ms after user finishes rotating the knob
            if volume_dirty and (now - last_volume_change_time > 0.3):
                flush_state_volume()

            # Watchdog: enforce saved volume only when knob is idle
            if now - last_enforce > 1.0:
                if not volume_dirty and (now - last_volume_time > 1.5):
                    enforce_volume()
                last_enforce = now

            # Periodic device re-scan (every 3s if missing devices or devices changed)
            if now - last_scan > 3.0:
                scan_and_open_devices(open_fds)
                last_scan = now

            # Smooth fade-out of volume ring
            if ring_active and not mic_muted:
                if not is_fading:
                    if now - last_volume_time >= FADE_IDLE_DELAY:
                        is_fading = True
                        fade_start_time = now
                else:
                    elapsed = now - fade_start_time
                    if elapsed >= FADE_DURATION:
                        clear_ring()
                    else:
                        progress = elapsed / FADE_DURATION
                        brightness = 0.5 * (1.0 + math.cos(math.pi * progress))
                        show_volume_ring(current_volume, brightness=brightness)

            for fd in rlist:
                try:
                    data = os.read(fd, EVENT_SIZE * 64)
                    net_vol_step = 0
                    for offset in range(0, len(data), EVENT_SIZE):
                        chunk = data[offset:offset + EVENT_SIZE]
                        if len(chunk) < EVENT_SIZE:
                            continue
                        sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, chunk)
                        if ev_type == 1:  # EV_KEY
                            # Rotary knob CW
                            if ev_code == KEY_PAGEUP and ev_value == 1:
                                net_vol_step += VOLUME_STEP
                            # Rotary knob CCW
                            elif ev_code == KEY_PAGEDOWN and ev_value == 1:
                                net_vol_step -= VOLUME_STEP
                            # Top Button 2: Dedicated Physical Microphone Mute
                            elif ev_code == KEY_MICMUTE and ev_value == (0 if MIC_MUTE_ACTIVE_LOW else 1):
                                toggle_software_mic_mute()
                            # Top Button 1: Assistant / Play-Pause
                            elif ev_code in (KEY_VOICECOMMAND, KEY_POWER):
                                if ev_value == 1:
                                    top_press_time = time.time()
                                elif ev_value == 0:
                                    duration = time.time() - top_press_time
                                    if duration >= 2.5:
                                        pass
                                else:
                                    try:
                                        subprocess.run(["playerctl", "play-pause"],
                                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                    except Exception:
                                        pass
                    if net_vol_step != 0:
                        adjust_volume(net_vol_step)
                        last_volume_time = time.time()
                except OSError:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    open_fds.pop(fd, None)
                except Exception:
                    pass
    finally:
        flush_state_volume()


if __name__ == "__main__":
    main()
