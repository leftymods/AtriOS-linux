# Single centered colon, 2-row dots, matching the 13-row digits.
CLOCK_COLON = [0b000, 0b000, 0b010, 0b010, 0b000, 0b000, 0b000, 0b010, 0b010, 0b000, 0b000, 0b000, 0b000]
CLOCK_COLON_WIDTH = 3

# --- Ambient Light Sensor ---
def read_sensor_lux():
    if os.path.exists(SENSOR_PATH):
        try:
            with open(SENSOR_PATH, "r") as f:
                val = float(f.read().strip())
                return val * 0.2  # 0.2 lux per count for LTR-308ALS
        except Exception:
            pass
    return None

# --- Screen Methods (1200 bytes, 3 bytes per pixel) ---
def screen_set_pixel(buf, x, y, brightness):
    if 0 <= x < SCR_W and 0 <= y < SCR_H:
        val = max(0, min(255, int(brightness)))
        offset = (y * SCR_W + x) * SCR_BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

def screen_send_frame(buf):
    try:
        with open(FB_SCREEN, "wb") as f:
            f.write(buf[:SCR_SIZE])
            f.flush()
        return True
    except Exception as e:
        print(f"[Screen Error] Failed writing {FB_SCREEN}: {e}", flush=True)
        return False

def screen_clear():
    screen_send_frame(bytearray(SCR_SIZE))
    print("[Screen] Cleared (All LEDs OFF).", flush=True)

def screen_fill(brightness=200):
    val = max(0, min(255, int(brightness)))
    buf = bytearray(SCR_SIZE)
    for y in range(SCR_H):
        for x in range(SCR_W):
            screen_set_pixel(buf, x, y, val)
    screen_send_frame(buf)
    print(f"[Screen] Filled with brightness {val}/255.", flush=True)

def screen_clock(brightness=220):
    now = time.strftime("%H:%M")
    buf = bytearray(SCR_SIZE)
    x_positions = [0, 6, 12, 15, 20]
    for char, x_start in zip(now, x_positions):
        if char == ':':
            glyph = CLOCK_COLON
            width = CLOCK_COLON_WIDTH
        else:
            glyph = CLOCK_FONT_5X13.get(char, [0]*13)
            width = 5
        for row_idx, row_bits in enumerate(glyph):
            y = 1 + row_idx
            for col_idx in range(width):
                if (row_bits >> (width - 1 - col_idx)) & 1:
                    screen_set_pixel(buf, x_start + col_idx, y, brightness)
    screen_send_frame(buf)
    print(f"[Screen] Clock: {now} (brightness={brightness}/255)", flush=True)

