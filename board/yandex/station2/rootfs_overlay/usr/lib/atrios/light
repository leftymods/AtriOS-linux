from atrios_status import active_error

def find_fb(names, default):
    for f in sorted(glob.glob("/sys/class/graphics/fb*")):
        try:
            with open(os.path.join(f, "name"), "r") as nf:
                fb_name = nf.read().strip().lower()
                for n in names:
                    if n.lower() in fb_name:
                        return f"/dev/{os.path.basename(f)}"
        except Exception:
            pass
    return default

def find_sensor():
    for f in sorted(glob.glob("/sys/bus/iio/devices/iio:device*/in_*")):
        return f
    return "/sys/bus/iio/devices/iio:device0/in_intensity_input"

