}
E_X_SPRITE = ["##...##", "###.###", ".#####.", "..###..", ".#####.", "###.###", "##...##"]
E_X_SMALL = ["##...##", ".##.##.", "..###..", ".##.##.", "##...##"]
E_WIFI = ["..#######..", ".#.......#.", "#..#####..#", "..#.....#..", "....###....", "...........", ".....#.....", "....###...."]
E_GLOBE = ["..#####..", ".#.#.#.#.", "#########", "#..#.#..#", "#########", ".#.#.#.#.", "..#####.."]
E_THERM = [".###.", ".#.#.", ".#.#.", ".###.", ".###.", "#####", "#####", ".###."]


def render_error_pixels(variant="default", t=0.0):
    """Render one frame (16x25 bitmap of 0/1) for an `error:<variant>` indicator."""
    v = E_ERROR_ALIASES.get(variant, variant)
    if v not in E_ERROR_VARIANTS:
        v = "default"
    px_grid = [bytearray(E_W) for _ in range(E_H)]

    def px(x, y):
        ix, iy = _rnd(x), _rnd(y)
        if 0 <= ix < E_W and 0 <= iy < E_H:
            px_grid[iy][ix] = 1

    def bmp(x0, y0, rows):
        for r, row in enumerate(rows):
            for c, ch in enumerate(row):
                if ch == "#":
                    px(x0 + c, y0 + r)

    def rect(x0, y0, w, h):
        for dy in range(h):
            for dx in range(w):
                px(x0 + dx, y0 + dy)

    if v == "default":
        shake = 0 if int(t * 16) % 2 == 0 else (1 if int(t * 8) % 2 == 0 else -1)
        if int(t * 5) % 4 != 3:
            bmp(E_LEFT_X + shake, 4, E_X_SPRITE)
            bmp(E_RIGHT_X + shake, 4, E_X_SPRITE)
    elif v == "wifi":
        bmp(2, 4, E_WIFI)
        if int(t * 3.5) % 2 == 0:
            bmp(16, 6, E_X_SMALL)
    elif v == "no_internet":
        bmp(3, 4, E_GLOBE)
        if int(t * 3.5) % 2 == 0:
            rect(17, 4, 2, 5)
            rect(17, 10, 2, 2)
    elif v == "overheat":
        bmp(6, 4, E_THERM)
        if int(t * 4.0) % 2 == 0:
            rect(15, 4, 2, 5)
            rect(15, 10, 2, 2)
    elif v == "audio_err":
        bmp(5, 4, E_SPEAKER)
        if int(t * 3.5) % 2 == 0:
            bmp(13, 5, E_X_SMALL)
    elif v == "kernel_panic":
        glitch = (int(t * 18) % 3) - 1
        bmp(E_LEFT_X + glitch, 2, E_X_SPRITE)
        bmp(E_RIGHT_X - glitch, 2, E_X_SPRITE)
        seed = int(t * 20)
        for x in range(E_W):
            if ((x * 13 + seed * 7) % 11) < 3:
                px(x, 12 + ((x + seed) % 3))
        if seed % 4 == 0:
            y_line = (seed * 3) % E_H
            for x in range(E_W):
                px(x, y_line)
    return px_grid


def screen_error(variant="default", brightness=200, duration=None):
    """Animate an error indicator (`default|wifi|no_internet|overheat|audio_err|kernel_panic`)."""
    raw = (variant or "default").strip().lower()
    if raw.startswith("error:"):
        raw = raw[6:] or "default"
    v = E_ERROR_ALIASES.get(raw, raw)
    if v not in E_ERROR_VARIANTS:
        print(f"[Screen] Unknown error type '{variant}'. Types: {', '.join(E_ERROR_VARIANTS)}", flush=True)
        return
    print(f"[Screen] Error: {v} (brightness={brightness}/255)", flush=True)
    b = max(0, min(255, int(brightness)))
    t0 = time.monotonic()
    end = t0 + duration if duration else None
    try:
        while end is None or time.monotonic() < end:
            grid = render_error_pixels(v, time.monotonic() - t0)
            buf = bytearray(SCR_SIZE)
            for y in range(E_H):
                for x in range(E_W):
                    if grid[y][x]:
                        o = (y * E_W + x) * SCR_BPP
                        buf[o] = buf[o + 1] = buf[o + 2] = b
            screen_send_frame(buf)
            time.sleep(1.0 / E_FPS)
    except KeyboardInterrupt:
        pass


def screen_ticker(text, brightness=220, speed=0.07):
    text = " " + text.upper() + " "
    # Build complete text pixel buffer
    total_cols = len(text) * 6
    text_grid = [[0]*total_cols for _ in range(7)]
    for char_idx, char in enumerate(text):
        glyph = FONT_5X7.get(char, [0]*7)
        for r, row_bits in enumerate(glyph):
            for c in range(5):
                if (row_bits >> (4 - c)) & 1:
                    text_grid[r][char_idx * 6 + c] = 1

    print(f"[Screen] Scrolling: \"{text.strip()}\"...", flush=True)
    try:
        for offset in range(total_cols - SCR_W + 1):
            buf = bytearray(SCR_SIZE)
            for r in range(7):
                y = 4 + r
                for x in range(SCR_W):
                    if text_grid[r][offset + x]:
                        screen_set_pixel(buf, x, y, brightness)
            screen_send_frame(buf)
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    screen_clear()

# --- Ring Methods (72 bytes /dev/fb5) ---
def ring_send_frame(frame):
    if active_error() or os.path.exists("/var/run/atrios/ring_override"):
        # rotaryd owns error/microphone-mute/volume indication.
        return False
    try:
        with open(FB_RING, "wb") as f:
            f.write(frame[:RING_SIZE])
            f.flush()
        return True
    except Exception as e:
        print(f"[Ring Error] Failed writing {FB_RING}: {e}", flush=True)
        return False

def ring_clear():
    ring_send_frame(b"\x00" * RING_SIZE)
    print("[Ring] Turned OFF.", flush=True)

def ring_fill(r, g, b):
    r, g, b = max(0, min(255, int(r))), max(0, min(255, int(g))), max(0, min(255, int(b)))
    frame = bytes([r, g, b]) * RING_LEDS
    ring_send_frame(frame)
    print(f"[Ring] Filled RGB({r}, {g}, {b}).", flush=True)

def ring_rainbow(speed=0.05, duration=5.0):
    print("[Ring] Running rainbow animation...", flush=True)
    start = time.time()
    step = 0
    try:
        while (time.time() - start) < duration:
            frame = bytearray(RING_SIZE)
            for i in range(RING_LEDS):
                hue = (step + i * (360 // RING_LEDS)) % 360
                # HSL to RGB
                c = 255
                x = int(c * (1 - abs((hue / 60) % 2 - 1)))
                if hue < 60:    r, g, b = c, x, 0
                elif hue < 120: r, g, b = x, c, 0
                elif hue < 180: r, g, b = 0, c, x
                elif hue < 240: r, g, b = 0, x, c
                elif hue < 300: r, g, b = x, 0, c
                else:           r, g, b = c, 0, x
                frame[i*3 + 0] = r
                frame[i*3 + 1] = g
                frame[i*3 + 2] = b
            ring_send_frame(frame)
            step = (step + 10) % 360
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    ring_clear()

def ring_amber(speed=0.04, duration=8.0):
    print("[Ring] Running amber shimmer animation...", flush=True)
    start = time.time()
    phase = 0.0
    try:
        while duration <= 0 or (time.time() - start) < duration:
            if os.path.exists("/var/run/atrios/ring_override"):
                return
            frame = bytearray(RING_SIZE)
            for i in range(RING_LEDS):
                wave = 0.5 * (1.0 + math.sin(phase + i * (2.0 * math.pi / RING_LEDS) * 2.0))
                r = int(140 + 115 * wave)
                g = int(35 + 125 * wave)
                b = int(14 * (wave * wave))
                frame[i * 3 + 0] = r
                frame[i * 3 + 1] = g
                frame[i * 3 + 2] = b
            ring_send_frame(frame)
            phase = (phase + 0.16) % (2.0 * math.pi)
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    ring_clear()

def ring_amber_green(speed=0.04, duration=15.0):
    print("[Ring] Running amber+green runner animation...", flush=True)
    start = time.time()
    pos = 0.0
    try:
        while duration <= 0 or (time.time() - start) < duration:
            if os.path.exists("/var/run/atrios/ring_override"):
                return
            frame = bytearray(RING_SIZE)
            for i in range(RING_LEDS):
                d = abs(i - pos)
                d = min(d, RING_LEDS - d)
                green_mix = max(0.0, 1.0 - (d / 3.2)) ** 2
                r = int(225 * (1.0 - green_mix))
                g = int(90 * (1.0 - green_mix) + 255 * green_mix)
                b = int(20 * green_mix)
                frame[i * 3 + 0] = r
                frame[i * 3 + 1] = g
                frame[i * 3 + 2] = b
            ring_send_frame(frame)
            pos = (pos + 0.45) % RING_LEDS
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    ring_clear()

def ring_volume(pct, fade=True):
    pct = max(0, min(100, int(pct)))
    active = int(round(RING_LEDS * (pct / 100.0)))
    frame = bytearray(RING_SIZE)
    red_advance = max(0.0, min(1.0, (float(pct) - 50.0) / 50.0))
    red_threshold = 1.0 - red_advance
    for i in range(RING_LEDS):
        if i < active:
            ratio = i / max(1, RING_LEDS - 1)
            if ratio >= red_threshold:
                r, g = 255, 0
            else:
                rel = ratio / max(0.01, red_threshold)
                if rel < 0.5:
                    r = int(255 * (rel * 2.0))
                    g = 255
                else:
                    r = 255
                    g = int(255 * (2.0 - rel * 2.0))
            frame[i * 3 + 0] = r
            frame[i * 3 + 1] = g
            frame[i * 3 + 2] = 0
    ring_send_frame(frame)
    print(f"[Ring] Volume arc: {pct}% ({active}/{RING_LEDS} LEDs lit).", flush=True)
    if fade and active > 0:
        time.sleep(1.0)
        steps = 15
        for s in range(steps):
            prog = (s + 1) / float(steps)
            b = 0.5 * (1.0 + math.cos(math.pi * prog))
            dimmed = bytearray(RING_SIZE)
            for j in range(RING_SIZE):
                dimmed[j] = int(frame[j] * b)
            ring_send_frame(dimmed)
            time.sleep(0.04)
        ring_clear()

def main():
    parser = argparse.ArgumentParser(description="AtriOS Unified Light & Display Controller")
    subparsers = parser.add_subparsers(dest="component", help="Subsystem: screen, ring, sensor, all")

    # Screen parser
    p_scr = subparsers.add_parser("screen", help="Front 25x16 monochrome matrix")
    p_scr.add_argument("action", nargs="?", default="clock",
                       choices=["clock", "eyes", "error", "kisser", "cat", "boykisser", "ticker", "pixel", "row", "col", "gradient", "fill", "clear", "off", "smile", "happy", "test"],
                       help="Action to perform")
    p_scr.add_argument("value", nargs="*", help="Arguments for action (e.g. text for ticker, X Y for pixel)")
    p_scr.add_argument("--brightness", type=int, default=220, help="Brightness level (0..255)")

    # Ring parser
    p_ring = subparsers.add_parser("ring", help="Top 24-channel RGB LED ring")
    p_ring.add_argument("action", nargs="?", default="rainbow",
                        choices=["rainbow", "amber", "amber_green", "volume", "red", "blue", "green", "fill", "clear", "off"],
                        help="Ring effect")
    p_ring.add_argument("value", nargs="*", help="Parameters (e.g. volume percent, RGB values)")

    # Sensor parser
    subparsers.add_parser("sensor", help="Read ambient light sensor (Lux)")

    if len(sys.argv) >= 3 and sys.argv[1] == "screen" and sys.argv[2].lower().startswith("error:"):
        sys.argv[2:3] = ["error", sys.argv[2][6:] or "default"]

    args = parser.parse_args()

    if args.component == "sensor":
        lux = read_sensor_lux()
        if lux is not None:
            print(f"[Sensor] Ambient Light (LTR-308ALS): \033[1;36m{lux:.1f} Lux\033[0m", flush=True)
        else:
            print("[Sensor] LTR-308ALS not found on sysfs.", flush=True)

    elif args.component == "ring":
        act = args.action
        if act in ("off", "clear"):
            ring_clear()
        elif act == "red":
            ring_fill(255, 0, 0)
        elif act == "blue":
            ring_fill(0, 0, 255)
        elif act == "green":
            ring_fill(0, 255, 0)
        elif act == "rainbow":
            ring_rainbow()
        elif act == "amber":
            dur = float(args.value[0]) if args.value else 8.0
            ring_amber(duration=dur)
        elif act == "amber_green":
            dur = float(args.value[0]) if args.value else 15.0
            ring_amber_green(duration=dur)
        elif act == "volume":
            pct = int(args.value[0]) if args.value else 50
            ring_volume(pct)
        elif act == "fill":
            r = int(args.value[0]) if len(args.value) > 0 else 255
            g = int(args.value[1]) if len(args.value) > 1 else 255
            b = int(args.value[2]) if len(args.value) > 2 else 255
            ring_fill(r, g, b)

    elif args.component == "screen":
        act = args.action
        b = args.brightness
        if act in ("clear", "off"):
            screen_clear()
        elif act == "fill":
            val = int(args.value[0]) if args.value else b
            screen_fill(val)
        elif act == "clock":
            screen_clock(b)
        elif act in ("kisser", "cat", "boykisser"):
            mode = args.value[0] if args.value else "animate"
            screen_boykisser(mode, b)
        elif act in ("eyes", "smile", "happy"):
            state = "happy" if act in ("smile", "happy") else (args.value[0] if args.value else "idle")
            screen_eyes(state, b)
        elif act == "error":
            variant = args.value[0] if args.value else "default"
            screen_error(variant, b)
        elif act == "test":
            screen_fill(100)
            time.sleep(0.8)
            screen_eyes("happy", b, 1.5)
            screen_ticker("ATRIOS", b)
            screen_clock(b)
        elif act == "ticker":
            text = " ".join(args.value) if args.value else "ATRIOS"
            screen_ticker(text, b)
        elif act == "pixel":
            if len(args.value) >= 2:
                x, y = int(args.value[0]), int(args.value[1])
                val = int(args.value[2]) if len(args.value) > 2 else b
                buf = bytearray(SCR_SIZE)
                screen_set_pixel(buf, x, y, val)
                screen_send_frame(buf)
                print(f"[Screen] Set pixel ({x}, {y}) = {val}/255", flush=True)
            else:
                print("Usage: atrios screen pixel <x> <y> [brightness]", flush=True)
        elif act == "gradient":
            buf = bytearray(SCR_SIZE)
            for y in range(SCR_H):
                for x in range(SCR_W):
                    v = int(255 * (x / (SCR_W - 1)) * (y / (SCR_H - 1)))
                    screen_set_pixel(buf, x, y, v)
            screen_send_frame(buf)
            print("[Screen] Gradient test pattern rendered.", flush=True)

    else:
        # Default overview
        print("==========================================================", flush=True)
        print("          AtriOS Unified Light & Display Manager          ", flush=True)
        print("==========================================================", flush=True)
        lux = read_sensor_lux()
        if lux is not None:
            print(f"  * Ambient Light Sensor: \033[1;36m{lux:.1f} Lux\033[0m", flush=True)
        print(f"  * Front Matrix: Gowin 25x16 ({FB_SCREEN}, 1200B RGB888)", flush=True)
        print(f"  * Top RGB Ring: 24 Channels ({FB_RING}, 72B RGB)", flush=True)
        print("\nCommands:")
        print("  atrios screen kisser [1|2|animate] - Boykisser cat animation (Frame 1 calm / Frame 2 happy)")
        print("  atrios screen eyes [state]         - Eyes (idle listening thinking speaking[:variant] happy love surprised wink cool confused angry sad sleep boot bt_speaker clock volume ...)")
        print("  atrios screen error [type]         - Error indicator (default|wifi|no_internet|overheat|audio_err|kernel_panic)")
        print("  atrios screen clock                - Display current time")
        print("  atrios screen ticker \"TEXT\"       - Scrolling marquee")
        print("  atrios screen pixel X Y [B]        - Individual LED control (0..255)")
        print("  atrios screen off                  - Turn off screen")
        print("  atrios ring rainbow                - Rainbow animation")
        print("  atrios ring amber [sec]            - Warm amber shimmer animation")
        print("  atrios ring amber_green [sec]      - Green pulse running over amber ring")
        print("  atrios ring volume 70              - Volume arc at 70%")
        print("  atrios ring red                    - Mic Mute solid red")
        print("  atrios ring off                    - Turn off ring")
        print("  atrios sensor                      - Read live lux level")
        print("==========================================================", flush=True)

if __name__ == "__main__":
    main()
