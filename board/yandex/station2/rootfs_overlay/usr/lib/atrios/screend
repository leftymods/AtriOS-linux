#!/usr/bin/env python3
"""
AtriOS Background Screen Clock Daemon (atrios-screend)
Updates the front Gowin 25x16 monochrome matrix with current time (HH:MM).
Hardware:
  - Display: 25 columns x 16 rows monochrome white LED matrix with 8-bit individual brightness
  - Kernel Driver: gowin_led_device (/dev/fb4) exposing RGB888 (24-bpp) framebuffer
  - Stride: 25 * 3 = 75 bytes per row, total frame = 1200 bytes
  - Mapping: Driver computes brightness = max(R, G, B) for each LED
"""

import sys
import os
import time

FB_SCREEN = "/dev/fb4"
WIDTH = 25
HEIGHT = 16
BPP = 3
FRAME_SIZE = WIDTH * HEIGHT * BPP

# Official 5x9 digits from Yandex clock_large.gif font:
# 4 digits (5px wide) + 1 colon (1px wide) + 4 spaces (1px wide) = 25px total width!
# Perfectly fills and balances across all 25 columns of the matrix.
FONT_LARGE_5X9 = {
    '0': [
        0b01110,
        0b10001,
        0b10001,
        0b10001,
        0b10001,
        0b10001,
        0b10001,
        0b10001,
        0b01110,
    ],
    '1': [
        0b00100,
        0b01100,
        0b00100,
        0b00100,
        0b00100,
        0b00100,
        0b00100,
        0b00100,
        0b01110,
    ],
    '2': [
        0b01110,
        0b10001,
        0b00001,
        0b00001,
        0b00110,
        0b01000,
        0b10000,
        0b10000,
        0b11111,
    ],
    '3': [
        0b01110,
        0b10001,
        0b00001,
        0b00001,
        0b01110,
        0b00001,
        0b00001,
        0b10001,
        0b01110,
    ],
    '4': [
        0b10001,
        0b10001,
        0b10001,
        0b10001,
        0b01111,
        0b00001,
        0b00001,
        0b00001,
        0b00001,
    ],
    '5': [
        0b11111,
        0b10000,
        0b10000,
        0b11110,
        0b00001,
        0b00001,
        0b00001,
        0b10001,
