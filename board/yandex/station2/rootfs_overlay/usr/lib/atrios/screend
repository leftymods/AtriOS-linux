# Column start positions for "HH:MM" (digits: 5px, colon: 1px, spaces: 1px):
# Total: 5 + 1 + 5 + 1 + 1 + 1 + 5 + 1 + 5 = 25 columns
X_POSITIONS = [0, 6, 12, 14, 20]

def set_pixel(buf, x, y, brightness):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        val = max(0, min(255, int(brightness)))
        offset = (y * WIDTH + x) * BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

BT_GLYPH = [0b010, 0b110, 0b010, 0b110, 0b010]

def is_bt_active():
    try:
        if os.path.exists("/var/run/atrios/bt_active"):
            with open("/var/run/atrios/bt_active", "r") as f:
                return f.read().strip() == "1"
    except Exception:
        pass
    return False

def send_frame(buf):
    fb = get_fb_screen()
    try:
        with open(fb, "wb") as f:
            f.write(buf[:FRAME_SIZE])
            f.flush()
    except Exception:
        pass

SCREEN_MODE_FILE = "/var/run/atrios/screen_mode"

def get_screen_mode():
    try:
        if os.path.exists(SCREEN_MODE_FILE):
            with open(SCREEN_MODE_FILE, "r") as f:
                m = f.read().strip()
                if m:
                    return m
    except Exception:
        pass
    return "clock"

ERROR_CODE_MAP = {
    1: "wifi",
    2: "no_internet",
    3: "no_internet",
    4: "audio_err",
    5: "default",
    6: "default",
    7: "kernel_panic",
}
ERROR_KIND_MAP = {
    "default": "default", "x": "default", "update": "default", "signature": "default",
    "wifi": "wifi", "network": "wifi",
    "no_internet": "no_internet", "internet": "no_internet", "tls": "no_internet", "server": "no_internet",
    "overheat": "overheat", "thermal": "overheat",
    "audio_err": "audio_err", "audio": "audio_err",
    "kernel_panic": "kernel_panic", "panic": "kernel_panic", "storage": "kernel_panic",
}
ERR_X = ["##...##", "###.###", ".#####.", "..###..", ".#####.", "###.###", "##...##"]
ERR_X_SM = ["##...##", ".##.##.", "..###..", ".##.##.", "##...##"]
ERR_WIFI = ["..#######..", ".#.......#.", "#..#####..#", "..#.....#..", "....###....", "...........", ".....#.....", "....###...."]
ERR_GLOBE = ["..#####..", ".#.#.#.#.", "#########", "#..#.#..#", "#########", ".#.#.#.#.", "..#####.."]
ERR_THERM = [".###.", ".#.#.", ".#.#.", ".###.", ".###.", "#####", "#####", ".###."]
ERR_SPK = ["...#", "..##", "####", "####", "####", "..##", "...#"]


def _resolve_error_variant(code_or_error):
    if isinstance(code_or_error, dict):
        kind = str(code_or_error.get("kind", "")).lower()
        if kind in ERROR_KIND_MAP:
            return ERROR_KIND_MAP[kind]
        return ERROR_CODE_MAP.get(code_or_error.get("code"), "default")
    if isinstance(code_or_error, str):
        low = code_or_error.strip().lower()
        if low.startswith("error:"):
            low = low[6:] or "default"
        return ERROR_KIND_MAP.get(low, "default")
    return ERROR_CODE_MAP.get(code_or_error, "default")


def render_error(code, t=0.0):
    buf = bytearray(FRAME_SIZE)
    variant = _resolve_error_variant(code)
    bright = 200

    def bmp(x0, y0, rows):
        for r, row in enumerate(rows):
            for c, ch in enumerate(row):
                if ch == "#":
                    set_pixel(buf, x0 + c, y0 + r, bright)

    def rect(x0, y0, w, h):
        for dy in range(h):
            for dx in range(w):
                set_pixel(buf, x0 + dx, y0 + dy, bright)

    if variant == "default":
        shake = 0 if int(t * 16) % 2 == 0 else (1 if int(t * 8) % 2 == 0 else -1)
        if int(t * 5) % 4 != 3:
            bmp(3 + shake, 4, ERR_X)
            bmp(15 + shake, 4, ERR_X)
    elif variant == "wifi":
        bmp(2, 4, ERR_WIFI)
        if int(t * 3.5) % 2 == 0:
            bmp(16, 6, ERR_X_SM)
    elif variant == "no_internet":
        bmp(3, 4, ERR_GLOBE)
        if int(t * 3.5) % 2 == 0:
            rect(17, 4, 2, 5)
            rect(17, 10, 2, 2)
    elif variant == "overheat":
        bmp(6, 4, ERR_THERM)
        if int(t * 4.0) % 2 == 0:
            rect(15, 4, 2, 5)
            rect(15, 10, 2, 2)
    elif variant == "audio_err":
        bmp(5, 4, ERR_SPK)
        if int(t * 3.5) % 2 == 0:
            bmp(13, 5, ERR_X_SM)
    elif variant == "kernel_panic":
        glitch = (int(t * 18) % 3) - 1
        bmp(3 + glitch, 2, ERR_X)
        bmp(15 - glitch, 2, ERR_X)
        seed = int(t * 20)
        for x in range(WIDTH):
            if ((x * 13 + seed * 7) % 11) < 3:
                set_pixel(buf, x, 12 + ((x + seed) % 3), bright)
        if seed % 4 == 0:
            y_line = (seed * 3) % HEIGHT
            for x in range(WIDTH):
                set_pixel(buf, x, y_line, bright)
    send_frame(buf)


def main():
    last_rendered = ""
    last_bt = None
    last_tz = None
    while True:
        error = active_error()
        if error:
            render_error(error, time.monotonic())
            last_rendered = ""
            time.sleep(1.0 / 15)
            continue
        if get_screen_mode() != "clock":
            last_rendered = ""
            time.sleep(0.5)
            continue
        cur_tz = os.path.realpath("/etc/localtime") if os.path.exists("/etc/localtime") else None
        if cur_tz != last_tz:
            time.tzset()
            last_tz = cur_tz
        now = time.strftime("%H:%M")
        bt = is_bt_active()
        if now != last_rendered or bt != last_bt:
            buf = bytearray(FRAME_SIZE)
            for char, x_start in zip(now, X_POSITIONS):
                glyph = FONT_LARGE_5X9.get(char, [0]*9)
                width = 1 if char == ':' else 5
                # Center vertically: 9 rows inside 16 -> start at y = 3 (rows 3..11)
                for row_idx, row_bits in enumerate(glyph):
                    y = 3 + row_idx
                    for col_idx in range(width):
                        if (row_bits >> (width - 1 - col_idx)) & 1:
                            set_pixel(buf, x_start + col_idx, y, 200)
            
            # In Bluetooth speaker mode, render the Bluetooth badge/indicator
            # Hidden in simple setup / normal clock mode
            if bt:
                for r_idx, bits in enumerate(BT_GLYPH):
                    for c_idx in range(3):
                        if (bits >> (2 - c_idx)) & 1:
                            set_pixel(buf, 21 + c_idx, r_idx, 200)

            send_frame(buf)
            last_rendered = now
            last_bt = bt
        time.sleep(1)

if __name__ == "__main__":
    main()
