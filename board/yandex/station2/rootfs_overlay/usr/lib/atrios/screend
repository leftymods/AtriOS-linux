#!/usr/bin/env python3
"""
AtriOS Background Screen Clock Daemon (atrios-screend)
Updates the front Gowin 25x16 monochrome matrix with current time (HH:MM).
Hardware:
  - Display: 25 columns x 16 rows monochrome white LED matrix with 8-bit individual brightness
  - Kernel Driver: gowin_led_device (/dev/fb4) exposing RGB888 (24-bpp) framebuffer
  - Stride: 25 * 3 = 75 bytes per row, total frame = 1200 bytes
  - Mapping: Driver computes brightness = max(R, G, B) for each LED
"""

import sys
import os
import time
import glob

WIDTH = 25
HEIGHT = 16
BPP = 3
FRAME_SIZE = WIDTH * HEIGHT * BPP

def find_fb_by_name(keywords):
    for path in sorted(glob.glob("/sys/class/graphics/fb*/name")):
        try:
            with open(path, "r") as f:
                name = f.read().strip().lower()
                for kw in keywords:
                    if kw.lower() in name:
                        dev = "/dev/" + os.path.basename(os.path.dirname(path))
                        return dev
        except Exception:
            pass
    return None

def get_fb_screen():
    dev = find_fb_by_name(["screen", "gowin", "panel", "yndx led screen"])
    if dev and os.path.exists(dev):
        return dev
    for fallback in ("/dev/fb4", "/dev/fb3", "/dev/fb2", "/dev/fb1", "/dev/fb0"):
        if os.path.exists(fallback):
            return fallback
    return "/dev/fb4"

FB_SCREEN = get_fb_screen()

