#!/usr/bin/env python3
"""
AtriOS Background Screen Clock Daemon (atrios-screend)
Updates the front Gowin 25x16 monochrome matrix with current time (HH:MM).
Hardware:
  - Display: 25 columns x 16 rows monochrome white LED matrix with 8-bit individual brightness
  - Kernel Driver: gowin_led_device (/dev/fb4) exposing RGB888 (24-bpp) framebuffer
  - Stride: 25 * 3 = 75 bytes per row, total frame = 1200 bytes
  - Mapping: Driver computes brightness = max(R, G, B) for each LED
"""

import sys
import os
import time

FB_SCREEN = "/dev/fb4"
WIDTH = 25
HEIGHT = 16
BPP = 3
FRAME_SIZE = WIDTH * HEIGHT * BPP

# 5x13 seven-segment clock face.  The 25x16 panel is tall, so use the
# height: 2-row horizontal bars, 1-pixel vertical strokes and a 2-row
# colon.  The glyphs keep blank side bearings, so adjacent minute digits
# still read as separate characters.
FONT = {
    '0': [0b01110, 0b01110, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110, 0b01110],
    '1': [0b00100, 0b01100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110, 0b01110],
    '2': [0b01110, 0b01110, 0b10001, 0b00001, 0b00001, 0b00010, 0b00100, 0b01000, 0b10000, 0b10000, 0b10000, 0b11111, 0b11111],
    '3': [0b11110, 0b11110, 0b00001, 0b00001, 0b00001, 0b01110, 0b01110, 0b00001, 0b00001, 0b00001, 0b00001, 0b11110, 0b11110],
    '4': [0b00010, 0b00110, 0b01010, 0b10010, 0b10010, 0b10010, 0b11111, 0b11111, 0b00010, 0b00010, 0b00010, 0b00010, 0b00010],
    '5': [0b11111, 0b11111, 0b10000, 0b10000, 0b10000, 0b11110, 0b11110, 0b00001, 0b00001, 0b00001, 0b00001, 0b11110, 0b11110],
    '6': [0b00110, 0b01100, 0b10000, 0b10000, 0b10000, 0b11110, 0b11110, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110, 0b01110],
    '7': [0b11111, 0b11111, 0b00001, 0b00010, 0b00010, 0b00100, 0b00100, 0b01000, 0b01000, 0b01000, 0b01000, 0b01000, 0b01000],
    '8': [0b01110, 0b01110, 0b10001, 0b10001, 0b10001, 0b01110, 0b01110, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110, 0b01110],
    '9': [0b01110, 0b01110, 0b10001, 0b10001, 0b10001, 0b01111, 0b01111, 0b00001, 0b00001, 0b00001, 0b00010, 0b01100, 0b01100],
}

# Single centered colon, 2-row dots, matching the 13-row digits.
CLOCK_COLON = [0b000, 0b000, 0b010, 0b010, 0b000, 0b000, 0b000, 0b010, 0b010, 0b000, 0b000, 0b000, 0b000]
CLOCK_COLON_WIDTH = 3

def set_pixel(buf, x, y, brightness):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        val = max(0, min(255, int(brightness)))
        offset = (y * WIDTH + x) * BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

def send_frame(buf):
    try:
        with open(FB_SCREEN, "wb") as f:
            f.write(buf[:FRAME_SIZE])
            f.flush()
    except Exception:
        pass

def main():
    last_rendered = ""
    while True:
        now = time.strftime("%H:%M")
        if now != last_rendered:
            buf = bytearray(FRAME_SIZE)
            x_positions = [0, 6, 12, 15, 20]
            for char, x_start in zip(now, x_positions):
                if char == ':':
                    glyph = CLOCK_COLON
                    width = CLOCK_COLON_WIDTH
                else:
                    glyph = FONT.get(char, [0]*13)
                    width = 5
                for row_idx, row_bits in enumerate(glyph):
                    y = 1 + row_idx
                    for col_idx in range(width):
                        if (row_bits >> (width - 1 - col_idx)) & 1:
                            set_pixel(buf, x_start + col_idx, y, 200)
            send_frame(buf)
            last_rendered = now
        time.sleep(10)

if __name__ == "__main__":
    main()
