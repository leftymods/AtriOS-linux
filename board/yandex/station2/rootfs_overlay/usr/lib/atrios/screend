# Column start positions for "HH:MM" (digits: 5px, colon: 1px, spaces: 1px):
# Total: 5 + 1 + 5 + 1 + 1 + 1 + 5 + 1 + 5 = 25 columns
X_POSITIONS = [0, 6, 12, 14, 20]

def set_pixel(buf, x, y, brightness):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        val = max(0, min(255, int(brightness)))
        offset = (y * WIDTH + x) * BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

BT_GLYPH = [0b010, 0b110, 0b010, 0b110, 0b010]

def is_bt_active():
    try:
        if os.path.exists("/var/run/atrios/bt_active"):
            with open("/var/run/atrios/bt_active", "r") as f:
                return f.read().strip() == "1"
    except Exception:
        pass
    return False

def send_frame(buf):
    fb = get_fb_screen()
    try:
        with open(fb, "wb") as f:
            f.write(buf[:FRAME_SIZE])
            f.flush()
    except Exception:
        pass

def main():
    last_rendered = ""
    last_bt = None
    while True:
        now = time.strftime("%H:%M")
        bt = is_bt_active()
        if now != last_rendered or bt != last_bt:
            buf = bytearray(FRAME_SIZE)
            for char, x_start in zip(now, X_POSITIONS):
                glyph = FONT_LARGE_5X9.get(char, [0]*9)
                width = 1 if char == ':' else 5
                # Center vertically: 9 rows inside 16 -> start at y = 3 (rows 3..11)
                for row_idx, row_bits in enumerate(glyph):
                    y = 3 + row_idx
                    for col_idx in range(width):
                        if (row_bits >> (width - 1 - col_idx)) & 1:
                            set_pixel(buf, x_start + col_idx, y, 200)
            
            # In Bluetooth speaker mode, render the Bluetooth badge/indicator
            # Hidden in simple setup / normal clock mode
            if bt:
                for r_idx, bits in enumerate(BT_GLYPH):
                    for c_idx in range(3):
                        if (bits >> (2 - c_idx)) & 1:
                            set_pixel(buf, 21 + c_idx, r_idx, 200)

            send_frame(buf)
            last_rendered = now
            last_bt = bt
        time.sleep(1)

if __name__ == "__main__":
    main()
