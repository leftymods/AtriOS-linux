def local_command(text, wake_word):
    norm = re.sub(r"[^\w\s]", " ", text.lower().replace("\u0451", "\u0435"))
    norm = " ".join(norm.split())
    aliases = set(ATRI_WAKE_ALIASES + ALICE_WAKE_ALIASES)
    aliases.update(w.strip().lower() for w in wake_word.split(",") if w.strip())
    for word in sorted(aliases, key=len, reverse=True):
        if norm.startswith(word + " "):
            norm = norm[len(word):].strip()
            break
    fillers = {"please", "\u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430", "\u044d\u0439", "\u0441\u043b\u0443\u0448\u0430\u0439", "\u0434\u0430\u0432\u0430\u0439", "\u043d\u0443"}
    words = [word for word in norm.split() if word not in fillers]
    dedup = [word for i, word in enumerate(words) if i == 0 or word != words[i - 1]]
    candidates = {" ".join(words), " ".join(dedup)}
    return next((action for action, phrases in _DEVICE_COMMANDS.items() if candidates & phrases), None)


def send_phrase_to_server(server_url, pcm_bytes, wake_word=""):
    """Client-only HTTPS ASR -> chat -> TTS; no inbound port or WebSocket."""
    require_https(server_url)
    if len(pcm_bytes) > SR * 2 * 30 or len(pcm_bytes) % 2:
        raise ValueError("Invalid or oversized PCM16 phrase")
    cfg = load_config()
    headers = {}
    if cfg.get("token"):
        headers["Authorization"] = "Bearer " + str(cfg["token"])
    opts = {"headers": headers, "ca_file": cfg.get("ca_file") or None, "timeout": 25}
    base = server_url.rstrip("/")
    wav = io.BytesIO()
    with wave.open(wav, "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(SR)
        out.writeframes(pcm_bytes)
    try:
        raw_asr = _voice_call(lambda: request_bytes(base + "/asr", data=wav.getvalue(), headers={**headers, "Content-Type": "audio/wav", "Accept": "application/json"}, ca_file=opts["ca_file"], limit=65536, timeout=25))
        recognized = json.loads(raw_asr)
        if not isinstance(recognized, dict) or not isinstance(recognized.get("text"), str):
            raise ValueError("Invalid ASR response")
        text = recognized["text"].strip()
        if not text or (wake_word and not matches_wake_word(text, wake_word)):
            set_error("voice")
            return text, ""
        action = local_command(text, wake_word)
        if action:
            execute_device_command(action)
            set_error("voice")
            return text, ""
        set_vad_visual("thinking")
        response = _voice_call(lambda: request_json(base + "/chat", payload={"text": text}, **opts))
        answer = response.get("text", "")
        if not isinstance(answer, str) or not answer.strip():
            raise ValueError("Empty or invalid chat response")
        audio = _voice_call(lambda: request_bytes(base + "/tts", data=json.dumps({"text": answer, "emotion": response.get("emotion", "neutral")}).encode(), headers={**headers, "Content-Type": "application/json", "Accept": "audio/wav"}, ca_file=opts["ca_file"], limit=8*1024*1024, timeout=25))
        validate_wav(audio)
        write_status("speaking", last_asr=text, last_answer=answer)
        set_vad_visual("speaking")
        play_audio_bytes(audio)
        set_error("voice")
        return text, answer
    except InterruptedError:
        return "", ""
    except Exception as exc:
        set_error("voice", error_kind(exc, "server"), str(exc))
        raise
    finally:
        set_vad_visual("idle")


def playback_running():
    try:
        for p in glob.glob("/proc/asound/card*/pcm*p/sub*/status"):
            with open(p, "r") as f:
                if "RUNNING" in f.read():
                    return True
    except Exception:
        pass
    return False


def duck_volume(target=2):
    """Temporarily lower playback volume while the user speaks (never raises it)."""
    try:
        with open(VOLUME_FILE, "r", encoding="utf-8") as f:
            cur = int(f.read().strip())
    except Exception:
        return None
    if cur <= target:
        return None
    subprocess.Popen(["/usr/bin/atrios", "volume", str(target)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return cur


def restore_volume(orig):
    subprocess.Popen(["/usr/bin/atrios", "volume", str(int(orig))],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_daemon():
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    # Clear any stale button trigger or orphan arecord from before daemon startup/reboot.
    try:
        if os.path.exists(TRIGGER_FILE):
            os.unlink(TRIGGER_FILE)
    except Exception:
        pass
    try:
        subprocess.run(["pkill", "-9", "-f", "atri-aec"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["pkill", "-9", "-f", "arecord.*hw:0,3"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    cfg = load_config()
    if not cfg.get("enabled", False):
        write_status("disabled")
        print("[atriai] Disabled in config; exiting.", flush=True)
        return

    print(f"[atriai] Starting voice client -> {cfg['server']}", flush=True)
    write_status("listening")

    while True:
        cfg = load_config()
        if not cfg.get("enabled", False):
            write_status("disabled")
            break

        if is_mic_muted():
            write_status("muted")
            time.sleep(0.5)
            continue

        proc = None
        try:
            use_aec = os.path.exists(AEC_BIN)
            if use_aec:
                proc = subprocess.Popen([AEC_BIN], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            else:
                proc = subprocess.Popen(
                    ["arecord", "-q", "-D", "hw:0,3", "-t", "raw", "-f", "S32_LE", "-r", str(CAP_SR), "-c", str(CAP_CH)],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
            read_bytes = FRAME_BYTES if use_aec else CAP_FRAME_BYTES
            buf = bytearray()
            pre_roll = deque(maxlen=10)
            speaking = False
            speech_hits = 0
            warmup_frames = 20
            noise_floor = 200.0
            duck_orig = None
            force_active = False
            wait_speech_ms = 0.0
            silence_ms = 0.0
            frame_ms = (FRAME_SAMPLES / SR) * 1000.0
            vad_thr = float(cfg.get("vad_threshold", 650))
            max_sil = float(cfg.get("silence_ms", 600))
            min_bytes = int(SR * 2 * (float(cfg.get("min_speech_ms", 400)) / 1000.0))

            write_status("listening")
            while True:
                check_resume_visual()
                if is_mic_muted() or not load_config().get("enabled", False):
                    break
                if consume_button_trigger():
                    if force_active:
                        print("[atriai] funcbutton pressed again -> cancelled -> clock", flush=True)
                        force_active = False
                        speaking = False
                        speech_hits = 0
                        buf.clear()
                        set_vad_visual("idle")
                        break
                    force_active = True
                    speaking = False
                    speech_hits = 0
                    silence_ms = 0.0
                    wait_speech_ms = 0.0
                    buf.clear()
                    set_vad_visual("vad")
                    print("[atriai] funcbutton pressed -> listening without wake word (6s timeout)", flush=True)
                raw = proc.stdout.read(read_bytes)
                if not raw or len(raw) < read_bytes:
                    err_msg = ""
                    try:
                        proc.wait(timeout=0.5)
                        err_msg = proc.stderr.read().decode("utf-8", errors="ignore").strip()
                    except Exception:
                        pass
                    if err_msg:
                        print(f"[atriai] arecord stream ended ({err_msg}), retrying...", flush=True)
                    else:
                        print("[atriai] arecord stream ended, retrying...", flush=True)
                    time.sleep(1.0)
                    break
                chunk = raw if use_aec else downsample_48k_s32_8ch_to_16k_s16_mono(raw)
                if warmup_frames > 0:
                    warmup_frames -= 1
                    pre_roll.append(chunk)
                    continue
                rms = pcm16_rms(chunk)
                # Adaptive noise floor: falls fast, rises slowly (tracks music/TV level).
                if not speaking:
                    if rms < noise_floor:
                        noise_floor = noise_floor * 0.85 + rms * 0.15
                    else:
                        noise_floor = noise_floor * 0.995 + rms * 0.005
                music_on = playback_running()
                dyn_thr = noise_floor * (1.8 if music_on else 2.2) + 60.0
                dyn_thr = max(vad_thr * 0.6, min(dyn_thr, 6000.0))
                active_thr = min(dyn_thr, 350.0) if force_active else dyn_thr
                needed_hits = 2 if force_active else 4
                if rms >= active_thr:
                    speech_hits += 1
                    if not speaking and speech_hits >= needed_hits:
                        speaking = True
                        for prev in pre_roll:
                            buf.extend(prev)
                        pre_roll.clear()
                        if not force_active:
                            set_vad_visual("vad")
                    if speaking:
                        silence_ms = 0.0
                        buf.extend(chunk)
                        if len(buf) >= SR * 2 * 12:
                            break
                    else:
                        pre_roll.append(chunk)
                elif speaking:
                    speech_hits = 0
                    buf.extend(chunk)
                    silence_ms += frame_ms
                    if silence_ms >= max_sil:
                        break
                else:
                    speech_hits = 0
                    pre_roll.append(chunk)
                    if force_active:
                        wait_speech_ms += frame_ms
                        if wait_speech_ms >= 6000.0:
                            print("[atriai] funcbutton timeout (6s without speech) -> clock", flush=True)
                            break

            if proc is not None:
                try:
                    if proc.poll() is None:
                        proc.terminate()
                        proc.wait(timeout=0.5)
                except Exception:
                    pass
                try:
                    if proc.poll() is None:
                        proc.kill()
                        proc.wait(timeout=1.0)
                except Exception:
                    pass

            if duck_orig is not None:
                restore_volume(duck_orig)
                duck_orig = None

            if speaking and len(buf) >= min_bytes and not is_mic_muted():
                write_status("thinking")
                set_vad_visual("thinking")
                if force_active:
                    set_vad_visual("thinking")
                try:
                    ww = "" if force_active else cfg.get("wake_word", "")
                    asr, ans = send_phrase_to_server(cfg["server"], bytes(buf), wake_word=ww)
                    write_status("listening", last_asr=asr, last_answer=ans)
                except Exception as e:
                    write_status("error", error=str(e))
                    set_vad_visual("idle")
                    print(f"[atriai] server error: {e}", flush=True)
                    time.sleep(2.0)
            elif force_active:
                set_vad_visual("idle")
        except Exception as e:
            write_status("error", error=str(e))
            if proc:
                try:
                    proc.terminate()
                except Exception:
                    pass
            time.sleep(2.0)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "daemon":
        run_daemon()
    elif cmd == "enable":
        cfg = load_config()
        cfg["enabled"] = True
        save_config(cfg)
        print("AtriAI enabled.")
    elif cmd == "disable":
        cfg = load_config()
        cfg["enabled"] = False
        save_config(cfg)
        write_status("disabled")
        print("AtriAI disabled.")
    elif cmd == "server" and len(sys.argv) > 2:
        cfg = load_config()
        require_https(sys.argv[2])
        cfg["server"] = sys.argv[2].rstrip("/")
        save_config(cfg)
        print(f"AtriAI server set to {cfg['server']}")
    elif cmd == "wake" and len(sys.argv) > 2:
        cfg = load_config()
        ww = sys.argv[2].strip()
        cfg["wake_word"] = "" if ww.lower() in ("off", "none", "false") else ww
        save_config(cfg)
        print(f"AtriAI wake_word set to {cfg['wake_word'] or '(off)'}")
    elif cmd == "ask" and len(sys.argv) > 2:
        cfg = load_config()
        with open(sys.argv[2], "rb") as f:
            data = f.read()
        if data[:4] == b"RIFF" and len(data) > 44:
            with wave.open(io.BytesIO(data), "rb") as wav:
                if (wav.getnchannels(), wav.getsampwidth(), wav.getframerate()) != (1, 2, SR):
                    raise ValueError("WAV input must be 16 kHz mono PCM16")
                data = wav.readframes(wav.getnframes())
        asr, ans = send_phrase_to_server(cfg["server"], data, wake_word=cfg.get("wake_word", ""))
        print(json.dumps({"asr": asr, "answer": ans}, ensure_ascii=False))
    else:
        cfg = load_config()
        st = {}
        try:
            if os.path.exists(STATUS_FILE):
                with open(STATUS_FILE, "r") as f:
                    st = json.load(f)
        except Exception:
            pass
        print(json.dumps({"config": cfg, "status": st}, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
