#!/usr/bin/env python3
"""
AtriAI Thin-Client Runtime for AtriOS (Yandex Station 2 / Max)
Pure Python 3 stdlib implementation of the leftymods/AtriAI column protocol:
- Captures 16 kHz mono PCM16 via arecord
- Local RMS energy VAD (silence/speech segmentation, respects mic_muted)
- Streams audio to AtriAI server over WebSocket (/voice)
- Plays returned WAV response via aplay and logs ASR/route/answer events
"""

import base64
from collections import deque
import hashlib
import json
import math
import os
import re
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse

SR = 16000
CAP_SR = 48000
CAP_CH = 2
FRAME_SAMPLES = 512
FRAME_BYTES = FRAME_SAMPLES * 2
CAP_FRAME_BYTES = FRAME_SAMPLES * 3 * CAP_CH * 4  # 48kHz 2ch S32_LE -> 16kHz 1ch S16_LE
CONFIG_FILE = "/var/lib/atrios/ai.json"
STATUS_FILE = "/var/run/atrios/ai_status.json"
BUTTONS_FILE = "/var/run/atrios/buttons.json"
TRIGGER_FILE = "/var/run/atrios/ai_trigger"
PID_FILE = "/var/run/atrios/atriai.pid"
SCREEN_MODE_FILE = "/var/run/atrios/screen_mode"
RING_OVERRIDE_FILE = "/var/run/atrios/ring_override"

DEFAULT_CONFIG = {
    "enabled": False,
    "server": "ws://192.168.1.106:8090/voice",
    "wake_word": "Atri,Алиса",
    "vad_threshold": 420,
    "silence_ms": 600,
    "min_speech_ms": 400,
}

_button_triggered = False
_current_phase = "idle"
_current_ring_tag = "off"
_current_screen_tag = "clock"
_ring_proc = None


def _on_sigusr1(signum, frame):
    global _button_triggered
    _button_triggered = True


def _on_sigusr2(signum, frame):
    if _current_phase != "idle":
        set_vad_visual(_current_phase, force=True)


signal.signal(signal.SIGUSR1, _on_sigusr1)
signal.signal(signal.SIGUSR2, _on_sigusr2)


def consume_button_trigger():
    global _button_triggered
    hit = _button_triggered
    _button_triggered = False
    try:
        if os.path.exists(TRIGGER_FILE):
            os.unlink(TRIGGER_FILE)
            hit = True
    except Exception:
        pass
    return hit


def downsample_48k_s32_stereo_to_16k_s16_mono(raw_bytes):
    n_i32 = len(raw_bytes) // 4
    if n_i32 < 6:
        return b""
    samples = struct.unpack(f"<{n_i32}i", raw_bytes[:n_i32 * 4])
    mono16 = [max(-32768, min(32767, s >> 11)) for s in samples[::6]]
    return struct.pack(f"<{len(mono16)}h", *mono16)

ATRI_WAKE_ALIASES = (
    "atri",
    "атри",
    "атря",
    "атрия",
    "atria",
    "этри",
    "а три",
    "о три",
)

ALICE_WAKE_ALIASES = (
    "алиса",
    "алису",
    "алисе",
    "алисой",
    "alice",
)


def matches_wake_word(text, wake_word):
    ww = (wake_word or "").strip().lower()
    if not ww or ww in ("off", "none", "false"):
        return True
    norm = re.sub(r"[^\w\s]", " ", (text or "").lower().replace("ё", "е"))
    norm = re.sub(r"\s+", " ", norm).strip()
    if not norm:
        return False
    tokens = [t.strip() for t in ww.split(",") if t.strip()]
    candidates = set(tokens)
    if "atri" in candidates or "атри" in candidates:
        candidates.update(ATRI_WAKE_ALIASES)
    if "алиса" in candidates or "alice" in candidates:
        candidates.update(ALICE_WAKE_ALIASES)
    return any(c in norm for c in candidates)


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                cfg.update(data)
    except Exception:
        pass
    return cfg


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_FILE)


def write_status(state, last_asr="", last_answer="", error=""):
    try:
        os.makedirs(os.path.dirname(STATUS_FILE), exist_ok=True)
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({
                "state": state,
                "last_asr": last_asr,
                "last_answer": last_answer,
                "error": error,
                "updated_at": int(time.time()),
            }, f)
        os.replace(tmp, STATUS_FILE)
    except Exception:
        pass


def is_mic_muted():
    try:
        if os.path.exists(BUTTONS_FILE):
            with open(BUTTONS_FILE, "r") as f:
                return bool(json.load(f).get("mic_muted", False))
    except Exception:
        pass
    return False


def pcm16_rms(chunk):
    count = len(chunk) // 2
    if count <= 0:
        return 0.0
    samples = struct.unpack(f"<{count}h", chunk[:count * 2])
    s = sum(x * x for x in samples)
    return math.sqrt(s / count)


class SimpleWebSocket:
    """Minimal RFC 6455 WebSocket client using Python stdlib sockets."""

    def __init__(self, url, timeout=15.0):
        u = urllib.parse.urlparse(url)
        if u.scheme not in ("ws", "wss"):
            raise ValueError(f"Unsupported scheme: {u.scheme}")
        host = u.hostname
        port = u.port or (443 if u.scheme == "wss" else 80)
        path = u.path or "/"
        if u.query:
            path += "?" + u.query

        raw = socket.create_connection((host, port), timeout=timeout)
        if u.scheme == "wss":
            import ssl
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        self.sock = raw
        self.sock.settimeout(timeout)

        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            f"Upgrade: websocket\r\n"
            f"Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(req.encode())

        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(1024)
            if not chunk:
                raise ConnectionError("WebSocket handshake failed")
            buf += chunk
        header = buf.split(b"\r\n\r\n", 1)[0].decode(errors="ignore")
        if "101 " not in header.splitlines()[0]:
            raise ConnectionError(f"WebSocket rejected: {header.splitlines()[0]}")
        self._extra = buf.split(b"\r\n\r\n", 1)[1]

    def _recv_exact(self, n):
        out = bytearray()
        if self._extra:
            take = min(n, len(self._extra))
            out.extend(self._extra[:take])
            self._extra = self._extra[take:]
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise EOFError("WebSocket closed")
            out.extend(chunk)
        return bytes(out)

    def send_frame(self, opcode, payload):
        mask = os.urandom(4)
        length = len(payload)
        header = bytearray([0x80 | opcode])
        if length < 126:
            header.append(0x80 | length)
        elif length < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", length))
        header.extend(mask)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header) + masked)

    def send_json(self, obj):
        self.send_frame(0x1, json.dumps(obj).encode("utf-8"))

    def send_bytes(self, data):
        self.send_frame(0x2, data)

    def recv_frame(self):
        while True:
            b1, b2 = self._recv_exact(2)
            opcode = b1 & 0x0F
            masked = (b2 & 0x80) != 0
            length = b2 & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._recv_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._recv_exact(8))[0]
            mask = self._recv_exact(4) if masked else None
            payload = self._recv_exact(length)
            if masked and mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:  # close
                return 0x8, b""
            if opcode == 0x9:  # ping -> pong
                self.send_frame(0xA, payload)
                continue
            if opcode == 0xA:  # pong
                continue
            return opcode, payload

    def close(self):
        try:
            self.send_frame(0x8, b"")
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


def _write_screen_mode(mode):
    try:
        os.makedirs(os.path.dirname(SCREEN_MODE_FILE), exist_ok=True)
        with open(SCREEN_MODE_FILE, "w") as f:
            f.write(mode)
    except Exception:
        pass


def set_vad_visual(phase, force=False):
    """Trigger non-blocking LED ring & mini-screen animation for VAD/assistant phases."""
    global _current_phase, _current_ring_tag, _current_screen_tag, _ring_proc
    _current_phase = phase

    if phase == "vad":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "thinking":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "speaking":
        ring_tag = "amber_green"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber_green", "60"]
        screen_tag = "eyes_happy"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "happy"]
        _write_screen_mode("ai")
    else:
        ring_tag = "off"
        ring_cmd = ["/usr/bin/atrios", "ring", "off"]
        screen_tag = "clock"
        screen_cmd = ["/usr/bin/atrios", "screen", "clock"]
        _write_screen_mode("clock")

    volume_override = os.path.exists(RING_OVERRIDE_FILE)
    ring_alive = (_ring_proc is not None and _ring_proc.poll() is None)

    if not volume_override and (force or ring_tag != _current_ring_tag or (ring_tag != "off" and not ring_alive)):
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light ring"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            _ring_proc = subprocess.Popen(ring_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            _ring_proc = None
        _current_ring_tag = ring_tag

    if force or screen_tag != _current_screen_tag:
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light screen"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            subprocess.Popen(screen_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        _current_screen_tag = screen_tag


def play_audio_bytes(audio_bytes, sample_rate=48000):
    if not audio_bytes:
        return
    is_wav = audio_bytes[:4] == b"RIFF"
    suffix = ".wav" if is_wav else ".pcm"
    with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tf:
        tf.write(audio_bytes)
        path = tf.name
    try:
        if is_wav:
            cmd = ["aplay", "-q", path]
        else:
            cmd = ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(int(sample_rate)), "-c", "1", path]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    finally:
        try:
            os.unlink(path)
        except Exception:
            pass


def send_phrase_to_server(server_url, pcm_bytes, wake_word=""):
    ws = SimpleWebSocket(server_url, timeout=20.0)
    last_asr = ""
    last_answer = ""
    audio = bytearray()
    audio_sr = 48000
    try:
        start_msg = {"type": "start", "sample_rate": SR, "format": "pcm16", "lang": "ru"}
        if wake_word:
            start_msg["wake_word"] = wake_word
        ws.send_json(start_msg)
        ws.send_bytes(pcm_bytes)
        ws.send_json({"type": "end"})

        while True:
            opcode, payload = ws.recv_frame()
            if opcode == 0x8:
                break
            if opcode == 0x1:
                ev = json.loads(payload.decode("utf-8", errors="ignore"))
                kind = ev.get("type")
                if kind == "asr":
                    last_asr = ev.get("text", "")
                    print(f"[atriai] asr: {last_asr}", flush=True)
                    if not last_asr.strip():
                        break
                    if wake_word and not matches_wake_word(last_asr, wake_word):
                        break
                elif kind == "answer":
                    last_answer = ev.get("text", "")
                    print(f"[atriai] answer: {last_answer}", flush=True)
                    if not last_asr.strip():
                        break
                elif kind == "audio_start":
                    audio_sr = int(ev.get("sample_rate", 48000))
                elif kind == "audio_end":
                    break
            elif opcode == 0x2:
                audio.extend(payload)
    finally:
        ws.close()

    if wake_word and not matches_wake_word(last_asr, wake_word):
        print(f"[atriai] ignored (no wake word '{wake_word}'): {last_asr}", flush=True)
        set_vad_visual("idle")
        return last_asr, ""

    if audio:
        write_status("speaking", last_asr=last_asr, last_answer=last_answer)
        set_vad_visual("speaking")
        play_audio_bytes(bytes(audio), sample_rate=audio_sr)
    set_vad_visual("idle")
    return last_asr, last_answer


def run_daemon():
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    cfg = load_config()
    if not cfg.get("enabled", False):
        write_status("disabled")
        print("[atriai] Disabled in config; exiting.", flush=True)
        return

    print(f"[atriai] Starting voice client -> {cfg['server']}", flush=True)
    write_status("listening")

    while True:
        cfg = load_config()
        if not cfg.get("enabled", False):
            write_status("disabled")
            break

        if is_mic_muted():
            write_status("muted")
            time.sleep(0.5)
            continue

        proc = None
        try:
            proc = subprocess.Popen(
                ["arecord", "-q", "-D", "hw:0,3", "-t", "raw", "-f", "S32_LE", "-r", str(CAP_SR), "-c", str(CAP_CH)],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            buf = bytearray()
            pre_roll = deque(maxlen=10)
            speaking = False
            speech_hits = 0
            force_active = False
            wait_speech_ms = 0.0
            silence_ms = 0.0
            frame_ms = (FRAME_SAMPLES / SR) * 1000.0
            vad_thr = float(cfg.get("vad_threshold", 420))
            max_sil = float(cfg.get("silence_ms", 600))
            min_bytes = int(SR * 2 * (float(cfg.get("min_speech_ms", 400)) / 1000.0))

            write_status("listening")
            while True:
                if is_mic_muted() or not load_config().get("enabled", False):
                    break
                if consume_button_trigger():
                    force_active = True
                    wait_speech_ms = 0.0
                    set_vad_visual("vad")
                    print("[atriai] funcbutton pressed -> listening without wake word (5s timeout)", flush=True)
                raw = proc.stdout.read(CAP_FRAME_BYTES)
                if not raw or len(raw) < CAP_FRAME_BYTES:
                    print("[atriai] arecord stream ended, retrying...", flush=True)
                    time.sleep(1.0)
                    break
                chunk = downsample_48k_s32_stereo_to_16k_s16_mono(raw)
                rms = pcm16_rms(chunk)
                if rms >= vad_thr:
                    speech_hits += 1
                    if not speaking and speech_hits >= 2:
                        speaking = True
                        for prev in pre_roll:
                            buf.extend(prev)
                        pre_roll.clear()
                        if not force_active:
                            set_vad_visual("vad")
                    if speaking:
                        silence_ms = 0.0
                        buf.extend(chunk)
                    else:
                        pre_roll.append(chunk)
                elif speaking:
                    speech_hits = 0
                    buf.extend(chunk)
                    silence_ms += frame_ms
                    if silence_ms >= max_sil:
                        break
                else:
                    speech_hits = 0
                    pre_roll.append(chunk)
                    if force_active:
                        wait_speech_ms += frame_ms
                        if wait_speech_ms >= 5000.0:
                            print("[atriai] funcbutton timeout (5s without speech) -> clock", flush=True)
                            break

            try:
                proc.terminate()
                proc.wait(timeout=1)
            except Exception:
                pass

            if speaking and len(buf) >= min_bytes:
                write_status("thinking")
                set_vad_visual("thinking")
                try:
                    ww = "" if force_active else cfg.get("wake_word", "")
                    asr, ans = send_phrase_to_server(cfg["server"], bytes(buf), wake_word=ww)
                    write_status("listening", last_asr=asr, last_answer=ans)
                except Exception as e:
                    write_status("error", error=str(e))
                    set_vad_visual("idle")
                    print(f"[atriai] server error: {e}", flush=True)
                    time.sleep(2.0)
            elif speaking or force_active:
                set_vad_visual("idle")
        except Exception as e:
            write_status("error", error=str(e))
            if proc:
                try:
                    proc.terminate()
                except Exception:
                    pass
            time.sleep(2.0)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "daemon":
        run_daemon()
    elif cmd == "enable":
        cfg = load_config()
        cfg["enabled"] = True
        save_config(cfg)
        print("AtriAI enabled.")
    elif cmd == "disable":
        cfg = load_config()
        cfg["enabled"] = False
        save_config(cfg)
        write_status("disabled")
        print("AtriAI disabled.")
    elif cmd == "server" and len(sys.argv) > 2:
        cfg = load_config()
        cfg["server"] = sys.argv[2]
        save_config(cfg)
        print(f"AtriAI server set to {cfg['server']}")
    elif cmd == "wake" and len(sys.argv) > 2:
        cfg = load_config()
        ww = sys.argv[2].strip()
        cfg["wake_word"] = "" if ww.lower() in ("off", "none", "false") else ww
        save_config(cfg)
        print(f"AtriAI wake_word set to {cfg['wake_word'] or '(off)'}")
    elif cmd == "ask" and len(sys.argv) > 2:
        cfg = load_config()
        with open(sys.argv[2], "rb") as f:
            data = f.read()
        if data[:4] == b"RIFF" and len(data) > 44:
            data = data[44:]
        asr, ans = send_phrase_to_server(cfg["server"], data, wake_word=cfg.get("wake_word", ""))
        print(json.dumps({"asr": asr, "answer": ans}, ensure_ascii=False))
    else:
        cfg = load_config()
        st = {}
        try:
            if os.path.exists(STATUS_FILE):
                with open(STATUS_FILE, "r") as f:
                    st = json.load(f)
        except Exception:
            pass
        print(json.dumps({"config": cfg, "status": st}, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
