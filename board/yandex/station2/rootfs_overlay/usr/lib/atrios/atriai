def set_vad_visual(phase, force=False):
    """Trigger non-blocking LED ring & mini-screen animation for VAD/assistant phases."""
    global _current_phase, _current_ring_tag, _current_screen_tag, _ring_proc
    _current_phase = phase

    if phase == "vad":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "thinking":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "speaking":
        ring_tag = "amber_green"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber_green", "60"]
        screen_tag = "eyes_happy"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "happy"]
        _write_screen_mode("ai")
    else:
        ring_tag = "off"
        ring_cmd = ["/usr/bin/atrios", "ring", "off"]
        screen_tag = "clock"
        screen_cmd = ["/usr/bin/atrios", "screen", "clock"]
        _write_screen_mode("clock")

    _write_ring_mode(ring_tag)
    volume_override = os.path.exists(RING_OVERRIDE_FILE)
    ring_alive = (_ring_proc is not None and _ring_proc.poll() is None)

    if not volume_override and (force or ring_tag != _current_ring_tag or (ring_tag != "off" and not ring_alive)):
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light ring"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            _ring_proc = subprocess.Popen(ring_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            _ring_proc = None
        _current_ring_tag = ring_tag

    if force or screen_tag != _current_screen_tag:
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light screen"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            subprocess.Popen(screen_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        _current_screen_tag = screen_tag


def play_audio_bytes(audio_bytes, sample_rate=48000):
    if not audio_bytes:
        return
    is_wav = audio_bytes[:4] == b"RIFF"
    suffix = ".wav" if is_wav else ".pcm"
    with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tf:
        tf.write(audio_bytes)
        path = tf.name
    proc = None
    try:
        if is_wav:
            cmd = ["aplay", "-q", path]
        else:
            cmd = ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(int(sample_rate)), "-c", "1", path]
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        while proc.poll() is None:
            check_resume_visual()
            if consume_button_trigger():
                print("[atriai] funcbutton pressed during playback -> cancelled -> clock", flush=True)
                proc.terminate()
                break
            time.sleep(0.05)
        if proc.returncode and proc.returncode != -15:
            err = proc.stderr.read().decode("utf-8", errors="replace").strip() if proc.stderr else ""
            print(f"[atriai] aplay rc={proc.returncode} err={err}", flush=True)
    finally:
        if proc and proc.poll() is None:
            try:
                proc.kill()
            except Exception:
                pass
        try:
            os.unlink(path)
        except Exception:
            pass


BT_CMD_SOCK = "/var/run/atrios/bt_cmd.sock"
VOLUME_FILE = "/var/lib/atrios/volume"


def send_bt_cmd(cmd):
    if not os.path.exists(BT_CMD_SOCK):
        print(f"[atriai] bt_cmd socket missing: {BT_CMD_SOCK}", flush=True)
        return False
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(cmd.encode("ascii"), BT_CMD_SOCK)
        return True
    except Exception as e:
        print(f"[atriai] bt_cmd '{cmd}' error: {e}", flush=True)
        return False
    finally:
        sock.close()


def adjust_volume(delta):
    cur = 10
    try:
        with open(VOLUME_FILE, "r", encoding="utf-8") as f:
            cur = int(f.read().strip())
    except Exception:
        pass
    nxt = max(0, min(100, cur + delta))
    subprocess.run(["/usr/bin/atrios", "volume", str(nxt)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"[atriai] volume: {cur}% -> {nxt}%", flush=True)


def _tone_pcm16(freq_hz, dur_ms, amp=5500, sr=48000):
    n = max(1, int(sr * dur_ms / 1000.0))
    fade = max(1, min(n // 4, int(sr * 0.010)))
    samples = array.array("h")
    two_pi_f = 2.0 * math.pi * freq_hz / sr
    for i in range(n):
        env = 1.0
        if i < fade:
            env = i / fade
        elif i >= n - fade:
            env = (n - 1 - i) / fade
        samples.append(int(amp * env * math.sin(two_pi_f * i)))
    return samples.tobytes()


def play_command_chime(action):
    patterns = {
        "volume_up": [(523.25, 55), (659.25, 80)],
        "volume_down": [(659.25, 55), (523.25, 80)],
        "next_track": [(587.33, 50), (880.00, 75)],
        "prev_track": [(880.00, 50), (587.33, 75)],
        "pause": [(440.00, 85)],
        "play": [(440.00, 50), (554.37, 75)],
    }
    notes = patterns.get(action, [(587.33, 70)])
    pcm = bytearray()
    gap = b"\x00" * (int(48000 * 0.018) * 2)
    for idx, (freq, ms) in enumerate(notes):
        if idx > 0:
            pcm.extend(gap)
        pcm.extend(_tone_pcm16(freq, ms))
    try:
        subprocess.run(
            ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", "48000", "-c", "1"],
            input=bytes(pcm),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2.0,
        )
    except Exception:
        pass


def execute_device_command(action):
    bt_map = {
        "next_track": "next",
        "prev_track": "prev",
        "pause": "pause",
        "play": "play",
    }
    if action in bt_map:
        send_bt_cmd(bt_map[action])
    elif action == "volume_up":
        adjust_volume(5)
    elif action == "volume_down":
        adjust_volume(-5)
    play_command_chime(action)


def send_phrase_to_server(server_url, pcm_bytes, wake_word=""):
    ws = SimpleWebSocket(server_url, timeout=25.0)
    last_asr = ""
    last_answer = ""
    audio = bytearray()
    audio_sr = 48000
    cancelled = False
    command_received = False
    try:
        start_msg = {"type": "start", "sample_rate": SR, "format": "pcm16", "lang": "ru"}
        if wake_word:
            start_msg["wake_word"] = wake_word
        ws.send_json(start_msg)
        ws.send_bytes(pcm_bytes)
        ws.send_json({"type": "end"})

        while True:
            opcode, payload = ws.recv_frame(poll_cancel=consume_button_trigger, total_timeout=25.0)
            if opcode is None:
                cancelled = True
                print("[atriai] funcbutton pressed during server request -> cancelled -> clock", flush=True)
                try:
                    ws.send_json({"type": "barge_in"})
                except Exception:
                    pass
                break
            if opcode == 0x8:
                break
            if opcode == 0x1:
                ev = json.loads(payload.decode("utf-8", errors="ignore"))
                kind = ev.get("type")
                if kind == "command":
                    action = ev.get("action", "")
                    if action:
                        command_received = True
                        print(f"[atriai] command: {action}", flush=True)
                        execute_device_command(action)
                elif kind == "asr":
                    last_asr = ev.get("text", "")
                    print(f"[atriai] asr: {last_asr}", flush=True)
                    if not last_asr.strip():
                        break
                    if wake_word and not command_received and not matches_wake_word(last_asr, wake_word):
                        break
                    if wake_word or command_received:
                        set_vad_visual("thinking")
                elif kind == "answer":
                    last_answer = ev.get("text", "")
                    print(f"[atriai] answer: {last_answer}", flush=True)
                    if not last_asr.strip():
                        break
                elif kind == "audio_start":
                    audio_sr = int(ev.get("sample_rate", 48000))
                elif kind == "audio_end":
                    break
            elif opcode == 0x2:
                audio.extend(payload)
    finally:
        ws.close()

    if cancelled:
        set_vad_visual("idle")
        return "", ""

    if wake_word and not command_received and not matches_wake_word(last_asr, wake_word):
        print(f"[atriai] ignored (no wake word '{wake_word}'): {last_asr}", flush=True)
        set_vad_visual("idle")
        return last_asr, ""

    if audio:
        print(f"[atriai] playing audio: {len(audio)} bytes @ {audio_sr} Hz", flush=True)
        write_status("speaking", last_asr=last_asr, last_answer=last_answer)
        set_vad_visual("speaking")
        play_audio_bytes(bytes(audio), sample_rate=audio_sr)
    elif not command_received:
        print(f"[atriai] no audio bytes received for answer: {last_answer}", flush=True)
    set_vad_visual("idle")
    return last_asr, last_answer


def playback_running():
    try:
        for p in glob.glob("/proc/asound/card*/pcm*p/sub*/status"):
            with open(p, "r") as f:
                if "RUNNING" in f.read():
                    return True
    except Exception:
        pass
    return False


def duck_volume(target=2):
    """Temporarily lower playback volume while the user speaks (never raises it)."""
    try:
        with open(VOLUME_FILE, "r", encoding="utf-8") as f:
            cur = int(f.read().strip())
    except Exception:
        return None
    if cur <= target:
        return None
    subprocess.Popen(["/usr/bin/atrios", "volume", str(target)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return cur


def restore_volume(orig):
    subprocess.Popen(["/usr/bin/atrios", "volume", str(int(orig))],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_daemon():
    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    # Clear any stale button trigger or orphan arecord from before daemon startup/reboot.
    try:
        if os.path.exists(TRIGGER_FILE):
            os.unlink(TRIGGER_FILE)
    except Exception:
        pass
    try:
        subprocess.run(["pkill", "-9", "-f", "atri-aec"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["pkill", "-9", "-f", "arecord.*hw:0,3"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    cfg = load_config()
    if not cfg.get("enabled", False):
        write_status("disabled")
        print("[atriai] Disabled in config; exiting.", flush=True)
        return

    print(f"[atriai] Starting voice client -> {cfg['server']}", flush=True)
    write_status("listening")

    while True:
        cfg = load_config()
        if not cfg.get("enabled", False):
            write_status("disabled")
            break

        if is_mic_muted():
            write_status("muted")
            time.sleep(0.5)
            continue

        proc = None
        try:
            use_aec = os.path.exists(AEC_BIN)
            if use_aec:
                proc = subprocess.Popen([AEC_BIN], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            else:
                proc = subprocess.Popen(
                    ["arecord", "-q", "-D", "hw:0,3", "-t", "raw", "-f", "S32_LE", "-r", str(CAP_SR), "-c", str(CAP_CH)],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
            read_bytes = FRAME_BYTES if use_aec else CAP_FRAME_BYTES
            buf = bytearray()
            pre_roll = deque(maxlen=10)
            speaking = False
            speech_hits = 0
            warmup_frames = 20
            noise_floor = 200.0
            duck_orig = None
            force_active = False
            wait_speech_ms = 0.0
            silence_ms = 0.0
            frame_ms = (FRAME_SAMPLES / SR) * 1000.0
            vad_thr = float(cfg.get("vad_threshold", 650))
            max_sil = float(cfg.get("silence_ms", 600))
            min_bytes = int(SR * 2 * (float(cfg.get("min_speech_ms", 400)) / 1000.0))

            write_status("listening")
            while True:
                check_resume_visual()
                if is_mic_muted() or not load_config().get("enabled", False):
                    break
                if consume_button_trigger():
                    if force_active:
                        print("[atriai] funcbutton pressed again -> cancelled -> clock", flush=True)
                        force_active = False
                        speaking = False
                        speech_hits = 0
                        buf.clear()
                        set_vad_visual("idle")
                        break
                    force_active = True
                    speaking = False
                    speech_hits = 0
                    silence_ms = 0.0
                    wait_speech_ms = 0.0
                    buf.clear()
                    set_vad_visual("vad")
                    print("[atriai] funcbutton pressed -> listening without wake word (6s timeout)", flush=True)
                raw = proc.stdout.read(read_bytes)
                if not raw or len(raw) < read_bytes:
                    err_msg = ""
                    try:
                        proc.wait(timeout=0.5)
                        err_msg = proc.stderr.read().decode("utf-8", errors="ignore").strip()
                    except Exception:
                        pass
                    if err_msg:
                        print(f"[atriai] arecord stream ended ({err_msg}), retrying...", flush=True)
                    else:
                        print("[atriai] arecord stream ended, retrying...", flush=True)
                    time.sleep(1.0)
                    break
                chunk = raw if use_aec else downsample_48k_s32_8ch_to_16k_s16_mono(raw)
                if warmup_frames > 0:
                    warmup_frames -= 1
                    pre_roll.append(chunk)
                    continue
                rms = pcm16_rms(chunk)
                # Adaptive noise floor: falls fast, rises slowly (tracks music/TV level).
                if not speaking:
                    if rms < noise_floor:
                        noise_floor = noise_floor * 0.85 + rms * 0.15
                    else:
                        noise_floor = noise_floor * 0.995 + rms * 0.005
                music_on = playback_running()
                dyn_thr = noise_floor * (1.8 if music_on else 2.2) + 60.0
                dyn_thr = max(vad_thr * 0.6, min(dyn_thr, 6000.0))
                active_thr = min(dyn_thr, 350.0) if force_active else dyn_thr
                needed_hits = 2 if force_active else 4
                if rms >= active_thr:
                    speech_hits += 1
                    if not speaking and speech_hits >= needed_hits:
                        speaking = True
                        for prev in pre_roll:
                            buf.extend(prev)
                        pre_roll.clear()
                        if not force_active:
                            set_vad_visual("vad")
                    if speaking:
                        silence_ms = 0.0
                        buf.extend(chunk)
                        if len(buf) >= SR * 2 * 12:
                            break
                    else:
                        pre_roll.append(chunk)
                elif speaking:
                    speech_hits = 0
                    buf.extend(chunk)
                    silence_ms += frame_ms
                    if silence_ms >= max_sil:
                        break
                else:
                    speech_hits = 0
                    pre_roll.append(chunk)
                    if force_active:
                        wait_speech_ms += frame_ms
                        if wait_speech_ms >= 6000.0:
                            print("[atriai] funcbutton timeout (6s without speech) -> clock", flush=True)
                            break

            if proc is not None:
                try:
                    if proc.poll() is None:
                        proc.terminate()
                        proc.wait(timeout=0.5)
                except Exception:
                    pass
                try:
                    if proc.poll() is None:
                        proc.kill()
                        proc.wait(timeout=1.0)
                except Exception:
                    pass

            if duck_orig is not None:
                restore_volume(duck_orig)
                duck_orig = None

            if speaking and len(buf) >= min_bytes:
                write_status("thinking")
                set_vad_visual("thinking")
                if force_active:
                    set_vad_visual("thinking")
                try:
                    ww = "" if force_active else cfg.get("wake_word", "")
                    asr, ans = send_phrase_to_server(cfg["server"], bytes(buf), wake_word=ww)
                    write_status("listening", last_asr=asr, last_answer=ans)
                except Exception as e:
                    write_status("error", error=str(e))
                    set_vad_visual("idle")
                    print(f"[atriai] server error: {e}", flush=True)
                    time.sleep(2.0)
            elif force_active:
                set_vad_visual("idle")
        except Exception as e:
            write_status("error", error=str(e))
            if proc:
                try:
                    proc.terminate()
                except Exception:
                    pass
            time.sleep(2.0)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "daemon":
        run_daemon()
    elif cmd == "enable":
        cfg = load_config()
        cfg["enabled"] = True
        save_config(cfg)
        print("AtriAI enabled.")
    elif cmd == "disable":
        cfg = load_config()
        cfg["enabled"] = False
        save_config(cfg)
        write_status("disabled")
        print("AtriAI disabled.")
    elif cmd == "server" and len(sys.argv) > 2:
        cfg = load_config()
        cfg["server"] = sys.argv[2]
        save_config(cfg)
        print(f"AtriAI server set to {cfg['server']}")
    elif cmd == "wake" and len(sys.argv) > 2:
        cfg = load_config()
        ww = sys.argv[2].strip()
        cfg["wake_word"] = "" if ww.lower() in ("off", "none", "false") else ww
        save_config(cfg)
        print(f"AtriAI wake_word set to {cfg['wake_word'] or '(off)'}")
    elif cmd == "ask" and len(sys.argv) > 2:
        cfg = load_config()
        with open(sys.argv[2], "rb") as f:
            data = f.read()
        if data[:4] == b"RIFF" and len(data) > 44:
            data = data[44:]
        asr, ans = send_phrase_to_server(cfg["server"], data, wake_word=cfg.get("wake_word", ""))
        print(json.dumps({"asr": asr, "answer": ans}, ensure_ascii=False))
    else:
        cfg = load_config()
        st = {}
        try:
            if os.path.exists(STATUS_FILE):
                with open(STATUS_FILE, "r") as f:
                    st = json.load(f)
        except Exception:
            pass
        print(json.dumps({"config": cfg, "status": st}, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
