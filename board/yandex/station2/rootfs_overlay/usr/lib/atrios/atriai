def consume_button_trigger():
    global _button_triggered
    hit = _button_triggered
    _button_triggered = False
    try:
        if os.path.exists(TRIGGER_FILE):
            os.unlink(TRIGGER_FILE)
            hit = True
    except Exception:
        pass
    return hit


def downsample_48k_s32_8ch_to_16k_s16_mono(raw_bytes):
    n_i32 = (len(raw_bytes) // 4)
    stride = CAP_CH * 3  # 8ch * 3 (48kHz -> 16kHz) = 24 int32s per output sample
    if n_i32 < stride:
        return b""
    samples = array.array("i", raw_bytes[:n_i32 * 4])
    out = array.array("h")
    limit = n_i32 - CAP_CH + 1
    for i in range(0, limit, stride):
        s = (
            samples[i] + samples[i + 1] + samples[i + 2] + samples[i + 3]
            + samples[i + 4] + samples[i + 5] + samples[i + 6] + samples[i + 7]
        ) >> 14
        if s > 32767:
            s = 32767
        elif s < -32768:
            s = -32768
        out.append(s)
    return out.tobytes()

ATRI_WAKE_ALIASES = (
    "atri",
    "атри",
    "атря",
    "атрия",
    "atria",
    "этри",
    "а три",
    "о три",
)

ALICE_WAKE_ALIASES = (
    "алиса",
    "алису",
    "алисе",
    "алисой",
    "alice",
)


def matches_wake_word(text, wake_word):
    ww = (wake_word or "").strip().lower()
    if not ww or ww in ("off", "none", "false"):
        return True
    norm = re.sub(r"[^\w\s]", " ", (text or "").lower().replace("ё", "е"))
    norm = re.sub(r"\s+", " ", norm).strip()
    if not norm:
        return False
    tokens = [t.strip() for t in ww.split(",") if t.strip()]
    candidates = set(tokens)
    if "atri" in candidates or "атри" in candidates:
        candidates.update(ATRI_WAKE_ALIASES)
    if "алиса" in candidates or "alice" in candidates:
        candidates.update(ALICE_WAKE_ALIASES)
    return any(c in norm for c in candidates)


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                cfg.update(data)
    except Exception:
        pass
    return cfg


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_FILE)


def write_status(state, last_asr="", last_answer="", error=""):
    try:
        os.makedirs(os.path.dirname(STATUS_FILE), exist_ok=True)
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({
                "state": state,
                "last_asr": last_asr,
                "last_answer": last_answer,
                "error": error,
                "updated_at": int(time.time()),
            }, f)
        os.replace(tmp, STATUS_FILE)
    except Exception:
        pass


def is_mic_muted():
    try:
        if os.path.exists(BUTTONS_FILE):
            with open(BUTTONS_FILE, "r") as f:
                return bool(json.load(f).get("mic_muted", False))
    except Exception:
        pass
    return False


def pcm16_rms(chunk):
    count = len(chunk) // 2
    if count <= 0:
        return 0.0
    samples = struct.unpack(f"<{count}h", chunk[:count * 2])
    s = sum(x * x for x in samples)
    return math.sqrt(s / count)


class SimpleWebSocket:
    """Minimal RFC 6455 WebSocket client using Python stdlib sockets."""

    def __init__(self, url, timeout=15.0):
        u = urllib.parse.urlparse(url)
        if u.scheme not in ("ws", "wss"):
            raise ValueError(f"Unsupported scheme: {u.scheme}")
        host = u.hostname
        port = u.port or (443 if u.scheme == "wss" else 80)
        path = u.path or "/"
        if u.query:
            path += "?" + u.query

        raw = socket.create_connection((host, port), timeout=timeout)
        if u.scheme == "wss":
            import ssl
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        self.sock = raw
        self.sock.settimeout(timeout)

        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            f"Upgrade: websocket\r\n"
            f"Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(req.encode())

        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(1024)
            if not chunk:
                raise ConnectionError("WebSocket handshake failed")
            buf += chunk
        header = buf.split(b"\r\n\r\n", 1)[0].decode(errors="ignore")
        if "101 " not in header.splitlines()[0]:
            raise ConnectionError(f"WebSocket rejected: {header.splitlines()[0]}")
        self._extra = buf.split(b"\r\n\r\n", 1)[1]

    def _recv_exact(self, n):
        out = bytearray()
        if self._extra:
            take = min(n, len(self._extra))
            out.extend(self._extra[:take])
            self._extra = self._extra[take:]
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise EOFError("WebSocket closed")
            out.extend(chunk)
        return bytes(out)

    def send_frame(self, opcode, payload):
        mask = os.urandom(4)
        length = len(payload)
        header = bytearray([0x80 | opcode])
        if length < 126:
            header.append(0x80 | length)
        elif length < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", length))
        header.extend(mask)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header) + masked)

    def send_json(self, obj):
        self.send_frame(0x1, json.dumps(obj).encode("utf-8"))

    def send_bytes(self, data):
        self.send_frame(0x2, data)

    def recv_frame(self, poll_cancel=None, total_timeout=25.0):
        deadline = time.time() + total_timeout
        self.sock.settimeout(0.2)
        while True:
            if poll_cancel and poll_cancel():
                return None, None
            if time.time() > deadline:
                raise TimeoutError("timed out")
            try:
                b1, b2 = self._recv_exact(2)
            except socket.timeout:
                continue
            opcode = b1 & 0x0F
            masked = (b2 & 0x80) != 0
            length = b2 & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._recv_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._recv_exact(8))[0]
            mask = self._recv_exact(4) if masked else None
            payload = self._recv_exact(length)
            if masked and mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:  # close
                return 0x8, b""
            if opcode == 0x9:  # ping -> pong
                self.send_frame(0xA, payload)
                continue
            if opcode == 0xA:  # pong
                continue
            return opcode, payload

    def close(self):
        try:
            self.send_frame(0x8, b"")
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


