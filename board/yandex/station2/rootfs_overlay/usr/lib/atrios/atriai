def set_vad_visual(phase, force=False):
    """Trigger non-blocking LED ring & mini-screen animation for VAD/assistant phases."""
    global _current_phase, _current_ring_tag, _current_screen_tag, _ring_proc
    _current_phase = phase

    if phase == "vad":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "thinking":
        ring_tag = "amber"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber", "30"]
        screen_tag = "eyes_open"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "open"]
        _write_screen_mode("ai")
    elif phase == "speaking":
        ring_tag = "amber_green"
        ring_cmd = ["/usr/bin/atrios", "ring", "amber_green", "60"]
        screen_tag = "eyes_happy"
        screen_cmd = ["/usr/bin/atrios", "screen", "eyes", "happy"]
        _write_screen_mode("ai")
    else:
        ring_tag = "off"
        ring_cmd = ["/usr/bin/atrios", "ring", "off"]
        screen_tag = "clock"
        screen_cmd = ["/usr/bin/atrios", "screen", "clock"]
        _write_screen_mode("clock")

    _write_ring_mode(ring_tag)
    volume_override = os.path.exists(RING_OVERRIDE_FILE)
    ring_alive = (_ring_proc is not None and _ring_proc.poll() is None)

    if not volume_override and (force or ring_tag != _current_ring_tag or (ring_tag != "off" and not ring_alive)):
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light ring"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            _ring_proc = subprocess.Popen(ring_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            _ring_proc = None
        _current_ring_tag = ring_tag

    if force or screen_tag != _current_screen_tag:
        try:
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light screen"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        try:
            subprocess.Popen(screen_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        _current_screen_tag = screen_tag


def validate_wav(data):
    if len(data) > 8 * 1024 * 1024:
        raise ValueError("TTS WAV exceeds size limit")
    try:
        with wave.open(io.BytesIO(data), "rb") as wav:
            channels, width, rate, frames = wav.getnchannels(), wav.getsampwidth(), wav.getframerate(), wav.getnframes()
            if channels not in (1, 2) or width != 2 or not 8000 <= rate <= 96000 or not 0 < frames <= rate * 120:
                raise ValueError("Unsupported TTS WAV parameters")
            if len(wav.readframes(frames)) != channels * width * frames:
                raise ValueError("Truncated TTS WAV")
    except (wave.Error, EOFError) as exc:
        raise ValueError("Invalid TTS WAV") from exc


def play_audio_bytes(audio_bytes, sample_rate=48000):
    if not audio_bytes:
        return
    is_wav = audio_bytes[:4] == b"RIFF"
    if is_wav:
        validate_wav(audio_bytes)
    suffix = ".wav" if is_wav else ".pcm"
    with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tf:
        tf.write(audio_bytes)
        path = tf.name
    proc = None
    try:
        if is_wav:
            cmd = ["aplay", "-q", path]
        else:
            cmd = ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(int(sample_rate)), "-c", "1", path]
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        while proc.poll() is None:
            check_resume_visual()
            if consume_button_trigger():
                print("[atriai] funcbutton pressed during playback -> cancelled -> clock", flush=True)
                proc.terminate()
                break
            time.sleep(0.05)
        if proc.returncode and proc.returncode != -15:
            err = proc.stderr.read().decode("utf-8", errors="replace").strip() if proc.stderr else ""
            set_error("audio", "audio", err or "Audio playback failed")
            raise RuntimeError(f"aplay rc={proc.returncode}: {err}")
        set_error("audio")
    finally:
        if proc and proc.poll() is None:
            try:
                proc.kill()
            except Exception:
                pass
        try:
            os.unlink(path)
        except Exception:
            pass


BT_CMD_SOCK = "/var/run/atrios/bt_cmd.sock"
VOLUME_FILE = "/var/lib/atrios/volume"


def send_bt_cmd(cmd):
    if not os.path.exists(BT_CMD_SOCK):
        print(f"[atriai] bt_cmd socket missing: {BT_CMD_SOCK}", flush=True)
        return False
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(cmd.encode("ascii"), BT_CMD_SOCK)
        return True
    except Exception as e:
        print(f"[atriai] bt_cmd '{cmd}' error: {e}", flush=True)
        return False
    finally:
        sock.close()


def adjust_volume(delta):
    cur = 10
    try:
        with open(VOLUME_FILE, "r", encoding="utf-8") as f:
            cur = int(f.read().strip())
    except Exception:
        pass
    nxt = max(0, min(100, cur + delta))
    subprocess.run(["/usr/bin/atrios", "volume", str(nxt)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"[atriai] volume: {cur}% -> {nxt}%", flush=True)


def _tone_pcm16(freq_hz, dur_ms, amp=5500, sr=48000):
    n = max(1, int(sr * dur_ms / 1000.0))
    fade = max(1, min(n // 4, int(sr * 0.010)))
    samples = array.array("h")
    two_pi_f = 2.0 * math.pi * freq_hz / sr
    for i in range(n):
        env = 1.0
        if i < fade:
            env = i / fade
        elif i >= n - fade:
            env = (n - 1 - i) / fade
        samples.append(int(amp * env * math.sin(two_pi_f * i)))
    return samples.tobytes()


def play_command_chime(action):
    patterns = {
        "volume_up": [(523.25, 55), (659.25, 80)],
        "volume_down": [(659.25, 55), (523.25, 80)],
        "next_track": [(587.33, 50), (880.00, 75)],
        "prev_track": [(880.00, 50), (587.33, 75)],
        "pause": [(440.00, 85)],
        "play": [(440.00, 50), (554.37, 75)],
    }
    notes = patterns.get(action, [(587.33, 70)])
    pcm = bytearray()
    gap = b"\x00" * (int(48000 * 0.018) * 2)
    for idx, (freq, ms) in enumerate(notes):
        if idx > 0:
            pcm.extend(gap)
        pcm.extend(_tone_pcm16(freq, ms))
    try:
        subprocess.run(
            ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", "48000", "-c", "1"],
            input=bytes(pcm),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2.0,
        )
    except Exception:
        pass


def execute_device_command(action):
    bt_map = {
        "next_track": "next",
        "prev_track": "prev",
        "pause": "pause",
        "play": "play",
    }
    if action in bt_map:
        send_bt_cmd(bt_map[action])
    elif action == "volume_up":
        adjust_volume(5)
    elif action == "volume_down":
        adjust_volume(-5)
    play_command_chime(action)


def _voice_call(call):
    """Keep physical cancel/mute responsive during a bounded HTTPS operation."""
    result = queue.Queue(maxsize=1)
    def work():
        try:
            result.put((True, call()))
        except Exception as exc:
            result.put((False, exc))
    # One request at a time, including a cancelled request awaiting its timeout.
    if not _voice_slot.acquire(blocking=False):
        raise RuntimeError("Previous HTTPS request is still finishing; retry shortly")
    def guarded():
        try:
            work()
        finally:
            _voice_slot.release()
    threading.Thread(target=guarded, daemon=True).start()
    deadline = time.monotonic() + 26
    while True:
        if time.monotonic() > deadline:
            raise TimeoutError("HTTPS voice request deadline exceeded")
        if consume_button_trigger() or is_mic_muted():
            raise InterruptedError("Voice request cancelled")
        try:
            ok, value = result.get(timeout=0.05)
        except queue.Empty:
            check_resume_visual()
            continue
        if not ok:
            raise value
        return value


