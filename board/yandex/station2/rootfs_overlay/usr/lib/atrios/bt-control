#!/usr/bin/env python3
"""
AtriOS Bluetooth Remote Control Daemon (bt-control)
Listens on Bluetooth RFCOMM Serial Port Profile (SPP channel 1, UUID 00001101-0000-1000-8000-00805F9B34FB).
Enables direct peer-to-peer control from the Android Companion App over Bluetooth:
- Real-time telemetry (CPU temp, RAM, Uptime, Wi-Fi, audio)
- Acoustic volume control (0..100%)
- LED Ring & Front Screen modes
- Over-the-air Wi-Fi provisioning via Bluetooth
- Remote diagnostic chime & reboot
"""

import glob
import os
import re
import sys
import time
import json
import socket
import select
import subprocess
import threading
from atrios_status import get_errors, active_error

RFCOMM_PORT = 1
MAX_CLIENTS = 4
MAX_LINE_BYTES = 8192
IDLE_TIMEOUT = 300
_client_slots = threading.BoundedSemaphore(MAX_CLIENTS)
_screen_lock = threading.Lock()
_screen_generation = 0
VOLUME_FILE = "/var/lib/atrios/volume"
BT_PAIRED_FILE = "/var/lib/atrios/bt_paired"
BT_PAIR_UNTIL_FILE = "/var/run/atrios-bt-pair-until"
BUTTONS_STATE_FILE = "/var/run/atrios/buttons.json"
SCREEN_MODE_FILE = "/var/run/atrios/screen_mode"
AI_CONFIG_FILE = "/var/lib/atrios/ai.json"
AI_STATUS_FILE = "/var/run/atrios/ai_status.json"
DEVICE_FILE = "/etc/atrios-device"
FB_RING = "/dev/fb5"
FB_SCREEN = "/dev/fb0"

def read_device_meta():
    meta = {
        "name": "AtriStation Max",
        "codename": "station-max",
        "rev": "rev1.0",
        "os": "AtriOS Nebula",
        "fw_version": "1.0",
    }
    try:
        if os.path.exists(DEVICE_FILE):
            with open(DEVICE_FILE, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("DEVICE_NAME="):
                        meta["name"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["name"]
                    elif line.startswith("DEVICE_CODENAME="):
                        meta["codename"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["codename"]
                    elif line.startswith("DEVICE_REV="):
                        meta["rev"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["rev"]
    except Exception:
        pass
    try:
        if os.path.exists("/etc/os-release"):
            with open("/etc/os-release", "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("PRETTY_NAME="):
                        meta["os"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["os"]
                    elif line.startswith("VERSION="):
                        meta["fw_version"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["fw_version"]
    except Exception:
        pass
    try:
        if os.path.exists("/etc/atrios-version"):
            with open("/etc/atrios-version", "r", encoding="utf-8", errors="ignore") as f:
                v = f.read().strip()
                if v:
                    meta["fw_version"] = v
    except Exception:
        pass
    return meta

def get_lux():
    try:
        for path in glob.glob("/sys/bus/iio/devices/iio:device*/in_illuminance_raw") + glob.glob("/sys/bus/iio/devices/iio:device*/in_illuminance_input"):
            with open(path, "r") as f:
                return int(float(f.read().strip()))
    except Exception:
        pass
    return None

def get_bt_privacy():
    paired = []
    try:
        if os.path.exists(BT_PAIRED_FILE):
            with open(BT_PAIRED_FILE, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    mac = line.strip()
                    if re.match(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$", mac):
                        paired.append(mac.upper())
    except Exception:
        pass

    pair_remaining = 0
    try:
        if os.path.exists(BT_PAIR_UNTIL_FILE):
            with open(BT_PAIR_UNTIL_FILE, "r") as f:
                rem = int(f.read().strip()) - int(time.time())
            if rem > 0:
                pair_remaining = rem
    except Exception:
        pass

    discoverable = False
    try:
        out = subprocess.check_output(["hciconfig", "hci0"], timeout=2).decode("utf-8", errors="ignore")
        discoverable = "ISCAN" in out
    except Exception:
        pass

    return {
        "discoverable": discoverable,
        "hidden": bool(paired) and not discoverable and pair_remaining == 0,
        "paired_devices": paired,
        "pair_remaining_sec": pair_remaining,
    }

def get_cpu_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp", "r") as f:
            return round(int(f.read().strip()) / 1000.0, 1)
    except Exception:
        return 0.0

def get_uptime_sec():
    try:
        with open("/proc/uptime", "r") as f:
            return int(float(f.readline().split()[0]))
    except Exception:
        return 0

def get_mem_info():
    try:
        total, free = 0, 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1]) // 1024
                elif line.startswith("MemAvailable:"):
                    free = int(line.split()[1]) // 1024
        return {"total_mb": total, "free_mb": free, "used_mb": max(0, total - free)}
    except Exception:
        return {"total_mb": 2048, "free_mb": 1800, "used_mb": 248}

def get_wifi_info():
    ip, ssid = "", ""
    try:
        out = subprocess.check_output(["ip", "-4", "addr", "show", "wlan0"], timeout=2).decode('utf-8', errors='ignore')
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("inet "):
                ip = line.split()[1].split('/')[0]
                break
    except Exception:
        pass
    try:
        out = subprocess.check_output(["iw", "dev", "wlan0", "link"], timeout=2).decode('utf-8', errors='ignore')
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("SSID:"):
                ssid = line.split(":", 1)[1].strip()
                break
    except Exception:
        pass
    return {"ip": ip, "ssid": ssid, "connected": bool(ip)}

def get_current_volume():
    try:
        if os.path.exists(VOLUME_FILE):
            with open(VOLUME_FILE, "r") as f:
                return max(0, min(100, int(f.read().strip())))
    except Exception:
        pass
    return 60

def set_system_volume(pct):
    pct = max(0, min(100, int(pct)))
    try:
        os.makedirs(os.path.dirname(VOLUME_FILE), exist_ok=True)
        tmp = f"{VOLUME_FILE}.tmp"
        with open(tmp, "w") as f:
            f.write(f"{pct}\n")
        os.replace(tmp, VOLUME_FILE)
    except Exception:
        pass
    # Trigger rotaryd / bt-volume-sync to update ALSA faders and iPhone slider
    try:
        subprocess.Popen(["/usr/lib/atrios/audio", "volume", str(pct)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def is_bt_speaker_mode():
    try:
        out = subprocess.check_output(
            ["gdbus", "call", "--system", "--dest", "org.bluealsa",
             "--object-path", "/org/bluealsa", "--method", "org.freedesktop.DBus.ObjectManager.GetManagedObjects"],
            timeout=1
        ).decode('utf-8', errors='ignore')
        return "'Running': <true>" in out or "a2dpsnk" in out
    except Exception:
        return False

def get_ai_info():
    info = {
        "enabled": False,
        "server": "https://192.168.1.106:8090",
        "wake_word": "Atri",
        "state": "disabled",
        "last_asr": "",
        "last_answer": "",
        "error": "",
    }
    try:
        if os.path.exists(AI_CONFIG_FILE):
            with open(AI_CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            info["enabled"] = bool(cfg.get("enabled", False))
            info["server"] = str(cfg.get("server", info["server"]))
            info["wake_word"] = str(cfg.get("wake_word", info["wake_word"]))
    except Exception:
        pass
    try:
        if os.path.exists(AI_STATUS_FILE):
            with open(AI_STATUS_FILE, "r", encoding="utf-8") as f:
                st = json.load(f)
            info["state"] = str(st.get("state", "idle" if info["enabled"] else "disabled"))
            info["last_asr"] = str(st.get("last_asr", ""))
            info["last_answer"] = str(st.get("last_answer", ""))
            info["error"] = str(st.get("error", ""))
    except Exception:
        pass
    return info

def get_buttons_state():
    state = {"action_pressed": False, "mic_muted": False}
    try:
        if os.path.exists(BUTTONS_STATE_FILE):
            with open(BUTTONS_STATE_FILE, "r") as f:
                data = json.load(f)
            state["action_pressed"] = bool(data.get("action_pressed", False))
            state["mic_muted"] = bool(data.get("mic_muted", False))
    except Exception:
        pass
    return state

def get_screen_mode():
    try:
        if os.path.exists(SCREEN_MODE_FILE):
            with open(SCREEN_MODE_FILE, "r") as f:
                m = f.read().strip()
                if m:
                    return m
    except Exception:
        pass
    return "clock"

def set_screen_mode(mode):
    try:
        os.makedirs(os.path.dirname(SCREEN_MODE_FILE), exist_ok=True)
        with open(SCREEN_MODE_FILE, "w") as f:
            f.write(str(mode))
    except Exception:
        pass

def build_status_payload():
    vol = get_current_volume()
    meta = read_device_meta()
    bt_priv = get_bt_privacy()
    try:
        time.tzset()
    except Exception:
        pass
    tz_path = os.path.realpath("/etc/localtime") if os.path.exists("/etc/localtime") else ""
    tz_name = tz_path.split("zoneinfo/")[-1] if "zoneinfo/" in tz_path else "UTC"
    return {
        "errors": get_errors(),
        "type": "status",
        "device": {
            "model": meta["name"],
            "codename": meta["codename"],
            "rev": meta["rev"],
            "soc": "Amlogic S905X3 (SM1) quad Cortex-A55",
            "arch": os.uname().machine,
            "os": meta["os"],
            "fw_version": meta["fw_version"],
            "kernel": os.uname().release,
            "uptime_seconds": get_uptime_sec(),
            "local_time": time.strftime("%Y-%m-%d %H:%M:%S %Z"),
            "timezone": tz_name,
            "cpu_temperature": get_cpu_temp(),
            "lux": get_lux(),
            "memory": get_mem_info()
        },
        "audio": {
            "volume": vol,
            "mute": (vol == 0),
            "card": "AML-AUGESOUND",
            "speakers": "Silergy SY6045S (Woofer 30W + Tweeters 2x10W, 20V PVDD)"
        },
        "wifi": get_wifi_info(),
        "buttons": get_buttons_state(),
        "screen_mode": get_screen_mode(),
        "ai": get_ai_info(),
        "bluetooth": {
            "adapter": "hci0",
            "name": meta["name"],
            "transport": "RFCOMM SPP (Channel 1)",
            "is_speaker_mode": is_bt_speaker_mode(),
            "discoverable": bt_priv["discoverable"],
            "hidden": bt_priv["hidden"],
            "paired_devices": bt_priv["paired_devices"],
            "pair_remaining_sec": bt_priv["pair_remaining_sec"]
        }
    }

def authorized_client(client_info):
    mac = str(client_info[0]).upper()
    privacy = get_bt_privacy()
    return mac in privacy["paired_devices"] or privacy["pair_remaining_sec"] > 0


def handle_client(client_sock, client_info):
    try:
        _handle_client(client_sock, client_info)
    finally:
        client_sock.close()


def _client_session(client_sock, client_info):
    try:
        handle_client(client_sock, client_info)
    finally:
        _client_slots.release()


def finish_ticker(generation):
    with _screen_lock:
        if generation == _screen_generation and get_screen_mode() == "ticker":
            set_screen_mode("clock")


def _handle_client(client_sock, client_info):
    print(f"[bt-control] Client connected via Bluetooth RFCOMM: {client_info}")
    # Register SDP service just in case
    try:
        subprocess.run(["sdptool", "add", "SP"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # Send initial status packet immediately upon connect
    try:
        init_pkt = json.dumps(build_status_payload()) + "\n"
        client_sock.sendall(init_pkt.encode('utf-8'))
    except Exception:
        return

    buf = bytearray()
    last_input = time.monotonic()
    client_sock.settimeout(0.5)

    last_heartbeat = time.time()
    last_volume = get_current_volume()
    last_buttons = get_buttons_state()

    while True:
        if time.monotonic() - last_input > IDLE_TIMEOUT:
            break
        # Check incoming Bluetooth data
        try:
            data = client_sock.recv(1024)
            if not data:
                break
            last_input = time.monotonic()
            buf.extend(data)
            if len(buf) > MAX_LINE_BYTES:
                raise ValueError("Bluetooth command exceeds size limit")
            while b"\n" in buf:
                raw, _, remainder = buf.partition(b"\n")
                buf = bytearray(remainder)
                line = raw.decode("utf-8").strip()
                if not line:
                    continue
                try:
                    cmd_obj = json.loads(line)
                    response = process_command(cmd_obj)
                    if response:
                        resp_pkt = json.dumps(response) + "\n"
                        client_sock.sendall(resp_pkt.encode('utf-8'))
                except Exception as e:
                    err_pkt = json.dumps({"type": "error", "message": str(e)}) + "\n"
                    client_sock.sendall(err_pkt.encode('utf-8'))
        except socket.timeout:
            pass
        except Exception:
            break

        # Push volume changes automatically if changed locally by knob or iPhone
        now = time.time()
        cur_vol = get_current_volume()
        if cur_vol != last_volume:
            last_volume = cur_vol
            try:
                push_pkt = json.dumps({"type": "volume_change", "volume": cur_vol, "mute": cur_vol == 0}) + "\n"
                client_sock.sendall(push_pkt.encode('utf-8'))
            except Exception:
                break

        cur_buttons = get_buttons_state()
        if cur_buttons != last_buttons:
            last_buttons = cur_buttons
            try:
                btn_pkt = json.dumps({"type": "buttons_change", **cur_buttons}) + "\n"
                client_sock.sendall(btn_pkt.encode('utf-8'))
            except Exception:
                break

        # Periodic status refresh push every 4 seconds
        if now - last_heartbeat >= 4.0:
            last_heartbeat = now
            try:
                hb_pkt = json.dumps(build_status_payload()) + "\n"
                client_sock.sendall(hb_pkt.encode('utf-8'))
            except Exception:
                break

    try:
        client_sock.close()
    except Exception:
        pass
    print(f"[bt-control] Client disconnected: {client_info}")

def process_command(cmd_obj):
    global _screen_generation
    if not isinstance(cmd_obj, dict):
        raise ValueError("Command must be a JSON object")
    cmd = cmd_obj.get("cmd") or cmd_obj.get("type")

    if cmd in ("get_status", "status"):
        return build_status_payload()

    elif cmd in ("set_volume", "volume"):
        vol = cmd_obj.get("value", cmd_obj.get("volume", None))
        if vol is not None:
            set_system_volume(int(vol))
            return {"type": "volume_response", "success": True, "volume": get_current_volume()}

    elif cmd in ("set_mute", "mute"):
        is_mute = cmd_obj.get("value", cmd_obj.get("mute", True))
        if is_mute:
            set_system_volume(0)
        else:
            set_system_volume(50)
        return {"type": "mute_response", "success": True, "mute": (get_current_volume() == 0)}

    elif cmd == "audio_test":
        subprocess.Popen(["/usr/lib/atrios/audio", "test"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"type": "action_response", "success": True, "message": "Audio chime triggered"}

    elif cmd == "sync_time":
        subprocess.run(["/usr/bin/atrios", "time", "sync"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        return build_status_payload()

    elif cmd == "reboot":
        def do_reboot():
            time.sleep(1)
            os.system("reboot")
        threading.Thread(target=do_reboot, daemon=True).start()
        return {"type": "action_response", "success": True, "message": "Rebooting in 1s"}

    elif cmd == "set_screen":
        mode = str(cmd_obj.get("mode", "clock"))
        if mode not in ("clock", "ticker", "eyes", "kisser", "off"):
            raise ValueError("Unsupported screen mode")
        with _screen_lock:
            _screen_generation += 1
            generation = _screen_generation
            subprocess.run(["pkill", "-f", "/usr/lib/atrios/light screen"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            set_screen_mode(mode)
            if mode == "ticker":
                text = str(cmd_obj.get("text", "AtriOS"))[:512]
                proc = subprocess.Popen(["/usr/bin/atrios", "screen", "ticker", text],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                def wait_ticker():
                    proc.wait()
                    finish_ticker(generation)
                threading.Thread(target=wait_ticker, daemon=True).start()
            elif mode == "eyes":
                state = str(cmd_obj.get("state", "happy"))
                subprocess.Popen(["/usr/bin/atrios", "screen", "eyes", state],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif mode in ("kisser", "off"):
                subprocess.Popen(["/usr/bin/atrios", "screen", mode],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # For "clock", screend immediately renders the 5x9 font once screen_mode == "clock"
        return build_status_payload()

    elif cmd == "set_ring":
        if active_error() or get_buttons_state()["mic_muted"] or os.path.exists("/var/run/atrios/ring_override"):
            return {"type": "action_response", "success": False, "message": "Ring is displaying an error, microphone mute or volume"}
        mode = str(cmd_obj.get("mode", "off"))
        subprocess.run(["pkill", "-f", "/usr/lib/atrios/light ring"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if mode == "volume":
            subprocess.Popen(["/usr/bin/atrios", "ring", "volume", str(get_current_volume())],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif mode in ("rainbow", "amber", "amber_green", "red", "blue", "green", "off"):
            try:
                os.makedirs("/var/run/atrios", exist_ok=True)
                with open("/var/run/atrios/ring_mode", "w") as rf:
                    rf.write(mode)
            except Exception:
                pass
            cmd_args = ["/usr/bin/atrios", "ring", mode]
            if mode in ("amber", "amber_green"):
                cmd_args.append("0")
            subprocess.Popen(cmd_args,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"type": "action_response", "success": True, "message": f"Ring: {mode}"}

    elif cmd == "set_ai":
        if "server" in cmd_obj and str(cmd_obj.get("server", "")).strip():
            subprocess.run(["/usr/bin/atrios", "ai", "server", str(cmd_obj["server"]).strip()],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        if "wake_word" in cmd_obj:
            ww = str(cmd_obj.get("wake_word", "")).strip() or "off"
            subprocess.run(["/usr/bin/atrios", "ai", "wake", ww],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        if "enabled" in cmd_obj:
            en = bool(cmd_obj["enabled"])
            subprocess.run(["/usr/bin/atrios", "ai", "enable" if en else "disable"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            subprocess.Popen(["/etc/init.d/S80atriai", "restart" if en else "stop"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return build_status_payload()

    elif cmd == "bt_pair":
        secs = max(10, min(300, int(cmd_obj.get("seconds", 60))))
        subprocess.run(["/usr/bin/atrios", "bt", "pair", str(secs)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        return build_status_payload()

    elif cmd == "bt_hide":
        subprocess.run(["/usr/bin/atrios", "bt", "hide"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        return build_status_payload()

    elif cmd == "bt_unpair":
        mac = str(cmd_obj.get("mac", "all"))
        subprocess.run(["/usr/bin/atrios", "bt", "unpair", mac],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        return build_status_payload()

    elif cmd == "wifi_connect":
        ssid = cmd_obj.get("ssid", "")
        psk = cmd_obj.get("psk", "")
        if ssid:
            subprocess.Popen(["/usr/lib/atrios/wireless", "wifi", "connect", ssid, psk],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return {"type": "action_response", "success": True, "message": f"Connecting to {ssid}..."}

    raise ValueError("Unknown command: " + str(cmd))

def run_server():
    # Make sure SDP service is registered in BlueZ
    try:
        subprocess.run(["sdptool", "add", "SP"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    server_sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # Linux UAPI BT_SECURITY_MEDIUM: encrypted/authenticated RFCOMM link.
    server_sock.setsockopt(getattr(socket, "SOL_BLUETOOTH", 274), 4, bytes((2, 0)))
    server_sock.bind(("00:00:00:00:00:00", RFCOMM_PORT))
    server_sock.listen(MAX_CLIENTS)

    print(f"[bt-control] Listening for Android App connections on Bluetooth RFCOMM channel {RFCOMM_PORT}...")

    while True:
        try:
            client_sock, client_info = server_sock.accept()
            if not authorized_client(client_info) or not _client_slots.acquire(blocking=False):
                client_sock.close()
                continue
            try:
                client_thread = threading.Thread(target=_client_session, args=(client_sock, client_info), daemon=True)
                client_thread.start()
            except BaseException:
                client_sock.close()
                _client_slots.release()
                raise
        except KeyboardInterrupt:
            break
        except Exception as e:
            time.sleep(1)

    server_sock.close()

if __name__ == "__main__":
    run_server()
