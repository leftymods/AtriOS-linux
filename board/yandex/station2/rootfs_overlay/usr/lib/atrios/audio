#!/bin/sh
# AtriOS Unified Audio & Amplifier Management Utility (atrios-audio)
# Controls:
#   - AMLAUGESOUND hardware sound card (TDM-B Lane 0 -> SY6045S & ES8156)
#   - Silergy SY6045S Woofer (2-002b) and Tweeters (2-002a) amplifiers
#   - Everest ES8156 Headphone DAC (3.5mm jack, 2-0008)
#   - 8-channel Everest ES7210 microphone array (2-0040, 2-0043)

ACTION="${1:-test}"
CARD="AMLAUGESOUND"
STATE_DIR="/var/lib/atrios"
STATE_FILE="$STATE_DIR/volume"
DEFAULT_VOLUME=60
export XDG_RUNTIME_DIR="/var/run/pipewire"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/var/run/dbus/system_bus_socket"

# Perceptual 0..100 -> ALSA raw curve.  zero_db_raw is 255 for the
# SY6045S speaker masters and 191 for the ES8156 headphone DAC (255 would
# be +32 dB on the headphone).  At 40% the speaker level is about -22 dB,
# which is clearly audible; the old linear raw=pct*2.55 gave -76 dB.
volume_raw() {
    awk -v p="$1" -v z="$2" 'BEGIN {
        if (p <= 0) { print 1; exit }
        db = -60 * (1 - sqrt(p / 100));
        r = int(z + 2 * db + 0.5);
        if (r < 1) r = 1;
        if (r > z) r = z;
        print r;
    }'
}

read_state_pct() {
    pct=""
    [ -f "$STATE_FILE" ] && pct=$(tr -dc '0-9' < "$STATE_FILE" 2>/dev/null)
    case "$pct" in
        ''|*[!0-9]*) pct=$DEFAULT_VOLUME ;;
    esac
    [ "$pct" -gt 100 ] && pct=100
    echo "$pct"
}

write_state_pct() {
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$1" > "$STATE_FILE.tmp" 2>/dev/null && \
        mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null || true
}

apply_volume() {
    pct="$1"
    raw=$(volume_raw "$pct" 255)
    raw_hp=$(volume_raw "$pct" 191)
    sw=1
    if [ "$pct" -le 0 ]; then
        sw=0
    fi
    for c in "$CARD" 0; do
        amixer -c "$c" cset name='Woofer Master Playback Volume' "$raw" 2>/dev/null || true
        amixer -c "$c" cset name='Tweeters Master Playback Volume' "$raw" 2>/dev/null || true
        amixer -c "$c" cset name='Headphone DAC Playback Volume' "$raw_hp" 2>/dev/null || true
        amixer -c "$c" cset name='Woofer Master Playback Switch' "$sw" 2>/dev/null || true
        amixer -c "$c" cset name='Tweeters Master Playback Switch' "$sw" 2>/dev/null || true
        amixer -c "$c" cset name='Headphone Headphone Switch' "$sw" 2>/dev/null || true
        amixer -c "$c" cset name='SPK mute' 0 2>/dev/null || true
    done
}

case "$ACTION" in
  check|check-audio|audit|diag)
    shift
    CHECK_SCRIPT="/usr/lib/atrios/check_audio.sh"
    if [ ! -f "$CHECK_SCRIPT" ]; then
      CHECK_SCRIPT="$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)/check_audio.sh"
    fi
    exec /bin/sh "$CHECK_SCRIPT" "$@"
    ;;

  test)
    echo "=========================================================="
    echo "          AtriOS Unified Audio & Mic Diagnostic           "
    echo "=========================================================="
    # Step 0: Run automated audio subsystem diagnostics suite
    CHECK_SCRIPT="/usr/lib/atrios/check_audio.sh"
    if [ ! -f "$CHECK_SCRIPT" ]; then
      CHECK_SCRIPT="$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)/check_audio.sh"
    fi
    if [ -x "$CHECK_SCRIPT" ]; then
      echo "[Diagnostics]: Running automated hardware & ALSA check..."
      "$CHECK_SCRIPT" --verbose || exit $?
      echo ""
    fi

    echo "[ALSA Sound Cards]:"
    cat /proc/asound/cards 2>/dev/null || echo "No cards found"
    echo ""
    echo "[Hardware Amplifiers (Silergy SY6045S)]:"
    if [ -d /sys/bus/i2c/drivers/sy6045s ]; then
      for inst in /sys/bus/i2c/drivers/sy6045s/2-00*; do
        if [ -d "$inst" ]; then
          bname=$(basename "$inst")
          fw=$(cat "$inst/settings_file" 2>/dev/null || echo "N/A")
          echo "  * Instance $bname: Registered (firmware: $fw)"
        fi
      done
    else
      echo "  * SY6045S driver not loaded"
    fi
    echo ""
    echo "[Amplifier Re-Init]: Applying 0dB hardware unmute..."
    /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
    echo ""
    echo "[Playback Test]: Playing test music on speakers / headphone jack..."
    WAV=""
    for f in /root/music/*.wav \
             /usr/share/sounds/atrios/test-music.wav \
             /usr/share/sounds/alsa/Front_Center.wav; do
      if [ -f "$f" ]; then
        WAV="$f"
        break
      fi
    done
    PLAY_OK=0
    if command -v pw-play >/dev/null 2>&1 && pidof pipewire >/dev/null 2>&1 && [ -n "$WAV" ]; then
      echo "  * pw-play $WAV"
      pw-play "$WAV" 2>/dev/null && PLAY_OK=1
    fi
    if [ "$PLAY_OK" -eq 0 ]; then
      # Temporarily stop PipeWire if it holds hw:AMLAUGESOUND,0 exclusively
      PW_WAS_RUNNING=0
      if pidof pipewire >/dev/null 2>&1; then
        PW_WAS_RUNNING=1
        /etc/init.d/S50pipewire stop >/dev/null 2>&1 || killall wireplumber pipewire 2>/dev/null || true
        usleep 200000 2>/dev/null || sleep 1
      fi
      /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
      if command -v aplay >/dev/null 2>&1 && [ -n "$WAV" ]; then
        aplay -D default "$WAV" 2>/dev/null || \
        aplay -D "plughw:$CARD,0" "$WAV" 2>/dev/null || true
      elif command -v speaker-test >/dev/null 2>&1; then
        speaker-test -D default -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null || \
        speaker-test -D "plughw:$CARD,0" -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null || \
        speaker-test -D "hw:$CARD,0" -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null || true
      fi
      if [ "$PW_WAS_RUNNING" -eq 1 ]; then
        /etc/init.d/S50pipewire start >/dev/null 2>&1 || true
      fi
    fi
    echo ""
    echo "[Microphone Test]: Recording 3 seconds from 8-ch mic array..."
    REC_FILE="/tmp/atrios_mic_test.wav"
    rm -f "$REC_FILE"
    if command -v arecord >/dev/null 2>&1; then
      MIC_OK=0
      # Device map of this ASoC card: 0 = TDM-B multicodec (real ES7210
      # loopback/ADC), 1 = PDM, 2 = SPDIF-B, 3 = TDM-C (HDMI/I2S out).
      # Device 0 carries the microphone array, so try it first.
      for dev in 0 3 1; do
        for ch in 8 4 2; do
          if arecord -D "hw:$CARD,$dev" -c "$ch" -r 48000 -f S32_LE -d 3 "$REC_FILE" 2>/dev/null; then
            MIC_OK=1
            echo "[OK] Mic capture device hw:$CARD,$dev (${ch}ch)"
            break 2
          fi
        done
      done
      if [ "$MIC_OK" -eq 0 ]; then
        arecord -D capture_plug -c 8 -r 48000 -f S32_LE -d 3 "$REC_FILE" 2>/dev/null || \
        arecord -D default -c 2 -r 48000 -f S16_LE -d 3 "$REC_FILE" 2>/dev/null || true
      fi
      if [ -f "$REC_FILE" ]; then
        SIZE=$(ls -l "$REC_FILE" | awk '{print $5}')
        echo "[OK] Mic capture successful: $REC_FILE ($SIZE bytes)."
      else
        echo "[WARN] Could not capture from microphone array."
      fi
    fi
    echo "=========================================================="
    ;;

  play)
    WAV="${2:-}"
    if [ -z "$WAV" ] || [ ! -f "$WAV" ]; then
      if [ -n "$WAV" ] && [ ! -f "$WAV" ]; then
        echo "Specified file not found: $WAV"
        echo "Searching for default audio tracks..."
      fi
      WAV=""
      for f in /root/music/*.wav \
               /usr/share/sounds/atrios/test-music.wav \
               /usr/share/sounds/alsa/Front_Center.wav; do
        if [ -f "$f" ]; then
          WAV="$f"
          break
        fi
      done
    fi
    if [ -z "$WAV" ] || [ ! -f "$WAV" ]; then
      echo "No audio file found. Place a WAV in /root/music/ or specify a file path."
      exit 1
    fi
    /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
    echo "Playing $WAV..."
    if command -v pw-play >/dev/null 2>&1 && pidof pipewire >/dev/null 2>&1; then
      pw-play "$WAV" 2>/dev/null && exit 0
    fi
    aplay -D default "$WAV" 2>/dev/null || \
    aplay -D "plughw:$CARD,0" "$WAV" 2>/dev/null || \
    aplay -D "plughw:0,0" "$WAV" 2>/dev/null || \
    aplay -D "hw:$CARD,0" "$WAV" 2>/dev/null || \
    aplay -D "hw:0,0" "$WAV"
    ;;

  record)
    DUR="${2:-3}"
    OUT="${3:-/tmp/recording_8ch.wav}"
    echo "Recording $DUR seconds to $OUT..."
    MIC_OK=0
    for dev in 0 3 1; do
      for ch in 8 4 2; do
        for c in "$CARD" 0; do
          if arecord -D "hw:$c,$dev" -c "$ch" -r 48000 -f S32_LE -d "$DUR" "$OUT" 2>/dev/null; then
            MIC_OK=1
            echo "Captured from hw:$c,$dev (${ch}ch)"
            break 3
          fi
        done
      done
    done
    if [ "$MIC_OK" -eq 0 ]; then
      arecord -D capture_plug -c 8 -r 48000 -f S32_LE -d "$DUR" "$OUT" 2>/dev/null || \
      arecord -D default -c 2 -r 48000 -f S16_LE -d "$DUR" "$OUT" 2>/dev/null || true
    fi
    if [ -f "$OUT" ] && [ -s "$OUT" ]; then
      echo "Saved to $OUT ($(ls -l "$OUT" | awk '{print $5}') bytes)."
    else
      echo "Error: Capture failed; output file was not created."
      exit 1
    fi
    ;;

  apply)
    PCT=$(read_state_pct)
    apply_volume "$PCT"
    ;;

  volume)
    VAL="$2"
    if [ -z "$VAL" ]; then
      PCT=$(read_state_pct)
      RAW=""
      for c in "$CARD" 0; do
        RAW=$(amixer -c "$c" cget name='Woofer Master Playback Volume' 2>/dev/null | sed -n 's/.*: values=//p' | tr -dc '0-9')
        [ -n "$RAW" ] && break
      done
      if [ -n "$RAW" ]; then
        echo "Current volume: ${PCT}% (ALSA ${RAW}/255)"
      else
        echo "Current volume: ${PCT}% (ALSA master not found)"
      fi
    else
      PCT=${VAL%\%}
      case "$PCT" in
        ''|*[!0-9]*) echo "Usage: atrios volume [0..100]"; exit 1 ;;
      esac
      [ "$PCT" -gt 100 ] && PCT=100
      write_state_pct "$PCT"
      echo "Setting volume to ${PCT}%..."
      apply_volume "$PCT"
      if [ -f /usr/lib/atrios/light ]; then
        python3 /usr/lib/atrios/light ring volume "$PCT" 2>/dev/null || true
      fi
    fi
    ;;

  mute)
    STATE="${2:-}"
    if [ -z "$STATE" ] || [ "$STATE" = "status" ]; then
      is_muted=0
      for c in "$CARD" 0; do
        val=$(amixer -c "$c" cget name='Capture Switch' 2>/dev/null | sed -n 's/.*: values=//p' | tr -dc 'a-zA-Z0-9')
        if [ "$val" = "off" ] || [ "$val" = "0" ]; then
          is_muted=1
          break
        fi
      done
      if [ "$is_muted" -eq 1 ]; then
        echo "Microphone array is currently MUTED. (Use 'atrios mute off' to unmute)"
      else
        echo "Microphone array is currently UNMUTED. (Use 'atrios mute on' to mute)"
      fi
    elif [ "$STATE" = "off" ] || [ "$STATE" = "0" ] || [ "$STATE" = "unmute" ]; then
      echo "Unmuting microphone array..."
      for c in "$CARD" 0; do
        amixer -c "$c" sset Capture unmute 2>/dev/null || true
        amixer -c "$c" sset Capture 100% 2>/dev/null || true
        for ctl in "Capture Switch" "ADC Capture Switch" "Mic Capture Switch" \
                   "TDMIN_A Switch" "TDMIN_B Switch"; do
          amixer -c "$c" cset name="$ctl" 1 2>/dev/null || true
        done
        for i in 1 2 3 4; do
          amixer -c "$c" cset name="Loopback ADC${i}_MUTE" 0 2>/dev/null || true
        done
      done
    else
      echo "Muting microphone array (playback is not touched)..."
      for c in "$CARD" 0; do
        amixer -c "$c" sset Capture mute 2>/dev/null || true
        amixer -c "$c" sset Capture 0% 2>/dev/null || true
        for ctl in "Capture Switch" "ADC Capture Switch" "Mic Capture Switch" \
                   "TDMIN_A Switch" "TDMIN_B Switch"; do
          amixer -c "$c" cset name="$ctl" 0 2>/dev/null || true
        done
        for i in 1 2 3 4; do
          amixer -c "$c" cset name="Loopback ADC${i}_MUTE" 1 2>/dev/null || true
        done
      done
    fi
    ;;

  amps)
    echo "Re-applying SY6045S and audio amplifier settings..."
    /etc/init.d/S03amplifiers start
    ;;

  *)
    echo "Usage: atrios audio <command> [args]"
    echo "Commands:"
    echo "  atrios audio check                  - Automated audio subsystem diagnostics"
    echo "  atrios audio test                   - Full playback & 8-channel mic array test"
    echo "  atrios audio play [file.wav]        - Play audio through speakers"
    echo "  atrios audio record [sec] [out.wav] - Record 8-channel audio from mic array"
    echo "  atrios audio volume [0..100%]       - Get/set volume on physical amplifiers"
    echo "  atrios audio mute [on|off]          - Mute/unmute physical amplifiers & mic array"
    echo "  atrios audio amps                   - Reload amplifier firmware settings"
    exit 1
    ;;
esac
exit 0
