#!/bin/sh
# AtriOS Unified Audio & Amplifier Management Utility (atrios-audio)
# Controls:
#   - AMLAUGESOUND hardware sound card (TDM-B Lane 0 -> SY6045S & ES8156)
#   - Silergy SY6045S Woofer (2-002b) and Tweeters (2-002a) amplifiers
#   - Everest ES8156 Headphone DAC (3.5mm jack, 2-0008)
#   - 8-channel Everest ES7210 microphone array (2-0040, 2-0043)

ACTION="${1:-test}"
CARD="AMLAUGESOUND"
export XDG_RUNTIME_DIR="/var/run/pipewire"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/var/run/dbus/system_bus_socket"

case "$ACTION" in
  check|check-audio|audit|diag)
    shift
    CHECK_SCRIPT="/usr/lib/atrios/check_audio.sh"
    if [ ! -f "$CHECK_SCRIPT" ]; then
      CHECK_SCRIPT="$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)/check_audio.sh"
    fi
    exec /bin/sh "$CHECK_SCRIPT" "$@"
    ;;

  test)
    echo "=========================================================="
    echo "          AtriOS Unified Audio & Mic Diagnostic           "
    echo "=========================================================="
    # Step 0: Run automated audio subsystem diagnostics suite
    CHECK_SCRIPT="/usr/lib/atrios/check_audio.sh"
    if [ ! -f "$CHECK_SCRIPT" ]; then
      CHECK_SCRIPT="$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)/check_audio.sh"
    fi
    if [ -x "$CHECK_SCRIPT" ]; then
      echo "[Diagnostics]: Running automated hardware & ALSA check..."
      "$CHECK_SCRIPT" --verbose || exit $?
      echo ""
    fi

    echo "[ALSA Sound Cards]:"
    cat /proc/asound/cards 2>/dev/null || echo "No cards found"
    echo ""
    echo "[Hardware Amplifiers (Silergy SY6045S)]:"
    if [ -d /sys/bus/i2c/drivers/sy6045s ]; then
      for inst in /sys/bus/i2c/drivers/sy6045s/2-00*; do
        if [ -d "$inst" ]; then
          bname=$(basename "$inst")
          fw=$(cat "$inst/settings_file" 2>/dev/null || echo "N/A")
          echo "  * Instance $bname: Registered (firmware: $fw)"
        fi
      done
    else
      echo "  * SY6045S driver not loaded"
    fi
    echo ""
    echo "[Amplifier Re-Init]: Applying 0dB hardware unmute..."
    /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
    echo ""
    echo "[Playback Test]: Playing test chime on speakers / headphone jack..."
    WAV="/usr/share/sounds/alsa/Front_Center.wav"
    PLAY_OK=0
    if command -v pw-play >/dev/null 2>&1 && pidof pipewire >/dev/null 2>&1 && [ -f "$WAV" ]; then
      pw-play "$WAV" 2>/dev/null && PLAY_OK=1
    fi
    if [ "$PLAY_OK" -eq 0 ]; then
      # Temporarily stop PipeWire if it holds hw:AMLAUGESOUND,0 exclusively
      PW_WAS_RUNNING=0
      if pidof pipewire >/dev/null 2>&1; then
        PW_WAS_RUNNING=1
        /etc/init.d/S50pipewire stop >/dev/null 2>&1 || killall wireplumber pipewire 2>/dev/null || true
        usleep 200000 2>/dev/null || sleep 1
      fi
      /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
      if command -v speaker-test >/dev/null 2>&1; then
        speaker-test -D default -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null ||         speaker-test -D "plughw:$CARD,0" -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null ||         speaker-test -D "hw:$CARD,0" -c 2 -r 48000 -F S32_LE -t sine -f 440 -l 1 2>/dev/null || true
      elif command -v aplay >/dev/null 2>&1 && [ -f "$WAV" ]; then
        aplay -D default "$WAV" 2>/dev/null ||         aplay -D "plughw:$CARD,0" "$WAV" 2>/dev/null || true
      fi
      if [ "$PW_WAS_RUNNING" -eq 1 ]; then
        /etc/init.d/S50pipewire start >/dev/null 2>&1 || true
      fi
    fi
    echo ""
    echo "[Microphone Test]: Recording 3 seconds from 8-ch mic array..."
    REC_FILE="/tmp/atrios_mic_test.wav"
    rm -f "$REC_FILE"
    if command -v arecord >/dev/null 2>&1; then
      MIC_OK=0
      # PDM capture is device 5 on AML-AUGESOUND; the TDM/ES7210 path is
      # usually device 1.  Try both before falling back to plug/default.
      for dev in 5 1 0; do
        if arecord -D "hw:$CARD,$dev" -c 8 -r 48000 -f S32_LE -d 3 "$REC_FILE" 2>/dev/null; then
          MIC_OK=1
          echo "[OK] Mic capture device hw:$CARD,$dev"
          break
        fi
      done
      if [ "$MIC_OK" -eq 0 ]; then
        arecord -D capture_plug -c 8 -r 48000 -f S32_LE -d 3 "$REC_FILE" 2>/dev/null || \
        arecord -D default -c 2 -r 48000 -f S16_LE -d 3 "$REC_FILE" 2>/dev/null || true
      fi
      if [ -f "$REC_FILE" ]; then
        SIZE=$(ls -l "$REC_FILE" | awk '{print $5}')
        echo "[OK] Mic capture successful: $REC_FILE ($SIZE bytes)."
      else
        echo "[WARN] Could not capture from microphone array."
      fi
    fi
    echo "=========================================================="
    ;;

  play)
    WAV="${2:-/usr/share/sounds/alsa/Front_Center.wav}"
    if [ ! -f "$WAV" ]; then
      echo "File not found: $WAV"
      exit 1
    fi
    /etc/init.d/S03amplifiers start >/dev/null 2>&1 || true
    echo "Playing $WAV..."
    if command -v pw-play >/dev/null 2>&1 && pidof pipewire >/dev/null 2>&1; then
      pw-play "$WAV" 2>/dev/null && exit 0
    fi
    aplay -D default "$WAV" 2>/dev/null || aplay -D "plughw:$CARD,0" "$WAV" 2>/dev/null || aplay -D "hw:$CARD,0" "$WAV"
    ;;

  record)
    DUR="${2:-3}"
    OUT="${3:-/tmp/recording_8ch.wav}"
    echo "Recording $DUR seconds to $OUT..."
    MIC_OK=0
    for dev in 5 1 0; do
      if arecord -D "hw:$CARD,$dev" -c 8 -r 48000 -f S32_LE -d "$DUR" "$OUT" 2>/dev/null; then
        MIC_OK=1
        echo "Captured from hw:$CARD,$dev"
        break
      fi
    done
    if [ "$MIC_OK" -eq 0 ]; then
      arecord -D capture_plug -c 8 -r 48000 -f S32_LE -d "$DUR" "$OUT" 2>/dev/null || true
    fi
    echo "Saved to $OUT ($(ls -l "$OUT" | awk '{print $5}') bytes)."
    ;;

  volume)
    VAL="$2"
    if [ -z "$VAL" ]; then
      RAW=$(amixer -c "$CARD" cget name='Woofer Master Playback Volume' 2>/dev/null | sed -n 's/.*: values=//p' | tr -dc '0-9')
      if [ -n "$RAW" ]; then
        echo "Current volume: ${RAW}/255 ($((RAW * 100 / 255))%)"
      else
        echo "Current volume: unknown (AML-AUGESOUND master control not found)"
      fi
    else
      PCT=${VAL%\%}
      case "$PCT" in
        ''|*[!0-9]*) echo "Usage: atrios volume [0..100]"; exit 1 ;;
      esac
      [ "$PCT" -gt 100 ] && PCT=100
      RAW=$((PCT * 255 / 100))
      echo "Setting volume to ${PCT}% (ALSA ${RAW}/255)..."
      for ctl in "Woofer Master Playback Volume" \
                 "Tweeters Master Playback Volume" \
                 "Headphone DAC Playback Volume"; do
        amixer -c "$CARD" cset name="$ctl" "$RAW" 2>/dev/null || true
      done
      if command -v wpctl >/dev/null 2>&1; then
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "${PCT}%" 2>/dev/null || true
      fi
      if [ -f /usr/lib/atrios/light ]; then
        python3 /usr/lib/atrios/light ring volume "$PCT" 2>/dev/null || true
      fi
    fi
    ;;

  mute)
    STATE="$2"
    if [ "$STATE" = "off" ] || [ "$STATE" = "0" ] || [ "$STATE" = "unmute" ]; then
      echo "Unmuting playback and microphone array..."
      amixer -c "$CARD" cset name='Woofer Master Playback Switch' 1 2>/dev/null || true
      amixer -c "$CARD" cset name='Tweeters Master Playback Switch' 1 2>/dev/null || true
      amixer -c "$CARD" cset name='Headphone Headphone Switch' 1 2>/dev/null || true
      wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 2>/dev/null || true
      wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null || true
    else
      echo "Muting playback and microphone array..."
      amixer -c "$CARD" cset name='Woofer Master Playback Switch' 0 2>/dev/null || true
      amixer -c "$CARD" cset name='Tweeters Master Playback Switch' 0 2>/dev/null || true
      amixer -c "$CARD" cset name='Headphone Headphone Switch' 0 2>/dev/null || true
      wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 2>/dev/null || true
      wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 2>/dev/null || true
    fi
    ;;

  amps)
    echo "Re-applying SY6045S and audio amplifier settings..."
    /etc/init.d/S03amplifiers start
    ;;

  *)
    echo "Usage: atrios audio <command> [args]"
    echo "Commands:"
    echo "  atrios audio check                  - Automated audio subsystem diagnostics"
    echo "  atrios audio test                   - Full playback & 8-channel mic array test"
    echo "  atrios audio play [file.wav]        - Play audio through speakers"
    echo "  atrios audio record [sec] [out.wav] - Record 8-channel audio from mic array"
    echo "  atrios audio volume [0..100%]       - Get/set volume on physical amplifiers"
    echo "  atrios audio mute [on|off]          - Mute/unmute physical amplifiers & mic array"
    echo "  atrios audio amps                   - Reload amplifier firmware settings"
    exit 1
    ;;
esac
exit 0
