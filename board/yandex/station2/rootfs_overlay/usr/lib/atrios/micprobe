#!/usr/bin/env python3
"""
AtriOS microphone path probe.

The AML-AUGESOUND card exposes several capture devices and a loopback
crossbar.  This script walks the likely combinations, records one second
from each and prints RMS/peak/zero-crossing rate, so we can see which path
carries the real ES7210 microphone signal and which one is just the PDM
dummy/noise.

Run as root:  atrios micprobe
"""

import array
import math
import os
import struct
import subprocess
import sys
import tempfile
import wave

CARD = "AMLAUGESOUND"
TMP = "/tmp/atrios-micprobe.wav"

SOURCES = [
    ("LOOPBACK_A", 7),
    ("LOOPBACK_B", 9),
    ("TDMIN_LB", 6),
    ("TDMIN_B", 1),
    ("PDMIN", 4),
]
DEVICES = [0, 3, 1]


def amixer(*args):
    try:
        subprocess.run(["amixer", "-c", CARD, *args],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=2)
    except Exception:
        pass


def setup():
    amixer("cset", "name=Audio Out Sink", "1")
    for i in (1, 2, 3, 4):
        amixer("cset", f"name=Loopback ADC{i}_MUTE", "0")
    for name, val in (("Loopback ADC1_MAX_GAIN", "188"),
                      ("Loopback ADC2_MAX_GAIN", "203"),
                      ("Loopback ADC3_MAX_GAIN", "191"),
                      ("Loopback ADC4_MAX_GAIN", "191")):
        amixer("cset", f"name={name}", val)


def set_source(name, index):
    amixer("cset", f"name=Audio In Source", name)
    # Fallback for older amixer builds that do not resolve enum labels.
    amixer("cset", "name=Audio In Source", str(index))


def record(dev):
    try:
        os.unlink(TMP)
    except OSError:
        pass
    try:
        r = subprocess.run(
            ["arecord", "-q", "-D", f"hw:{CARD},{dev}", "-c", "2",
             "-r", "48000", "-f", "S32_LE", "-d", "1", TMP],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=4)
        if r.returncode != 0 or not os.path.exists(TMP):
            return None
        return TMP
    except Exception:
        return None


def analyze(path):
    with wave.open(path, "rb") as w:
        n = w.getnframes()
        raw = w.readframes(n)
        width = w.getsampwidth()
        ch = w.getnchannels()
    if width != 4:
        return None
    samples = array.array("i")
    samples.frombytes(raw[:len(raw) - (len(raw) % 4)])
    if not samples:
        return None
    # interleaved stereo -> use left channel
    left = samples[0::ch]
    if not left:
        return None
    peak = max(abs(x) for x in left) / 2147483648.0
    rms = math.sqrt(sum(float(x) * x for x in left) / len(left)) / 2147483648.0
    zc = sum(1 for a, b in zip(left, left[1:]) if (a >= 0) != (b >= 0))
    zcr = zc / max(1, len(left) - 1)
    return rms, peak, zcr


def main():
    print("AtriOS microphone path probe")
    print("=" * 60)
    setup()
    found = []
    for name, index in SOURCES:
        set_source(name, index)
        for dev in DEVICES:
            path = record(dev)
            if not path:
                print(f"source={name:10s} dev={dev}  capture failed")
                continue
            a = analyze(path)
            if not a:
                print(f"source={name:10s} dev={dev}  unsupported format")
                continue
            rms, peak, zcr = a
            print(f"source={name:10s} dev={dev}  rms={rms:.5f} peak={peak:.5f} zcr={zcr:.4f}")
            if rms > 0.001 and peak > 0.01:
                found.append((name, dev, rms, peak, zcr))
    print("=" * 60)
    if found:
        print("Candidates with real signal:")
        for name, dev, rms, peak, zcr in found:
            print(f"  source={name} dev={dev} rms={rms:.5f} peak={peak:.5f} zcr={zcr:.4f}")
        print("Use: arecord -D hw:AMLAUGESOUND,<dev> -c 2 -r 48000 -f S32_LE -d 5 /tmp/mic.wav")
    else:
        print("No combination produced a signal above the noise floor.")
        print("The ES7210 loopback may not be wired to TDM_B in this DTS.")


if __name__ == "__main__":
    main()
