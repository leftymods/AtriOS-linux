class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def _send_json(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _read_json(self):
        n = int(self.headers.get("Content-Length", "0") or 0)
        if n <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(n).decode("utf-8", "ignore"))
        except Exception:
            return {}

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path in ("/", "/index.html"):
            body = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif path == "/api/status":
            self._send_json(200, build_status())
        else:
            self._send_json(404, {"error": "not found"})

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        data = self._read_json()
        if path == "/api/volume":
            vol = max(0, min(100, int(data.get("volume", 60))))
            run_atrios(["volume", str(vol)], bg=True)
            self._send_json(200, {"ok": True, "volume": vol})
        elif path == "/api/screen":
            mode = str(data.get("mode", "clock"))
            if mode == "ticker":
                run_atrios(["screen", "ticker", str(data.get("text", "AtriOS"))], bg=True)
            elif mode == "eyes":
                run_atrios(["screen", "eyes", str(data.get("state", "happy"))], bg=True)
            elif mode in ("clock", "kisser", "off"):
                run_atrios(["screen", mode], bg=True)
            self._send_json(200, {"ok": True})
        elif path == "/api/ring":
            mode = str(data.get("mode", "off"))
            if mode == "volume":
                run_atrios(["ring", "volume", str(read_volume())], bg=True)
            elif mode in ("rainbow", "off"):
                run_atrios(["ring", mode], bg=True)
            self._send_json(200, {"ok": True})
        elif path == "/api/bt/pair":
            secs = max(10, min(300, int(data.get("seconds", 60))))
            run_atrios(["bt", "pair", str(secs)])
            self._send_json(200, {"ok": True, "seconds": secs})
        elif path == "/api/bt/hide":
            run_atrios(["bt", "hide"])
            self._send_json(200, {"ok": True})
        elif path == "/api/bt/unpair":
            mac = str(data.get("mac", "all"))
            run_atrios(["bt", "unpair", mac])
            self._send_json(200, {"ok": True})
        elif path == "/api/system/test":
            run_atrios(["test"], bg=True)
            self._send_json(200, {"ok": True})
        elif path == "/api/system/reboot":
            subprocess.Popen(["reboot"])
            self._send_json(200, {"ok": True})
        else:
            self._send_json(404, {"error": "not found"})


class ReusableTCPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True


