#!/usr/bin/env python3
"""
AtriOS Nebula Material 3 Web App & Control API (/usr/lib/atrios/webui)
Serves a Material 3 (Material You) companion web application on port 8080.
"""

import glob
import http.server
import json
import os
import re
import socketserver
import subprocess
import sys
import time
import urllib.parse

PORT = int(os.environ.get("ATRIOS_WEB_PORT", "8080"))
VOLUME_FILE = "/var/lib/atrios/volume"
BT_PAIRED_FILE = "/var/lib/atrios/bt_paired"
BT_PAIR_UNTIL_FILE = "/var/run/atrios-bt-pair-until"
DEVICE_FILE = "/etc/atrios-device"


def read_device_meta():
    meta = {"name": "AtriStation Max", "codename": "station-max", "rev": "rev1.0", "os": "AtriOS Nebula"}
    try:
        if os.path.exists(DEVICE_FILE):
            with open(DEVICE_FILE, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("DEVICE_NAME="):
                        meta["name"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["name"]
                    elif line.startswith("DEVICE_CODENAME="):
                        meta["codename"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["codename"]
                    elif line.startswith("DEVICE_REV="):
                        meta["rev"] = line.split("=", 1)[1].strip().strip('"').strip("'") or meta["rev"]
    except Exception:
        pass
    return meta


def read_cpu_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp", "r") as f:
            return round(int(f.read().strip()) / 1000.0, 1)
    except Exception:
        return 0.0


def read_uptime():
    try:
        with open("/proc/uptime", "r") as f:
            return int(float(f.readline().split()[0]))
    except Exception:
        return 0


def read_mem():
    try:
        total, avail = 0, 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1]) // 1024
                elif line.startswith("MemAvailable:"):
                    avail = int(line.split()[1]) // 1024
        return {"total_mb": total, "free_mb": avail, "used_mb": max(0, total - avail)}
    except Exception:
        return {"total_mb": 0, "free_mb": 0, "used_mb": 0}


def read_lux():
    try:
        for path in glob.glob("/sys/bus/iio/devices/iio:device*/in_illuminance_raw") + glob.glob("/sys/bus/iio/devices/iio:device*/in_illuminance_input"):
            with open(path, "r") as f:
                return int(float(f.read().strip()))
    except Exception:
        pass
    return None


def read_volume():
    try:
        if os.path.exists(VOLUME_FILE):
            with open(VOLUME_FILE, "r") as f:
                return max(0, min(100, int(f.read().strip())))
    except Exception:
        pass
    return 60


def read_wifi():
    ip, ssid = "", ""
    try:
        out = subprocess.check_output(["ip", "-4", "addr", "show", "wlan0"], timeout=2).decode("utf-8", "ignore")
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("inet "):
                ip = line.split()[1].split("/")[0]
                break
    except Exception:
        pass
    try:
        out = subprocess.check_output(["iw", "dev", "wlan0", "link"], timeout=2).decode("utf-8", "ignore")
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("SSID:"):
                ssid = line.split(":", 1)[1].strip()
                break
    except Exception:
        pass
    return {"ip": ip, "ssid": ssid, "connected": bool(ip)}


def read_paired_devices():
    devs = []
    try:
        if os.path.exists(BT_PAIRED_FILE):
            with open(BT_PAIRED_FILE, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    mac = line.strip()
                    if re.match(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$", mac):
                        devs.append(mac.upper())
    except Exception:
        pass
    return devs


def read_bt_status():
    paired = read_paired_devices()
    pair_remaining = 0
    try:
        if os.path.exists(BT_PAIR_UNTIL_FILE):
            with open(BT_PAIR_UNTIL_FILE, "r") as f:
                until_ts = int(f.read().strip())
            rem = until_ts - int(time.time())
            if rem > 0:
                pair_remaining = rem
    except Exception:
        pass

    discoverable = False
    hci_up = False
    try:
        out = subprocess.check_output(["hciconfig", "hci0"], timeout=2).decode("utf-8", "ignore")
        hci_up = "UP RUNNING" in out
        discoverable = "ISCAN" in out
    except Exception:
        pass

    hidden = bool(paired) and not discoverable and pair_remaining == 0
    return {
        "up": hci_up,
        "discoverable": discoverable,
        "hidden": hidden,
        "paired_devices": paired,
        "pair_remaining_sec": pair_remaining,
    }


def build_status():
    vol = read_volume()
    return {
        "device": read_device_meta(),
        "system": {
            "cpu_temp": read_cpu_temp(),
            "uptime_sec": read_uptime(),
            "memory": read_mem(),
            "lux": read_lux(),
        },
        "audio": {"volume": vol, "mute": vol == 0},
        "wifi": read_wifi(),
        "bluetooth": read_bt_status(),
    }


def run_atrios(args, bg=False):
    cmd = ["/usr/bin/atrios"] + args
    if bg:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)


