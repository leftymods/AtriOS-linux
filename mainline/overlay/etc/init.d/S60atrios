#!/bin/sh
# /etc/init.d/S60atrios - start AtriOS user interaction daemons (mainline)
#
# Same daemons as the 4.9 image.  rotaryd keeps working unchanged:
#   - input driver reports KEY_PAGEUP/KEY_PAGEDOWN (104/109)
#   - the ring is still /dev/fb5 (mainline ledtrig-ringfb, 72 bytes)
#   - screend still uses /dev/fb4 (mainline atri,led-panel)
# Only the log directory creation is added: a fresh Buildroot rootfs does
# not guarantee /var/log exists.

case "$1" in
  start)
    echo "[AtriOS] Starting user interface daemons..."
    mkdir -p /var/log
    # fbdev numbering is dynamic; userspace expects fb4 (panel) and fb5 (ring).
    for _fb in /sys/class/graphics/fb*; do
      [ -r "$_fb/name" ] || continue
      _name=$(cat "$_fb/name" 2>/dev/null)
      _node=/dev/$(basename "$_fb")
      case "$_name" in
        atrios-ledpanel) [ -e /dev/fb4 ] || ln -sf "$_node" /dev/fb4 ;;
        led-ring-fb)     [ -e /dev/fb5 ] || ln -sf "$_node" /dev/fb5 ;;
      esac
    done
    # keep the serial console quiet (hide driver debug spam)
    dmesg -n 4 2>/dev/null || true
    if [ -x /usr/lib/atrios/rotaryd ]; then
      /usr/lib/atrios/rotaryd >/var/log/atrios-rotaryd.log 2>&1 &
    else
      echo "[AtriOS] [!] /usr/lib/atrios/rotaryd missing; rotary input disabled"
    fi
    if [ -x /usr/lib/atrios/screend ]; then
      /usr/lib/atrios/screend >/var/log/atrios-screend.log 2>&1 &
    else
      echo "[AtriOS] [!] /usr/lib/atrios/screend missing; LED panel disabled"
    fi
    ;;
  stop)
    pkill -f /usr/lib/atrios/rotaryd 2>/dev/null
    pkill -f /usr/lib/atrios/screend 2>/dev/null
    true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0
