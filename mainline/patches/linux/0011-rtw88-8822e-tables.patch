+++ b/drivers/net/wireless/realtek/rtw88/rtw8822c.h
@@ -105,6 +105,49 @@ struct rtw8822c_efuse {
 	};
 } __packed;
 
+/*
+ * RTL8822E efuse map (SDIO only).  Offsets are identical to rtw8822c_efuse
+ * for every field used by rtw88; the only difference is that the vendor
+ * driver documents 0xbc..0xc0 as the 2G/5G PA and LNA type bytes
+ * (EEPROM_*_8822E in the vendor include/hal_pg.h) instead of "reserved".
+ * MAC address lives at 0x16a (EEPROM_MAC_ADDR_8822ES).  The 0xbc..0xc0
+ * bytes are kept here for documentation; rtw88 does not act on them.
+ */
+struct rtw8822e_efuse {
+	__le16 rtl_id;
+	u8 res0[4];
+	u8 usb_mode;
+	u8 res1[0x09];
+
+	struct rtw_txpwr_idx txpwr_idx_table[4];	/* 0x10 */
+
+	u8 channel_plan;		/* 0xb8 */
+	u8 xtal_k;			/* 0xb9 */
+	u8 res2;
+	u8 iqk_lck;			/* 0xbb */
+	u8 pa_type_2g_5g;		/* 0xbc */
+	u8 lna_2g_ab;			/* 0xbd */
+	u8 lna_2g_cd;			/* 0xbe */
+	u8 lna_5g_ab;			/* 0xbf */
+	u8 lna_5g_cd;			/* 0xc0 */
+	u8 rf_board_option;		/* 0xc1 */
+	u8 rf_feature_option;
+	u8 rf_bt_setting;
+	u8 eeprom_version;
+	u8 eeprom_customer_id;
+	u8 tx_bb_swing_setting_2g;
+	u8 tx_bb_swing_setting_5g;
+	u8 tx_pwr_calibrate_rate;	/* 0xc8 */
+	u8 rf_antenna_option;		/* 0xc9 */
+	u8 rfe_option;			/* 0xca */
+	u8 country_code[2];		/* 0xcb */
+	u8 res3[3];
+	u8 path_a_thermal;		/* 0xd0 */
+	u8 path_b_thermal;		/* 0xd1 */
+	u8 res4[0x98];			/* 0xd2..0x169 */
+	u8 mac_addr[ETH_ALEN];		/* 0x16a */
+} __packed;
+
 enum rtw8822c_dpk_agc_phase {
 	RTW_DPK_GAIN_CHECK,
 	RTW_DPK_GAIN_LARGE,
