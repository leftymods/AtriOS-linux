 #include "phy.h"
 #include "rtw8822c.h"
 #include "rtw8822c_table.h"
+#include "rtw8822e_table.h"
 #include "mac.h"
 #include "reg.h"
 #include "debug.h"
@@ -85,6 +86,47 @@ static int rtw8822c_read_efuse(struct rtw_dev *rtwdev, u8 *log_map)
 	return 0;
 }
 
+/*
+ * RTL8822E SDIO efuse.  The vendor driver (include/hal_pg.h,
+ * EEPROM_*_8822E / EEPROM_MAC_ADDR_8822ES) uses the same offsets as the
+ * 8822C for everything rtw88 consumes; only 0xbc..0xc0 have a documented
+ * meaning (PA/LNA types) instead of being reserved, and the SDIO MAC
+ * address is at 0x16a.  The BUILD_BUG_ON()s below pin that assumption.
+ */
+static int rtw8822e_read_efuse(struct rtw_dev *rtwdev, u8 *log_map)
+{
+	struct rtw_efuse *efuse = &rtwdev->efuse;
+	struct rtw8822e_efuse *map = (struct rtw8822e_efuse *)log_map;
+	int i;
+
+	BUILD_BUG_ON(offsetof(struct rtw8822e_efuse, rfe_option) != 0xca);
+	BUILD_BUG_ON(offsetof(struct rtw8822e_efuse, country_code) != 0xcb);
+	BUILD_BUG_ON(offsetof(struct rtw8822e_efuse, path_a_thermal) != 0xd0);
+	BUILD_BUG_ON(offsetof(struct rtw8822e_efuse, mac_addr) != 0x16a);
+
+	efuse->rfe_option = map->rfe_option;
+	efuse->rf_board_option = map->rf_board_option;
+	efuse->crystal_cap = map->xtal_k & XCAP_MASK;
+	efuse->channel_plan = map->channel_plan;
+	efuse->country_code[0] = map->country_code[0];
+	efuse->country_code[1] = map->country_code[1];
+	efuse->bt_setting = map->rf_bt_setting;
+	efuse->regd = map->rf_board_option & 0x7;
+	efuse->thermal_meter[RF_PATH_A] = map->path_a_thermal;
+	efuse->thermal_meter[RF_PATH_B] = map->path_b_thermal;
+	efuse->thermal_meter_k =
+			(map->path_a_thermal + map->path_b_thermal) >> 1;
+	efuse->power_track_type = (map->tx_pwr_calibrate_rate >> 4) & 0xf;
+
+	for (i = 0; i < 4; i++)
+		efuse->txpwr_idx_table[i] = map->txpwr_idx_table[i];
+
+	/* 8822E is SDIO-only: MAC at 0x16a, same as the 8822CS map */
+	ether_addr_copy(efuse->addr, map->mac_addr);
+
+	return 0;
+}
+
 static void rtw8822c_header_file_init(struct rtw_dev *rtwdev, bool pre)
 {
 	rtw_write32_set(rtwdev, REG_3WIRE, BIT_3WIRE_TX_EN | BIT_3WIRE_RX_EN);
@@ -5001,6 +5043,54 @@ static const struct rtw_chip_ops rtw8822c_ops = {
 	.coex_set_wl_rx_gain	= rtw8822c_coex_cfg_wl_rx_gain,
 };
 
+/*
+ * 8822E uses the 8822C code paths for everything except the efuse parser,
+ * which knows about the 8822E MAP offsets (identical for the fields we use)
+ * and the 0x16a SDIO MAC address.  PHY/RF calibration is still the 8822C
+ * implementation, see docs/wifi-port.md.
