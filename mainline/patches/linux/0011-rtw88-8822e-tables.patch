+};
+
 /* Shared-Antenna Coex Table */
 static const struct coex_table_para table_sant_8822c[] = {
 	{0xffffffff, 0xffffffff}, /* case-0 */
@@ -5290,6 +5380,28 @@ static const struct rtw_rfe_def rtw8822c_rfe_defs[] = {
 	[6] = RTW_DEF_RFE(8822c, 0, 0, 0),
 };
 
+/*
+ * The 8822E needs its own BB-PG and txpower-limit tables.  The calibration
+ * (power tracking) table is still the 8822C one -- the delta swing arrays
+ * of the 8822E were not ported yet, see docs/wifi-port.md.
+ *
+ * rtw88 fails the probe for an rfe_option outside rfe_defs[], while the
+ * 8822E vendor tables special-case rfe 0x15/0x16 (21/22) and fall back to
+ * the generic branch for everything else.  Cover the whole 8-bit range so
+ * an unknown efuse value cannot fail the probe; the PHY table parser uses
+ * the real rfe_option independently of this array.
+ */
+#define RTW8822E_DEF_RFE(pwrlmt) {					\
+	.phy_pg_tbl = &rtw8822e_bb_pg_type0_tbl,			\
+	.txpwr_lmt_tbl = &rtw8822e_txpwr_lmt_type ## pwrlmt ## _tbl,	\
+	.pwr_track_tbl = &rtw8822c_pwr_track_type0_tbl,			\
+}
+
+static const struct rtw_rfe_def rtw8822e_rfe_defs[] = {
+	[0 ... 255] = RTW8822E_DEF_RFE(0),
+	[5] = RTW8822E_DEF_RFE(5),
+};
+
 static const struct rtw_hw_reg_offset rtw8822c_edcca_th[] = {
 	[EDCCA_TH_L2H_IDX] = {
 		{.addr = 0x84c, .mask = MASKBYTE2}, .offset = 0x80
@@ -5450,13 +5562,15 @@ EXPORT_SYMBOL(rtw8822c_hw_spec);
  * .id intentionally stays RTW_CHIP_TYPE_8822C so that the SDIO layer keeps
  * using the 8822C indirect-access and RX aggregation quirks.
  *
- * Stage (a) of the port: only the firmware name differs.  AGC/RF/cal-init/
- * txpower tables and the efuse map of the 8822E are known to differ from the
- * 8822C and are still the 8822C ones here, see docs/wifi-port.md.
+ * Stage (b) of the port: the BB, AGC, RF A/B, cal-init and txpower-limit
+ * tables are the real 8822E ones (rtw8822e_table.c, generated from the
+ * vendor driver), and .read_efuse uses the 8822E efuse map.  PHY/RF
+ * calibration code, DPD and the power-tracking delta tables are still the
+ * 8822C implementations, see docs/wifi-port.md.
  * WoW is disabled because no 8822E WoW firmware is available.
  */
