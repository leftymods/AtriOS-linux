+/* ----------------------------------------------------------------
+ * Parser: verbatim port of the vendor phy table engine
+ * ---------------------------------------------------------------- */
+
+static void rtw8822e_parse_tbl_phy_cond(struct rtw_dev *rtwdev,
+					const struct rtw_table *tbl)
+{
+	const u32 *array = tbl->data;
+	u32 array_len = tbl->size;
+	u32 h_size = 0, h_idx = 0, cfg_target = 0, cfg_para = 0;
+	u32 cut_max = 0, cut, rfe, i, v1, v2, written = 0;
+	bool is_matched = true, find_target = false, found = false;
+
+	cut = rtwdev->hal.cut_version ? rtwdev->hal.cut_version : 15;
+	rfe = rtwdev->efuse.rfe_option;
+
+	while ((h_size + 1) < array_len) {
+		if ((array[h_size] >> 28) != 0xf)
+			break;
+		h_size += 2;
+	}
+
+	/* case 1: {cut: match, rfe: match} */
+	for (i = 0; i < h_size; i += 2) {
+		if ((array[i] & 0x0f0000ff) == ((cut & 0xf) << 24 | rfe)) {
+			h_idx = i >> 1;
+			goto have_header;
+		}
+	}
+	/* case 2: {cut: don't care, rfe: match} */
+	for (i = 0; i < h_size; i += 2) {
+		if ((array[i] & 0x0f0000ff) == (CUT_DONT_CARE << 24 | rfe)) {
+			h_idx = i >> 1;
+			goto have_header;
+		}
+	}
+	/* case 3: {rfe: match, cut: greatest in table} */
+	for (i = 0; i < h_size; i += 2) {
+		if ((array[i] & 0xff) != rfe)
+			continue;
+		found = true;
+		if ((array[i] & 0x0f000000) >> 24 >= cut_max) {
+			cut_max = (array[i] & 0x0f000000) >> 24;
+			h_idx = i >> 1;
+		}
+	}
+	if (found)
+		goto have_header;
+	/* case 4: {rfe: don't care, cut: greatest in table} */
+	cut_max = 0;
+	for (i = 0; i < h_size; i += 2) {
+		if ((array[i] & 0xff) != RFE_DONT_CARE)
+			continue;
+		found = true;
+		if ((array[i] & 0x0f000000) >> 24 >= cut_max) {
+			cut_max = (array[i] & 0x0f000000) >> 24;
+			h_idx = i >> 1;
+		}
+	}
+	if (!found)
+		goto out;
+
+have_header:
+	if (h_size)
+		cfg_target = array[h_idx << 1] & 0x0fffffff;
+
+	for (i = h_size; (i + 1) < array_len; i += 2) {
+		v1 = array[i];
+		v2 = array[i + 1];
+
+		switch (v1 >> 28) {
+		case PARA_IF:
+		case PARA_ELSE_IF:
+			cfg_para = v1 & 0x0fffffff;
+			break;
+		case PARA_ELSE:
+			is_matched = false;
+			if (!find_target)
+				goto out;
+			break;
+		case PARA_END:
+			is_matched = true;
+			find_target = false;
+			break;
+		case PARA_CHK:
+			if (find_target) {
+				is_matched = false;
+				break;
+			}
+			is_matched = cfg_para == cfg_target;
+			find_target = is_matched;
+			break;
+		default:
+			if (is_matched) {
+				tbl->do_cfg(rtwdev, tbl, v1, v2);
+				written++;
+			}
+		}
+	}
+
+out:
+	if (!written)
+		rtw_warn(rtwdev,
+			 "rtw8822e: no phy entries applied (cut %u rfe 0x%02x, %u words)\n",
+			 cut, rfe, array_len);
+}
+
+#define RTW8822E_DECL_PHY(name, cfg, path)		\
+const struct rtw_table name ## _tbl = {		\
+	.data = name,				\
+	.size = ARRAY_SIZE(name),		\
+	.parse = rtw8822e_parse_tbl_phy_cond,	\
+	.do_cfg = cfg,				\
+	.rf_path = path,			\
+}
