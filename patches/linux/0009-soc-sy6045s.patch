+/*
+ * I2C glue.
+ */
+
+static int sy6045s_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sy6045s_priv *priv;
+	struct regmap_config *config;
+	const char *fw_name = NULL;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	priv->i2c = client;
+	mutex_init(&priv->io_lock);
+	INIT_WORK(&priv->spk_off_work, sy6045s_spk_off_work);
+	INIT_WORK(&priv->spk_on_work, sy6045s_spk_on_work);
+
+	config = devm_kmemdup(dev, &sy6045s_regmap_config, sizeof(*config),
+			      GFP_KERNEL);
+	if (!config)
+		return -ENOMEM;
+	config->lock_arg = priv;
+
+	priv->regmap = devm_regmap_init_i2c(client, config);
+	if (IS_ERR(priv->regmap)) {
+		ret = PTR_ERR(priv->regmap);
+		dev_err(dev, "unable to allocate register map: %d\n", ret);
+		return ret;
+	}
+
+	dev_set_drvdata(dev, priv);
+
+	if (device_property_read_string(dev, "firmware-name", &fw_name)) {
+		if (device_property_read_string(dev, "firmware", &fw_name))
+			fw_name = NULL;
+	}
+	priv->default_fw_name = fw_name;
+
+	priv->is_pbtl = device_property_read_bool(dev, "pbtl-mode");
+
+	memcpy(priv->supplies, sy6045s_supplies, sizeof(priv->supplies));
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(priv->supplies),
+				      priv->supplies);
+	if (ret) {
+		dev_err(dev, "failed to request supplies: %d\n", ret);
+		return ret;
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(priv->supplies),
+				    priv->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable supplies: %d\n", ret);
+		return ret;
+	}
+
+	priv->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						   GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset_gpio)) {
+		ret = PTR_ERR(priv->reset_gpio);
+		dev_err(dev, "error requesting reset_gpio: %ld\n",
+			PTR_ERR(priv->reset_gpio));
+		goto err_disable_regulators;
+	}
+
+	if (priv->reset_gpio) {
+		msleep(20);
+		gpiod_set_value(priv->reset_gpio, 1);
+		msleep(20);
+	}
+
+	priv->fault_gpio = devm_gpiod_get_optional(dev, "fault",
+						   GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->fault_gpio)) {
+		ret = PTR_ERR(priv->fault_gpio);
+		dev_err(dev, "error requesting fault gpio: %ld\n",
+			PTR_ERR(priv->fault_gpio));
+		goto err_disable_regulators;
+	}
+
+	ret = sy6045s_parse_restore_regs(priv);
+	if (ret)
+		goto err_disable_regulators;
+
+	ret = snd_soc_register_component(dev, &soc_codec_dev_sy6045s,
+					 &sy6045s_dai, 1);
+	if (ret) {
+		dev_err(dev, "Failed to register codec: %d\n", ret);
+		goto err_disable_regulators;
+	}
+
+	/*
+	 * A missing or broken settings file is not fatal: the chip keeps its
+	 * power-on defaults, exactly like the vendor driver did when no
+	 * sequence was supplied.
+	 */
+	ret = sy6045s_load_firmware(priv, priv->default_fw_name);
+	if (ret)
+		dev_warn(dev, "continuing without settings (ret=%d)\n", ret);
+
+	if (priv->is_pbtl)
+		ret = sy6045s_set_pbtl(priv);
+	else
+		ret = sy6045s_set_btl(priv);
+	if (ret)
+		dev_warn(dev, "failed to configure bridge mode: %d\n", ret);
+
+	sy6045s_set_sby_mode_on(priv);
+
+	return 0;
+
+err_disable_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(priv->supplies), priv->supplies);
+	return ret;
+}
+
+static void sy6045s_i2c_remove(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sy6045s_priv *priv = dev_get_drvdata(dev);
+
+	snd_soc_unregister_component(dev);
+
+	cancel_work_sync(&priv->spk_off_work);
+	cancel_work_sync(&priv->spk_on_work);
+
+	sy6045s_set_sby_mode_on(priv);
+	regulator_bulk_disable(ARRAY_SIZE(priv->supplies), priv->supplies);
+}
