+/*
+ * sysfs: settings/settings_file/default_settings (vendor interface).
+ */
+
+static ssize_t settings_store(struct device *dev,
+			      struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct sy6045s_priv *priv = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&priv->io_lock);
+	ret = sy6045s_apply_settings(priv, buf, count, "settings");
+	mutex_unlock(&priv->io_lock);
+
+	return ret ? ret : count;
+}
+
+static DEVICE_ATTR_WO(settings);
+
+static ssize_t settings_file_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct sy6045s_priv *priv = dev_get_drvdata(dev);
+
+	if (!priv->last_fw_name[0])
+		return 0;
+
+	return sysfs_emit(buf, "%s %*phN %u\n", priv->last_fw_name,
+			  (int)sizeof(priv->fw_md5), priv->fw_md5,
+			  priv->fw_crc);
+}
+
+static ssize_t settings_file_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct sy6045s_priv *priv = dev_get_drvdata(dev);
+	char name[256];
+	int ret;
+
+	if (sscanf(buf, "%255s", name) != 1)
+		return -EINVAL;
+
+	mutex_lock(&priv->io_lock);
+
+	ret = sy6045s_check_settings_compatibility(priv, name);
+	if (ret)
+		goto out;
+
+	ret = sy6045s_save_regs(priv);
+	if (ret)
+		goto out;
+
+	ret = sy6045s_reset_chip(priv);
+	if (ret)
+		goto out;
+
+	ret = sy6045s_load_firmware(priv, name);
+	sy6045s_restore_regs(priv);
+
+out:
+	mutex_unlock(&priv->io_lock);
+	return ret ? ret : count;
+}
+
+static DEVICE_ATTR_RW(settings_file);
+
+static ssize_t default_settings_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct sy6045s_priv *priv = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&priv->io_lock);
+
+	ret = sy6045s_save_regs(priv);
+	if (ret)
+		goto out;
+
+	ret = sy6045s_reset_chip(priv);
+	if (ret)
+		goto out;
+
+	ret = sy6045s_load_firmware(priv, priv->default_fw_name);
+	sy6045s_restore_regs(priv);
+
+out:
+	mutex_unlock(&priv->io_lock);
+	return ret ? ret : count;
+}
