From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AtriOS <atrios@localhost>
Date: Wed, 28 Oct 2026 00:00:00 +0300
Subject: [PATCH] ASoC: sy6045s: add Silergy SY6045S amplifier driver

Add an ASoC driver for the Silergy SY6045S class-D amplifier used by
the Yandex Station Max (two chips: 0x2a tweeters, 0x2b woofer).

The chip has no public datasheet, so this is a port of the vendor
4.9.113 module built with DWARF.  It keeps the vendor register map and
per-register transfer widths, the text settings format with MD5/CRC32
bookkeeping, the eight mixer control names userspace depends on, and
the speaker enable workqueue.

The settings file is optional: if firmware-name is absent or the file
cannot be loaded, probe still succeeds and the chip keeps its power-on
defaults.

Signed-off-by: AtriOS <atrios@localhost>
---
diff -Naur a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
--- a/sound/soc/codecs/Kconfig	2026-10-28 19:33:24.086938434 +0300
+++ b/sound/soc/codecs/Kconfig	2026-10-28 19:33:24.103879085 +0300
@@ -2168,6 +2168,22 @@
 config SND_SOC_STI_SAS
 	tristate "codec Audio support for STI SAS codec"
 
+config SND_SOC_SY6045S
+	tristate "Silergy SY6045S audio amplifier"
+	depends on I2C
+	depends on FW_LOADER
+	select REGMAP_I2C
+	select CRYPTO_LIB_MD5
+	help
+	  Enable support for the Silergy SY6045S class-D audio amplifier.
+	  The chip needs a vendor-generated register sequence which is
+	  loaded from /lib/firmware; the file name comes from the
+	  "firmware-name" (or legacy "firmware") device-tree property.
+	  MD5 and CRC32 of the loaded sequence are exposed through sysfs.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-soc-sy6045s.
+
 config SND_SOC_TAC5XX2_SDW
 	tristate "Texas Instruments TAC5XX2 SoundWire Smart Amplifier"
 	depends on SOUNDWIRE
diff -Naur a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
--- a/sound/soc/codecs/Makefile	2026-10-28 19:33:24.088430329 +0300
+++ b/sound/soc/codecs/Makefile	2026-10-28 19:33:24.104104884 +0300
@@ -317,6 +317,7 @@
 snd-soc-sta529-y := sta529.o
 snd-soc-stac9766-y := stac9766.o
 snd-soc-sti-sas-y := sti-sas.o
+snd-soc-sy6045s-y := sy6045s.o
 snd-soc-tac5xx2-sdw-y := tac5xx2-sdw.o
 snd-soc-tas5086-y := tas5086.o
 snd-soc-tas571x-y := tas571x.o
@@ -757,6 +758,7 @@
 obj-$(CONFIG_SND_SOC_STA529)   += snd-soc-sta529.o
 obj-$(CONFIG_SND_SOC_STAC9766)	+= snd-soc-stac9766.o
 obj-$(CONFIG_SND_SOC_STI_SAS)	+= snd-soc-sti-sas.o
+obj-$(CONFIG_SND_SOC_SY6045S)	+= snd-soc-sy6045s.o
 obj-$(CONFIG_SND_SOC_TAC5XX2_SDW)	+= snd-soc-tac5xx2-sdw.o
 obj-$(CONFIG_SND_SOC_TAS2552)	+= snd-soc-tas2552.o
 obj-$(CONFIG_SND_SOC_TAS2562)	+= snd-soc-tas2562.o
--- /dev/null
+++ b/sound/soc/codecs/sy6045s.c
@@ -0,0 +1,1150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * sy6045s.c - ASoC driver for the Silergy SY6045S audio amplifier
+ *
+ * The Yandex Station Max uses two SY6045S chips on the TDM-B bus:
+ *
+ *   0x2a  tweeters (stereo BTL, "sy6045s-tweeters-settings.txt")
+ *   0x2b  woofer   (PBTL,         "sy6045s-woofer-settings.txt")
+ *
+ * There is no public datasheet and no upstream driver.  This is a port of
+ * the vendor 4.9.113 module (which was built with full DWARF), keeping the
+ * observable interface byte-for-byte where userspace depends on it:
+ *
+ *  - regmap with reg_bits = 8, val_bits = 32, max_register = 0xff and
+ *    custom read/write callbacks.  Registers are not all one byte wide:
+ *    a 256-entry width table (sy6045s_reg_size[]) selects 1, 2, 3, 4, 6,
+ *    12, 18, 20 ... byte transfers.  Single register accesses are capped at
+ *    four bytes (the vendor did the same); longer DSP blobs only appear in
+ *    the firmware file and are written with I2C block transfers.
+ *  - the vendor text settings format:
+ *
+ *        # compatible: sy6045s
+ *        w 54 1B BD              block write, command 0x54, payload 1b bd
+ *        w 54 82 00 00 00 F0     command 0x54, payload 82 00 00 00 f0
+ *        > 11                    append one byte to the previous block
+ *
+ *    The first field is sent as the SMBus block command byte, exactly as
+ *    the vendor did.  It happens to equal the 8-bit I2C address (0x2a<<1,
+ *    0x2b<<1) but the driver never compares it with the client address;
+ *    the next field is the first payload byte (the register on the chip's
+ *    block-write interface).  MD5 and CRC32 of the whole file are computed
+ *    and reported through sysfs; the file has no trailing checksum.
+ *  - optional "silergy,restore-regs" (legacy "restore-regs") triplets
+ *    (addr, size, mask) saved before a reset and restored afterwards.
+ *  - optional "pbtl-mode".
+ *  - the eight mixer controls userspace looks up by name.
+ *  - speaker enable/disable through a workqueue toggling bit 4 of
+ *    register 0x22 (or an optional "fault" GPIO, which is what the vendor
+ *    called it).
+ *
+ * The vendor driver never fails ->probe() just because the firmware file is
+ * missing; neither does this one.  It falls back to the chip's power-on
+ * defaults and still registers the DAI and controls.
+ */
+
+#include <linux/bits.h>
+#include <linux/crc32.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/sprintf.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+
+#include <crypto/md5.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define SY6045S_MAX_REG		0xff
+#define SY6045S_MAX_XFER	4
+#define SY6045S_MAX_BLOCK	32
+
+/* Registers used directly by the driver. */
+#define SY6045S_REG_EQ		0x04
+#define SY6045S_REG_SWITCH	0x06
+#define SY6045S_REG_VOL_MASTER	0x07
+#define SY6045S_REG_VOL_CH1	0x08
+#define SY6045S_REG_VOL_CH2	0x09
+#define SY6045S_REG_RESET	0x0f
+#define SY6045S_REG_DAI_CFG	0x15
+#define SY6045S_REG_BTL		0x1e
+#define SY6045S_REG_PBTL_CFG	0x20
+#define SY6045S_REG_SPK		0x22
+#define SY6045S_REG_DRC		0x60
+
+#define SY6045S_SPK_BIT		BIT(4)
+
+struct sy6045s_reg {
+	u32 addr;
+	u32 size;
+	u32 mask;
+	u32 last_value;
+};
+
+struct sy6045s_priv {
+	struct regmap *regmap;
+	struct i2c_client *i2c;
+	struct device *dev;
+	unsigned int format;
+	const char *default_fw_name;
+	char last_fw_name[256];
+	u8 fw_md5[16];
+	u32 fw_crc;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *fault_gpio;
+	struct work_struct spk_off_work;
+	struct work_struct spk_on_work;
+	struct regulator_bulk_data supplies[2];
+	struct mutex io_lock;
+	bool is_pbtl;
+	struct sy6045s_reg *restore_regs;
+	int restore_reg_size;
+};
+
+/*
+ * Per-register transfer width, byte for byte from the vendor .rodata
+ * (symbol sy6045s_reg_size).  A zero entry means "not accessible".
+ */
+static const u8 sy6045s_reg_size[256] = {
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0x00 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0x10 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x02, 0x02, 0x01, 0x14,	/* 0x20 */
+	0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14,
+	0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14,	/* 0x30 */
+	0x14, 0x0c, 0x0c, 0x0c, 0x0c, 0x0c, 0x0c, 0x14,
+	0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14,	/* 0x40 */
+	0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x14, 0x0c,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x12, 0x12, 0x04,	/* 0x50 */
+	0x04, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03,
+	0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x02,	/* 0x60 */
+	0x01, 0x04, 0x02, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x03, 0x04, 0x01, 0x01, 0x04, 0x04, 0x04, 0x01,	/* 0x70 */
+	0x03, 0x03, 0x04, 0x01, 0x01, 0x04, 0x04, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x03, 0x03,	/* 0x80 */
+	0x03, 0x03, 0x03, 0x03, 0x04, 0x04, 0x04, 0x06,
+	0x03, 0x03, 0x04, 0x04, 0x04, 0x03, 0x03, 0x03,	/* 0x90 */
+	0x03, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0xa0 */
+	0x03, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0xb0 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x02, 0x01, 0x06,	/* 0xc0 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0xd0 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,	/* 0xe0 */
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x04, 0x04, 0x01, 0x04, 0x04, 0x04, 0x04, 0x04,	/* 0xf0 */
+};
+
+static const struct regulator_bulk_data sy6045s_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "pvdd" },
+};
+
+static inline int sy6045s_hexval(u8 c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+static inline int sy6045s_hexbyte(const u8 *p)
+{
+	int hi = sy6045s_hexval(p[0]);
+	int lo = sy6045s_hexval(p[1]);
+
+	if (hi < 0 || lo < 0)
+		return -1;
+	return (hi << 4) | lo;
+}
+
+static int sy6045s_reg_write(void *context, unsigned int reg, unsigned int val)
+{
+	struct i2c_client *client = context;
+	u8 buf[SY6045S_MAX_XFER + 1];
+	int len, i, ret;
+
+	if (reg > SY6045S_MAX_REG)
+		return -EINVAL;
+
+	len = sy6045s_reg_size[reg];
+	if (!len)
+		return -EINVAL;
+	len = min(len, SY6045S_MAX_XFER);
+
+	buf[0] = reg;
+	for (i = 0; i < len; i++)
+		buf[i + 1] = val >> (8 * (len - 1 - i));
+
+	ret = i2c_master_send(client, buf, len + 1);
+	if (ret != len + 1) {
+		dev_err(&client->dev,
+			"I2C write failed: reg=0x%02x ret=%d\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int sy6045s_reg_read(void *context, unsigned int reg, unsigned int *val)
+{
+	struct i2c_client *client = context;
+	u8 rbuf[SY6045S_MAX_XFER];
+	u8 regbuf = reg;
+	struct i2c_msg msgs[2];
+	unsigned int value = 0;
+	int len, i, ret;
+
+	if (reg > SY6045S_MAX_REG)
+		return -EINVAL;
+
+	len = sy6045s_reg_size[reg];
+	if (!len)
+		return -EINVAL;
+	len = min(len, SY6045S_MAX_XFER);
+
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = 1;
+	msgs[0].buf = &regbuf;
+
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = rbuf;
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs)) {
+		dev_err(&client->dev,
+			"failed to read i2c register: addr=0x%08x; ret=%d\n",
+			reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	for (i = 0; i < len; i++)
+		value = (value << 8) | rbuf[i];
+
+	*val = value;
+	return 0;
+}
+
+static bool sy6045s_reg_volatile(struct device *dev, unsigned int reg)
+{
+	/* The vendor marks the ID registers and the reset register volatile. */
+	return reg <= 0x02 || reg == SY6045S_REG_RESET;
+}
+
+static void sy6045s_reg_lock(void *lock_arg)
+{
+	struct sy6045s_priv *priv = lock_arg;
+
+	mutex_lock(&priv->io_lock);
+}
+
+static void sy6045s_reg_unlock(void *lock_arg)
+{
+	struct sy6045s_priv *priv = lock_arg;
+
+	mutex_unlock(&priv->io_lock);
+}
+
+static const struct regmap_config sy6045s_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 32,
+	.max_register = SY6045S_MAX_REG,
+	.reg_read = sy6045s_reg_read,
+	.reg_write = sy6045s_reg_write,
+	.volatile_reg = sy6045s_reg_volatile,
+	.lock = sy6045s_reg_lock,
+	.unlock = sy6045s_reg_unlock,
+	.cache_type = REGCACHE_NONE,
+};
+
+/*
+ * Firmware/settings handling.
+ */
+
+static int sy6045s_flush_block(struct sy6045s_priv *priv, u8 *block, int *blen)
+{
+	int ret;
+
+	if (!*blen)
+		return 0;
+
+	ret = i2c_smbus_write_i2c_block_data(priv->i2c, block[0],
+					     *blen - 1, &block[1]);
+	if (ret < 0)
+		dev_err(priv->dev,
+			"failed to write i2c register: ret=%d\n", ret);
+
+	*blen = 0;
+	return ret;
+}
+
+/*
+ * Parser for the vendor "w <addr> <reg> <data...>" format.  It follows the
+ * original state machine exactly:
+ *
+ *   - '#' and 'd' start a comment, empty lines and CRLF are ignored;
+ *   - every comment/blank line flushes the pending block write;
+ *   - "w" starts a new block, ">" appends one byte to the pending block;
+ *   - the first field is validated as two hex digits and sent as the
+ *     SMBus command byte, but never compared with the device address;
+ *   - at most 32 data bytes go into one I2C block write.
+ */
+static int sy6045s_apply_settings(struct sy6045s_priv *priv, const u8 *buf,
+				  size_t size, const char *fw_name)
+{
+	u8 block[SY6045S_MAX_BLOCK + 1];
+	int blen = 0;
+	size_t pos = 0;
+	int line = 1;
+	int ret = 0;
+
+	while (pos < size) {
+		size_t end = pos;
+		size_t len;
+		size_t i;
+
+		while (end < size && buf[end] != '\n')
+			end++;
+		len = end - pos;
+
+		if (len == 0 || buf[pos] == '#' || buf[pos] == 'd' ||
+		    (len == 1 && buf[pos] == '\r')) {
+			ret = sy6045s_flush_block(priv, block, &blen);
+			if (ret)
+				return ret;
+			goto next;
+		}
+
+		if (buf[pos] == 'w') {
+			if (blen) {
+				ret = sy6045s_flush_block(priv, block, &blen);
+				if (ret)
+					return ret;
+			}
+
+			if (len <= 9 || buf[pos + 1] != ' ' ||
+			    sy6045s_hexbyte(&buf[pos + 2]) < 0)
+				goto parse_error;
+
+			block[blen++] = sy6045s_hexbyte(&buf[pos + 2]);
+
+			for (i = 4; i < len; ) {
+				int value;
+
+				if (i + 2 < len && buf[pos + i] == ' ') {
+					value = sy6045s_hexbyte(&buf[pos + i + 1]);
+					if (value < 0)
+						goto parse_error;
+					if (blen > SY6045S_MAX_BLOCK)
+						goto parse_error;
+					block[blen++] = value;
+					i += 3;
+				} else if (i == len - 1 &&
+					   buf[pos + i] == '\r') {
+					i++;
+				} else {
+					goto parse_error;
+				}
+			}
+		} else if (buf[pos] == '>') {
+			int value;
+
+			if (!blen)
+				goto parse_error;
+			if (!(len == 4 ||
+			      (len == 5 && buf[pos + 4] == '\r')))
+				goto parse_error;
+
+			value = sy6045s_hexbyte(&buf[pos + 2]);
+			if (value < 0 || blen > SY6045S_MAX_BLOCK)
+				goto parse_error;
+			block[blen++] = value;
+		} else {
+			goto parse_error;
+		}
+
+next:
+		pos = end < size ? end + 1 : size;
+		line++;
+	}
+
+	ret = sy6045s_flush_block(priv, block, &blen);
+	if (ret)
+		return ret;
+
+	/* Bookkeeping used by the sysfs attributes.  The vendor hashes the
+	 * whole file; there is no checksum tail to parse.
+	 */
+	if (size) {
+		md5(buf, size, priv->fw_md5);
+		priv->fw_crc = ~crc32_le(~0U, buf, size);
+	}
+
+	if (fw_name) {
+		if (strscpy(priv->last_fw_name, fw_name,
+			    sizeof(priv->last_fw_name)) < 0) {
+			dev_err(priv->dev, "Cannot set last firmware name\n");
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+
+parse_error:
+	dev_err(priv->dev, "Error parsing settings at line %d\n", line);
+	return -EINVAL;
+}
+
+static int sy6045s_load_firmware(struct sy6045s_priv *priv, const char *name)
+{
+	const struct firmware *fw;
+	int ret;
+
+	if (!name)
+		return 0;
+
+	ret = request_firmware(&fw, name, priv->dev);
+	if (ret) {
+		dev_warn(priv->dev, "Can't open settings file %s : %d\n",
+			 name, ret);
+		return ret;
+	}
+
+	ret = sy6045s_apply_settings(priv, fw->data, fw->size, name);
+	release_firmware(fw);
+
+	return ret;
+}
+
+static int sy6045s_check_settings_compatibility(struct sy6045s_priv *priv,
+						const char *name)
+{
+	static const char marker[] = "# compatible: sy6045s";
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, name, priv->dev);
+	if (ret) {
+		dev_err(priv->dev, "Can't open settings file %s : %d\n",
+			name, ret);
+		return ret;
+	}
+
+	if (fw->size < sizeof(marker) - 1 ||
+	    memcmp(fw->data, marker, sizeof(marker) - 1)) {
+		dev_err(priv->dev,
+			"Settings are not compatible with amplifier\n");
+		ret = -EINVAL;
+	}
+
+	release_firmware(fw);
+	return ret;
+}
+
+/*
+ * Optional save/restore of a few registers across a chip reset.
+ */
+
+static int sy6045s_parse_restore_regs(struct sy6045s_priv *priv)
+{
+	struct device *dev = priv->dev;
+	const char *prop = "silergy,restore-regs";
+	u32 *values;
+	int count, i, ret;
+
+	count = device_property_count_u32(dev, prop);
+	if (count <= 0) {
+		prop = "restore-regs";
+		count = device_property_count_u32(dev, prop);
+	}
+	if (count <= 0) {
+		dev_info(dev, "restore registers not defined\n");
+		return 0;
+	}
+
+	if (count % 3) {
+		dev_err(dev, "wrong registers amount\n");
+		return -EINVAL;
+	}
+
+	values = devm_kcalloc(dev, count, sizeof(*values), GFP_KERNEL);
+	if (!values)
+		return -ENOMEM;
+
+	ret = device_property_read_u32_array(dev, prop, values, count);
+	if (ret) {
+		dev_err(dev, "failed to read restore regs: ret=%d\n", ret);
+		return ret;
+	}
+
+	priv->restore_reg_size = count / 3;
+	priv->restore_regs = devm_kcalloc(dev, priv->restore_reg_size,
+					  sizeof(*priv->restore_regs),
+					  GFP_KERNEL);
+	if (!priv->restore_regs)
+		return -ENOMEM;
+
+	for (i = 0; i < priv->restore_reg_size; i++) {
+		struct sy6045s_reg *entry = &priv->restore_regs[i];
+
+		entry->addr = values[i * 3];
+		entry->size = values[i * 3 + 1];
+		entry->mask = values[i * 3 + 2];
+		entry->last_value = 0;
+
+		if (entry->size > 4) {
+			dev_err(dev, "reg size too big\n");
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+static int sy6045s_save_regs(struct sy6045s_priv *priv)
+{
+	int i;
+
+	for (i = 0; i < priv->restore_reg_size; i++) {
+		struct sy6045s_reg *entry = &priv->restore_regs[i];
+		int ret;
+
+		entry->last_value = 0;
+		ret = i2c_smbus_read_i2c_block_data(priv->i2c,
+						    entry->addr & 0xff,
+						    entry->size,
+						    (u8 *)&entry->last_value);
+		if (ret < 0) {
+			dev_err(priv->dev,
+				"failed to read i2c register: addr=0x%08x; ret=%d\n",
+				entry->addr, ret);
+			return ret;
+		}
+
+		dev_info(priv->dev, "save reg: addr=0x%08x; value=0x%08x\n",
+			 entry->addr, entry->last_value);
+	}
+
+	return 0;
+}
+
+static int sy6045s_restore_regs(struct sy6045s_priv *priv)
+{
+	int i;
+
+	for (i = 0; i < priv->restore_reg_size; i++) {
+		struct sy6045s_reg *entry = &priv->restore_regs[i];
+		u32 value = 0;
+		int ret;
+
+		ret = i2c_smbus_read_i2c_block_data(priv->i2c,
+						    entry->addr & 0xff,
+						    entry->size, (u8 *)&value);
+		if (ret < 0) {
+			dev_err(priv->dev,
+				"failed to read i2c register: addr=0x%08x; ret=%d\n",
+				entry->addr, ret);
+			return ret;
+		}
+
+		value = (value & ~entry->mask) |
+			(entry->last_value & entry->mask);
+
+		ret = i2c_smbus_write_i2c_block_data(priv->i2c,
+						     entry->addr & 0xff,
+						     entry->size, (u8 *)&value);
+		if (ret < 0) {
+			dev_err(priv->dev,
+				"failed to write i2c register: ret=%d\n", ret);
+			return ret;
+		}
+
+		dev_info(priv->dev, "restore reg: addr=0x%08x; value=0x%08x\n",
+			 entry->addr, value);
+	}
+
+	return 0;
+}
+
+static int sy6045s_reset_chip(struct sy6045s_priv *priv)
+{
+	int ret;
+
+	dev_info(priv->dev, "reset chip\n");
+
+	ret = i2c_smbus_write_byte_data(priv->i2c, SY6045S_REG_RESET, 0x01);
+	if (ret < 0) {
+		dev_err(priv->dev, "Error resetting chip\n");
+		return ret;
+	}
+
+	msleep(20);
+	return 0;
+}
+
+/*
+ * Configuration that the vendor did after loading the firmware.
+ */
+
+static int sy6045s_set_btl(struct sy6045s_priv *priv)
+{
+	int ret;
+
+	ret = regmap_write(priv->regmap, SY6045S_REG_BTL, 0x05);
+	if (ret)
+		return ret;
+
+	return regmap_write(priv->regmap, SY6045S_REG_PBTL_CFG, 0x00);
+}
+
+static int sy6045s_set_pbtl(struct sy6045s_priv *priv)
+{
+	int ret;
+
+	ret = regmap_write(priv->regmap, SY6045S_REG_BTL, 0x07);
+	if (ret)
+		return ret;
+
+	return regmap_write(priv->regmap, SY6045S_REG_PBTL_CFG, 0x80);
+}
+
+static void sy6045s_set_sby_mode_on(struct sy6045s_priv *priv)
+{
+	if (priv->fault_gpio) {
+		dev_info(priv->dev, "SPK OFF (gpio)\n");
+		gpiod_set_value(priv->fault_gpio, 0);
+	} else {
+		dev_info(priv->dev, "SPK OFF (update bits)\n");
+		regmap_update_bits(priv->regmap, SY6045S_REG_SPK,
+				   SY6045S_SPK_BIT, SY6045S_SPK_BIT);
+	}
+}
+
+static void sy6045s_spk_off_work(struct work_struct *work)
+{
+	struct sy6045s_priv *priv =
+		container_of(work, struct sy6045s_priv, spk_off_work);
+
+	regmap_update_bits(priv->regmap, SY6045S_REG_SPK,
+			   SY6045S_SPK_BIT, SY6045S_SPK_BIT);
+}
+
+static void sy6045s_spk_on_work(struct work_struct *work)
+{
+	struct sy6045s_priv *priv =
+		container_of(work, struct sy6045s_priv, spk_on_work);
+
+	regmap_update_bits(priv->regmap, SY6045S_REG_SPK,
+			   SY6045S_SPK_BIT, 0);
+}
+
+/*
+ * DAI.
+ */
+
+static int sy6045s_set_dai_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct sy6045s_priv *priv =
+		snd_soc_component_get_drvdata(dai->component);
+
+	/* The vendor driver accepted every format and only used it later in
+	 * hw_params().  Keep that behaviour.
+	 */
+	priv->format = fmt;
+	return 0;
+}
+
+static int sy6045s_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct sy6045s_priv *priv =
+		snd_soc_component_get_drvdata(dai->component);
+	unsigned int val = 0;
+	bool i2s = false;
+
+	switch (priv->format & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_IF:
+		val = 0x20;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		val = 0x40;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		val = 0x60;
+		break;
+	default:
+		val = 0;
+		break;
+	}
+
+	switch (priv->format & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_RIGHT_J:
+		val |= 0x08;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		val |= 0x04;
+		break;
+	case SND_SOC_DAIFMT_I2S:
+		i2s = true;
+		break;
+	}
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		val |= 0x03;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		val |= 0x01;
+		break;
+	default:
+		break;
+	}
+
+	if (!i2s)
+		val |= 0x10;
+
+	return regmap_write(priv->regmap, SY6045S_REG_DAI_CFG, val);
+}
+
+static int sy6045s_trigger(struct snd_pcm_substream *substream, int cmd,
+			   struct snd_soc_dai *dai)
+{
+	struct sy6045s_priv *priv =
+		snd_soc_component_get_drvdata(dai->component);
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (priv->fault_gpio) {
+			dev_info(priv->dev, "SPK ON (gpio)\n");
+			gpiod_set_value(priv->fault_gpio, 1);
+		} else {
+			dev_info(priv->dev, "SPK ON (queue work)\n");
+			cancel_work_sync(&priv->spk_off_work);
+			queue_work(system_highpri_wq, &priv->spk_on_work);
+		}
+		return 0;
+
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		if (priv->fault_gpio) {
+			dev_info(priv->dev, "SPK OFF (gpio)\n");
+			gpiod_set_value(priv->fault_gpio, 0);
+		} else {
+			dev_info(priv->dev, "SPK OFF (queue work)\n");
+			cancel_work_sync(&priv->spk_on_work);
+			queue_work(system_highpri_wq, &priv->spk_off_work);
+		}
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops sy6045s_dai_ops = {
+	.set_fmt = sy6045s_set_dai_fmt,
+	.hw_params = sy6045s_hw_params,
+	.trigger = sy6045s_trigger,
+};
