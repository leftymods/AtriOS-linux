+/*
+ * Controls.  Names matter: /usr/lib/atrios/audio and the saved
+ * asound.state look them up verbatim.
+ */
+
+static const DECLARE_TLV_DB_SCALE(sy6045s_vol_tlv, -7950, 50, 1);
+static const DECLARE_TLV_DB_SCALE(sy6045s_vol_tlv_m, -12750, 50, 1);
+
+struct sy6045s_reg_switch {
+	unsigned int reg;
+	unsigned int mask;
+	unsigned int on_value;
+	unsigned int off_value;
+};
+
+static int sy6045s_reg_switch_info(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 1;
+	return 0;
+}
+
+static int sy6045s_reg_switch_get(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct sy6045s_reg_switch *sw =
+		(struct sy6045s_reg_switch *)kcontrol->private_value;
+	unsigned int val;
+
+	val = snd_soc_component_read(component, sw->reg);
+	ucontrol->value.integer.value[0] =
+		((val & sw->mask) != sw->off_value);
+
+	return 0;
+}
+
+static int sy6045s_reg_switch_put(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct sy6045s_reg_switch *sw =
+		(struct sy6045s_reg_switch *)kcontrol->private_value;
+	unsigned int value = ucontrol->value.integer.value[0] ?
+			     sw->on_value : sw->off_value;
+
+	return snd_soc_component_update_bits(component, sw->reg, sw->mask,
+					     value);
+}
+
+static const struct sy6045s_reg_switch sy6045s_drc_switch = {
+	.reg = SY6045S_REG_DRC,
+	.mask = 0x0f,
+	.on_value = 0x0f,
+	.off_value = 0x00,
+};
