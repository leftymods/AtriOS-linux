@@ -0,0 +1,1474 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic USB Burning Tool ("v2" burn protocol) gadget.
+ *
+ * The vendor BSP implements this in bl33/drivers/usb/gadget/v2_burning on top
+ * of its own DWC2 driver (v2_usb_tool/{usb_pcd,dwc_pcd}.c).  This port keeps
+ * the protocol (descriptors, vendor requests, command strings, checksums,
+ * 64 KiB packet handling) but runs it on the mainline gadget framework:
+ * the DWC2 UDC driver (drivers/usb/gadget/dwc2_udc_otg.c) plus a plain
+ * struct usb_gadget_driver, so no vendor arch/asm or mailbox code is needed.
+ *
+ * Protocol description: mainline/docs/uboot-burn.md
+ * Port notes / supported commands: mainline/docs/uboot-burn-port.md
+ *
+ * Deliberately NOT ported: the run_command() fallback of the vendor
+ * optimus_working() (that turns the USB port into a remote shell), the AMLC
+ * BootROM path (0x50/0x60, 0x01/0x02/0x05 memory pokes), key/efuse access,
+ * NAND/SD-Card/SPI media, and upload (0x33) of anything but memory and
+ * store partitions.
+ */
+
+#include <command.h>
+#include <dm.h>
+#include <dm/uclass.h>
+#include <env.h>
+#include <linux/compiler.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <stdarg.h>
+#include <linux/string.h>
+#include <linux/printk.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <stdio.h>
+#include <time.h>
+#include <vsprintf.h>
+#include <asm/byteorder.h>
+#include <linux/usb/ch9.h>
+#include <linux/usb/gadget.h>
+#include <sysreset.h>
+
+#include <aml_burn.h>
+
+#include "aml_burn_proto.h"
+
+#define AML_BURN_DEFAULT_CONNECT_MS	5000
+#define AML_BURN_EXIT_DELAY_MS		300
+
+/*
+ * "Continue:32" keepalive for slow media.  The vendor gadget sends it from a
+ * background timer (16 s / 8 MiB); this port writes synchronously from the
+ * main loop, so the ack is sent *before* a packet that is expected to be slow
+ * (the previous write took longer than SLOW_MS).  Every Continue costs the
+ * host a re-read (pyamlboot even sleeps 3 s), hence the two rate limits.
+ */
+#define AML_BURN_CONTINUE_SLOW_MS	1000
+#define AML_BURN_CONTINUE_MIN_MS	1500
+#define AML_BURN_CONTINUE_MIN_BYTES	(8 * 1024 * 1024)
+#define AML_BURN_CONTINUE_URGENT_MS	6000
+
+/* ------------------------------------------------------------------ */
+/* Descriptors								*/
+/* ------------------------------------------------------------------ */
+
+static const struct usb_device_descriptor aml_device_desc = {
+	.bLength		= USB_DT_DEVICE_SIZE,
+	.bDescriptorType	= USB_DT_DEVICE,
+	.bcdUSB			= __constant_cpu_to_le16(AML_BURN_BCD_USB),
+	.bDeviceClass		= USB_CLASS_PER_INTERFACE,
+	.bDeviceSubClass	= 0,
+	.bDeviceProtocol	= 0,
+	.bMaxPacketSize0	= AML_BURN_EP0_MPS,
+	.idVendor		= __constant_cpu_to_le16(AML_BURN_VID),
+	.idProduct		= __constant_cpu_to_le16(AML_BURN_PID),
+	.bcdDevice		= __constant_cpu_to_le16(AML_BURN_BCD_DEVICE),
+	.iManufacturer		= 0,
+	.iProduct		= 0,
+	.iSerialNumber		= 0,
+	.bNumConfigurations	= 1,
+};
+
+struct aml_burn_config {
+	struct usb_config_descriptor config;
+	struct usb_interface_descriptor intf;
+	struct usb_endpoint_descriptor ep_in;
+	struct usb_endpoint_descriptor ep_out;
+} __packed;
+
+#define AML_BURN_CONFIG(_mps)						\
+	{								\
+		.config = {						\
+			.bLength		= USB_DT_CONFIG_SIZE,	\
+			.bDescriptorType	= USB_DT_CONFIG,	\
+			.wTotalLength		=			\
+				__constant_cpu_to_le16(sizeof(struct aml_burn_config)), \
+			.bNumInterfaces		= 1,			\
+			.bConfigurationValue	= 1,			\
+			.iConfiguration		= 0,			\
+			.bmAttributes		= USB_CONFIG_ATT_ONE |	\
+						  USB_CONFIG_ATT_SELFPOWER, \
+			.bMaxPower		= 1,			\
+		},							\
+		.intf = {						\
+			.bLength		= USB_DT_INTERFACE_SIZE, \
+			.bDescriptorType	= USB_DT_INTERFACE,	\
+			.bInterfaceNumber	= 0,			\
+			.bAlternateSetting	= 0,			\
+			.bNumEndpoints		= 2,			\
+			.bInterfaceClass	= 0xff,			\
+			.bInterfaceSubClass	= 0,			\
+			.bInterfaceProtocol	= 0,			\
+			.iInterface		= 0,			\
+		},							\
+		.ep_in = {						\
+			.bLength		= USB_DT_ENDPOINT_SIZE,	\
+			.bDescriptorType	= USB_DT_ENDPOINT,	\
+			.bEndpointAddress	= AML_BURN_BULK_EP_IN,	\
+			.bmAttributes		= USB_ENDPOINT_XFER_BULK, \
+			.wMaxPacketSize		=			\
+				__constant_cpu_to_le16(_mps),		\
+			.bInterval		= 0,			\
+		},							\
+		.ep_out = {						\
+			.bLength		= USB_DT_ENDPOINT_SIZE,	\
+			.bDescriptorType	= USB_DT_ENDPOINT,	\
+			.bEndpointAddress	= AML_BURN_BULK_EP_OUT,	\
+			.bmAttributes		= USB_ENDPOINT_XFER_BULK, \
+			.wMaxPacketSize		=			\
+				__constant_cpu_to_le16(_mps),		\
+			.bInterval		= 0,			\
+		},							\
+	}
+
+static const struct aml_burn_config aml_config_hs = AML_BURN_CONFIG(AML_BURN_BULK_MPS_HS);
+static const struct aml_burn_config aml_config_fs = AML_BURN_CONFIG(AML_BURN_BULK_MPS_FS);
+
+/* Endpoint descriptors handed to usb_ep_enable(); the UDC keeps the pointer. */
+#define AML_BURN_EP_IN(_mps) {						\
+	.bLength		= USB_DT_ENDPOINT_SIZE,			\
+	.bDescriptorType	= USB_DT_ENDPOINT,			\
+	.bEndpointAddress	= AML_BURN_BULK_EP_IN,			\
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,		\
+	.wMaxPacketSize		= __constant_cpu_to_le16(_mps),		\
+	.bInterval		= 0,					\
+}
+
+#define AML_BURN_EP_OUT(_mps) {						\
+	.bLength		= USB_DT_ENDPOINT_SIZE,			\
+	.bDescriptorType	= USB_DT_ENDPOINT,			\
+	.bEndpointAddress	= AML_BURN_BULK_EP_OUT,			\
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,		\
+	.wMaxPacketSize		= __constant_cpu_to_le16(_mps),		\
+	.bInterval		= 0,					\
+}
+
+static struct usb_endpoint_descriptor aml_ep_in_hs = AML_BURN_EP_IN(AML_BURN_BULK_MPS_HS);
+static struct usb_endpoint_descriptor aml_ep_out_hs = AML_BURN_EP_OUT(AML_BURN_BULK_MPS_HS);
+static struct usb_endpoint_descriptor aml_ep_in_fs = AML_BURN_EP_IN(AML_BURN_BULK_MPS_FS);
+static struct usb_endpoint_descriptor aml_ep_out_fs = AML_BURN_EP_OUT(AML_BURN_BULK_MPS_FS);
+
+/*
+ * The tool does not ask for strings (all string indices are 0), but some
+ * hosts still request string 0 and Windows may probe 1..3.
+ */
+static const u8 aml_string_lang[] = { 4, USB_DT_STRING, 0x09, 0x04 };
+static const u8 aml_string_manuf[] = {
+	16, USB_DT_STRING, 'A', 0, 'm', 0, 'l', 0, 'o', 0, 'g', 0, 'i', 0, 'c', 0,
+};
+
+static const u8 aml_string_product[] = {
+	16, USB_DT_STRING, 'M', 0, '8', 0, '-', 0, 'C', 0, 'H', 0, 'I', 0, 'P', 0,
+};
+
+static const u8 aml_string_serial[] = {
+	18, USB_DT_STRING, '2', 0, '0', 0, '1', 0, '1', 0,
+	'0', 0, '4', 0, '0', 0, '6', 0,
+};
+
+/* ------------------------------------------------------------------ */
+/* Context								*/
+/* ------------------------------------------------------------------ */
+
+struct aml_burn {
+	struct usb_gadget *gadget;
+	struct usb_gadget_driver driver;
+
+	struct usb_ep *in_ep;
+	struct usb_ep *out_ep;
+	struct usb_request *ep0_req;
+	struct usb_request *in_req;
+	struct usb_request *out_req;
+
+	u8 *ep0_buf;		/* 512 B, EP0 data stage / command strings */
+	u8 *out_buf;		/* 64 KiB, bulk OUT slot */
+	u8 *in_buf;		/* 512 B, bulk IN replies */
+	u8 result[AML_BURN_REPLY_SZ];
+
+	bool running;
+	bool configured;
+	bool enumerated;
+	bool identified;
+	bool identify_window;
+
+	unsigned int connect_ms;
+	unsigned int identify_ms;
+	unsigned long connect_start;
+	unsigned long identify_start;
+
+	/* last EP0 request presented by the host */
+	u8 ep0_request;
+	u8 ep0_type;
+	u16 ep0_value;
+	u16 ep0_index;
+	bool ep0_out_ready;
+	u32 ep0_out_actual;
+
+	/* pending bulk OUT (0x32 data packet) */
+	bool out_ready;
+	u32 out_len;
+	u32 out_seq;
+	u32 out_sum;
+	u16 out_alg;
+	u16 out_ack;
+
+	/* pending bulk IN reply */
+	bool in_done;
+	bool exit_after_reply;
+	unsigned long exit_deadline;
+
+	/* 0x32 slow media keepalive, sent as a second bulk IN request */
+	struct usb_request *cont_req;
+	u8 *cont_buf;		/* AML_BURN_REPLY_SZ */
+	unsigned long dl_cont_ms;
+	u64 dl_bytes_since_cont;
+	u32 dl_last_write_ms;
+
+	/* 0x33 upload */
+	struct aml_burn_upload up;
+	bool up_xfer;		/* bulk IN of the current chunk is in flight */
+	bool up_ep0_done;	/* the 0x33 setup data stage is complete */
+	u32 up_chunk;		/* length announced in the 0x33 reply */
+
+	int action;
+	struct aml_burn_img img;
+};
+
+enum {
+	AML_ACT_NONE = 0,
+	AML_ACT_RESET,
+	AML_ACT_POWEROFF,
+};
+
+static struct aml_burn burn;
+
+/* ------------------------------------------------------------------ */
+/* Helpers								*/
+/* ------------------------------------------------------------------ */
+
+u32 aml_burn_add_sum(const void *data, u32 len)
+{
+	const u8 *p = data;
+	u32 sum = 0;
+	u32 i;
+
+	for (i = 0; i + 4 <= len; i += 4) {
+		u32 word;
+
+		memcpy(&word, p + i, sizeof(word));
+		sum += word;
+	}
+
+	if (i < len) {
+		u32 word = 0;
+
+		/* 1..3 trailing bytes, little endian, zero padded */
+		memcpy(&word, p + i, len - i);
+		sum += word;
+	}
+
+	return sum;
+}
+
+static int aml_split(char *line, char *argv[], int maxargs)
+{
+	int argc = 0;
+	char *p = line;
+
+	while (*p) {
+		while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
+			p++;
+		if (!*p)
+			break;
+		if (argc == maxargs)
+			break;
+		argv[argc++] = p;
+		while (*p && *p != ' ' && *p != '\t' && *p != '\r' &&
+		       *p != '\n')
+			p++;
+		if (*p)
+			*p++ = '\0';
+	}
+
+	return argc;
+}
+
+static struct usb_ep *aml_find_ep(struct usb_gadget *gadget, const char *name)
+{
+	struct usb_ep *ep;
+
+	list_for_each_entry(ep, &gadget->ep_list, ep_list) {
+		if (!strcmp(ep->name, name))
+			return ep;
+	}
+
+	return NULL;
+}
+
+static struct usb_ep *aml_autoconfig_ep(struct usb_gadget *gadget, u8 addr)
+{
+	struct usb_endpoint_descriptor desc = {
+		.bLength = USB_DT_ENDPOINT_SIZE,
+		.bDescriptorType = USB_DT_ENDPOINT,
+		.bEndpointAddress = addr & USB_DIR_IN,
+		.bmAttributes = USB_ENDPOINT_XFER_BULK,
+		.wMaxPacketSize = __constant_cpu_to_le16(AML_BURN_BULK_MPS_HS),
+	};
+	struct usb_ep *ep = usb_ep_autoconfig(gadget, &desc);
+
+	if (ep && desc.bEndpointAddress != addr) {
+		printf("aml_burn: autoconfig gave EP 0x%02x, need 0x%02x\n",
+		       desc.bEndpointAddress, addr);
+		return NULL;
+	}
+
+	return ep;
+}
+
+/* ------------------------------------------------------------------ */
+/* Gadget driver							*/
+/* ------------------------------------------------------------------ */
+
+static void aml_bulk_in_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct aml_burn *b = &burn;
+
+	if (req->status)
+		printf("aml_burn: bulk IN status %d\n", req->status);
+
+	/* Data of an upload chunk (0x33), not a command reply. */
+	if (b->up_xfer) {
+		b->up_xfer = false;
+		if (req->status) {
+			printf("aml_burn: upload aborted (%d)\n", req->status);
+			b->up.active = false;
+			return;
+		}
+		b->up.done += req->actual;
+		if (b->up.done >= b->up.total) {
+			printf("aml_burn: upload complete (0x%llx bytes)\n",
+			       (unsigned long long)b->up.done);
+			b->up.active = false;
+		}
+		return;
+	}
+
+	b->in_done = true;
+
+	if (b->exit_after_reply)
+		b->exit_deadline = get_timer(0) + AML_BURN_EXIT_DELAY_MS;
+}
+
+static void aml_bulk_out_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	burn.out_ready = true;
+}
+
+static void aml_continue_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	if (req->status)
+		printf("aml_burn: Continue:32 status %d\n", req->status);
+}
+
+/*
+ * Queue "Continue:32" ahead of the "OK!!" of a packet that is about to be
+ * written: the host reads both (the vendor sends the same two acks, one from
+ * its busy timer and one after the media write).
+ */
+static int aml_continue_reply(struct aml_burn *b)
+{
+	u32 len = min_t(u32, b->out_ack, AML_BURN_REPLY_SZ);
+
+	memset(b->cont_buf, 0, AML_BURN_REPLY_SZ);
+	memcpy(b->cont_buf, "Continue:32", 11);
+
+	b->cont_req->buf = b->cont_buf;
+	b->cont_req->length = len;
+	b->cont_req->zero = 0;
+	b->cont_req->complete = aml_continue_complete;
+
+	if (usb_ep_queue(b->in_ep, b->cont_req, GFP_ATOMIC)) {
+		printf("aml_burn: Continue:32 queue failed\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int aml_bulk_reply(const void *msg, u32 len)
+{
+	struct aml_burn *b = &burn;
+	u32 n = min_t(u32, len, AML_BURN_REPLY_SZ);
+
+	if (b->up_xfer) {
+		printf("aml_burn: reply while an upload chunk is in flight\n");
+		return -EBUSY;
+	}
+
+	memset(b->in_buf, 0, AML_BURN_REPLY_SZ);
+	if (msg && n)
+		memcpy(b->in_buf, msg, n);
+
+	b->in_done = false;
+	b->in_req->buf = b->in_buf;
+	b->in_req->length = len > AML_BURN_REPLY_SZ ? AML_BURN_REPLY_SZ : len;
+	b->in_req->zero = 0;
+	b->in_req->complete = aml_bulk_in_complete;
+
+	if (usb_ep_queue(b->in_ep, b->in_req, GFP_ATOMIC)) {
+		printf("aml_burn: bulk IN queue failed\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static void aml_fail_reply(const char *fmt, ...) __printf(1, 2);
+
+static void aml_fail_reply(const char *fmt, ...)
+{
+	char msg[AML_BURN_REPLY_SZ];
+	va_list args;
+
+	memset(msg, 0, sizeof(msg));
+	memcpy(msg, "failed:", 7);
+	va_start(args, fmt);
+	vsnprintf(msg + 7, sizeof(msg) - 7, fmt, args);
+	va_end(args);
+
+	printf("aml_burn: %s\n", msg);
+	aml_bulk_reply(msg, AML_BURN_REPLY_SZ);
+}
+
+static int aml_set_configuration(struct aml_burn *b, u16 value)
+{
+	bool hs;
+	int ret;
+
+	if (!value) {
+		usb_ep_disable(b->in_ep);
+		usb_ep_disable(b->out_ep);
+		b->configured = false;
+		return 0;
+	}
+
+	if (value != 1)
+		return -EINVAL;
+
+	if (b->configured)
+		return 0;
+
+	hs = b->gadget->speed >= USB_SPEED_HIGH;
+
+	/*
+	 * Disable first: after a bus reset the UDC has deactivated the
+	 * endpoints but usb_ep.enabled is still set.
+	 */
+	usb_ep_disable(b->in_ep);
+	usb_ep_disable(b->out_ep);
+	b->out_ready = false;
+	b->in_done = false;
+	b->up_xfer = false;
+	b->up_ep0_done = false;
+	b->up.active = false;
+
+	ret = usb_ep_enable(b->in_ep, hs ? &aml_ep_in_hs : &aml_ep_in_fs);
+	if (ret) {
+		printf("aml_burn: cannot enable EP IN (%d)\n", ret);
+		return ret;
+	}
+
+	ret = usb_ep_enable(b->out_ep, hs ? &aml_ep_out_hs : &aml_ep_out_fs);
+	if (ret) {
+		printf("aml_burn: cannot enable EP OUT (%d)\n", ret);
+		usb_ep_disable(b->in_ep);
+		return ret;
+	}
+
+	b->configured = true;
+	b->identify_start = get_timer(0);
+	b->identify_window = true;
+	printf("aml_burn: configured (%s speed, EP 0x%02x/0x%02x)\n",
+	       hs ? "high" : "full", AML_BURN_BULK_EP_IN,
+	       AML_BURN_BULK_EP_OUT);
+
+	return 0;
+}
+
+static int aml_standard_request(struct aml_burn *b,
+				const struct usb_ctrlrequest *ctrl,
+				u16 w_length, u16 w_value)
+{
+	switch (ctrl->bRequest) {
+	case USB_REQ_GET_DESCRIPTOR: {
+		u8 type = w_value >> 8;
+
+		if (!(ctrl->bRequestType & USB_DIR_IN))
+			return -EOPNOTSUPP;
+
+		switch (type) {
+		case USB_DT_DEVICE:
+			memcpy(b->ep0_buf, &aml_device_desc,
+			       sizeof(aml_device_desc));
+			return min_t(u16, w_length,
+				     sizeof(aml_device_desc));
+		case USB_DT_CONFIG:
+		case USB_DT_OTHER_SPEED_CONFIG: {
+			const struct aml_burn_config *cfg;
+			bool hs = b->gadget->speed >= USB_SPEED_HIGH;
+
+			if (type == USB_DT_OTHER_SPEED_CONFIG)
+				hs = !hs;
+			cfg = hs ? &aml_config_hs : &aml_config_fs;
+			memcpy(b->ep0_buf, cfg, sizeof(*cfg));
+			return min_t(u16, w_length, sizeof(*cfg));
+		}
+		case USB_DT_STRING: {
+			const u8 *str;
+			u8 sz;
+
+			switch (w_value & 0xff) {
+			case 0:
+				str = aml_string_lang;
+				break;
+			case 1:
+				str = aml_string_manuf;
+				break;
+			case 2:
+				str = aml_string_product;
+				break;
+			case 3:
+				str = aml_string_serial;
+				break;
+			default:
+				return -EOPNOTSUPP;
+			}
+			sz = str[0];
+			memcpy(b->ep0_buf, str, sz);
+			return min_t(u16, w_length, sz);
+		}
+		case USB_DT_DEVICE_QUALIFIER:
+			/* high speed only device, like the vendor gadget */
+			return -EOPNOTSUPP;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+
+	case USB_REQ_SET_CONFIGURATION:
+		if (ctrl->bRequestType !=
+		    (USB_DIR_OUT | USB_TYPE_STANDARD | USB_RECIP_DEVICE))
+			return -EOPNOTSUPP;
+		return aml_set_configuration(b, w_value);
+
+	case USB_REQ_GET_CONFIGURATION:
+		b->ep0_buf[0] = b->configured ? 1 : 0;
+		return min_t(u16, w_length, 1);
+
+	case USB_REQ_SET_INTERFACE:
+		return 0;
+
+	case USB_REQ_GET_INTERFACE:
+		b->ep0_buf[0] = 0;
+		return min_t(u16, w_length, 1);
+
+	case USB_REQ_GET_STATUS:
+		b->ep0_buf[0] = 0;
+		b->ep0_buf[1] = 0;
+		return min_t(u16, w_length, 2);
+
+	case USB_REQ_CLEAR_FEATURE:
+	case USB_REQ_SET_FEATURE:
+		return 0;
+
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int aml_vendor_request(struct aml_burn *b,
+			      const struct usb_ctrlrequest *ctrl,
+			      u16 w_length, u16 w_value, u16 w_index)
+{
+	b->ep0_request = ctrl->bRequest;
+	b->ep0_value = w_value;
+	b->ep0_index = w_index;
+
+	switch (ctrl->bRequest) {
+	case AM_REQ_IDENTIFY_HOST: {
+		static const u8 id[AML_BURN_IDENTIFY_LEN] = {
+			AML_BURN_ROM_VER_MAJOR,
+			AML_BURN_ROM_VER_MINOR,
+			AML_BURN_ROM_STAGE_MAJOR,
+			AML_BURN_ROM_STAGE_MINOR,
+		};
+
+		if (!(ctrl->bRequestType & USB_DIR_IN))
+			return -EOPNOTSUPP;
+
+		b->identified = true;
+		b->identify_window = false;
+		memcpy(b->ep0_buf, id, sizeof(id));
+		printf("aml_burn: ID[%d]\n", AML_BURN_ROM_STAGE_MINOR);
+
+		return min_t(u16, w_length, sizeof(id));
+	}
+
+	case AM_REQ_TPL_STAT:
+		if (!(ctrl->bRequestType & USB_DIR_IN))
+			return -EOPNOTSUPP;
+		memcpy(b->ep0_buf, b->result, AML_BURN_REPLY_SZ);
+		return min_t(u16, w_length, AML_BURN_REPLY_SZ);
+
+	case AM_REQ_UPLOAD: {
+		u32 hdr[4] = { AML_BURN_UPLOAD_MAGIC, 0, 0, 0 };
+		u32 left;
+
+		if (!(ctrl->bRequestType & USB_DIR_IN))
+			return -EOPNOTSUPP;
+
+		b->up_chunk = 0;
+		if (b->up.active) {
+			left = min_t(u64, b->up.total - b->up.done,
+				     AML_BURN_SLOT_SZ);
+			b->up_chunk = left;
+			hdr[1] = left;
+		}
+
+		memset(b->ep0_buf, 0, AML_BURN_UPLOAD_HDR_SZ);
+		memcpy(b->ep0_buf, hdr, sizeof(hdr));
+		debug("aml_burn: upload chunk 0x%x at 0x%llx\n", b->up_chunk,
+		      (unsigned long long)b->up.done);
+
+		return min_t(u16, w_length, AML_BURN_UPLOAD_HDR_SZ);
+	}
+
+	case AM_REQ_TPL_CMD:
+	case AM_REQ_BULKCMD:
+	case AM_REQ_DOWNLOAD:
+		if (ctrl->bRequestType & USB_DIR_IN)
+			return -EOPNOTSUPP;
+		if (!w_length || w_length > AML_BURN_CMD_SZ)
+			return -EOPNOTSUPP;
+		/* data stage is the command string / download descriptor */
+		return w_length;
+
+	default:
+		printf("aml_burn: unsupported vendor request 0x%02x\n",
+		       ctrl->bRequest);
+		return -EOPNOTSUPP;
+	}
+}
+
+static void aml_ep0_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct aml_burn *b = &burn;
+
+	if (req->status) {
+		printf("aml_burn: EP0 status %d (bRequest 0x%02x)\n",
+		       req->status, b->ep0_request);
+		return;
+	}
+
+	if (!(b->ep0_type & USB_DIR_IN) && b->ep0_request) {
+		b->ep0_out_actual = req->actual;
+		b->ep0_out_ready = true;
+		return;
+	}
+
+	/* 0x33: the 16 byte header is out, the bulk IN data may follow. */
+	if ((b->ep0_type & USB_DIR_IN) && b->ep0_request == AM_REQ_UPLOAD)
+		b->up_ep0_done = true;
+}
+
+static int aml_burn_setup(struct usb_gadget *gadget,
+			  const struct usb_ctrlrequest *ctrl)
+{
+	struct aml_burn *b = &burn;
+	u16 w_length = le16_to_cpu(ctrl->wLength);
+	u16 w_value = le16_to_cpu(ctrl->wValue);
+	u16 w_index = le16_to_cpu(ctrl->wIndex);
+	struct usb_request *req = b->ep0_req;
+	int value;
+
+	b->enumerated = true;
+	b->ep0_type = ctrl->bRequestType;
+	b->ep0_request = 0;
+
+	req->complete = aml_ep0_complete;
+	req->length = 0;
+	req->zero = 0;
+
+	switch (ctrl->bRequestType & USB_TYPE_MASK) {
+	case USB_TYPE_STANDARD:
+		value = aml_standard_request(b, ctrl, w_length, w_value);
+		break;
+	case USB_TYPE_VENDOR:
+		value = aml_vendor_request(b, ctrl, w_length, w_value,
+					   w_index);
+		break;
+	default:
+		value = -EOPNOTSUPP;
+		break;
+	}
+
+	if (value >= 0) {
+		req->length = value;
+		req->zero = value < w_length &&
+			    !(value % gadget->ep0->maxpacket);
+		if (usb_ep_queue(gadget->ep0, req, GFP_ATOMIC)) {
+			printf("aml_burn: EP0 queue failed (bRequest 0x%02x)\n",
+			       ctrl->bRequest);
+			return -EIO;
+		}
+	}
+
+	return value;
+}
+
+static int aml_burn_bind(struct usb_gadget *gadget)
+{
+	struct aml_burn *b = &burn;
+
+	b->gadget = gadget;
+
+	b->in_ep = aml_find_ep(gadget, "ep1in-bulk");
+	b->out_ep = aml_find_ep(gadget, "ep2out-bulk");
+
+	if (!b->in_ep || !b->out_ep) {
+		b->in_ep = aml_autoconfig_ep(gadget, AML_BURN_BULK_EP_IN);
+		b->out_ep = aml_autoconfig_ep(gadget, AML_BURN_BULK_EP_OUT);
+	}
+
+	if (!b->in_ep || !b->out_ep) {
+		printf("aml_burn: need one bulk IN (0x%02x) and one bulk OUT (0x%02x) endpoint\n",
+		       AML_BURN_BULK_EP_IN, AML_BURN_BULK_EP_OUT);
+		return -ENODEV;
+	}
+
+	b->in_ep->driver_data = b->in_ep;
+	b->out_ep->driver_data = b->out_ep;
+
+	b->ep0_req = usb_ep_alloc_request(gadget->ep0, 0);
+	b->in_req = usb_ep_alloc_request(b->in_ep, 0);
+	b->out_req = usb_ep_alloc_request(b->out_ep, 0);
+	b->cont_req = usb_ep_alloc_request(b->in_ep, 0);
+	if (!b->ep0_req || !b->in_req || !b->out_req || !b->cont_req)
+		return -ENOMEM;
+
+	b->ep0_req->buf = b->ep0_buf;
+	b->ep0_req->complete = aml_ep0_complete;
+	b->in_req->buf = b->in_buf;
+	b->in_req->complete = aml_bulk_in_complete;
+	b->out_req->buf = b->out_buf;
+	b->out_req->complete = aml_bulk_out_complete;
+
+	printf("aml_burn: bound to %s (%s, %s)\n", gadget->name,
+	       b->in_ep->name, b->out_ep->name);
+
+	return 0;
+}
+
+static void aml_burn_unbind(struct usb_gadget *gadget)
+{
+	struct aml_burn *b = &burn;
+
+	if (b->in_ep)
+		usb_ep_disable(b->in_ep);
+	if (b->out_ep)
+		usb_ep_disable(b->out_ep);
+
+	if (b->ep0_req)
+		usb_ep_free_request(gadget->ep0, b->ep0_req);
+	if (b->in_req)
+		usb_ep_free_request(b->in_ep, b->in_req);
+	if (b->out_req)
+		usb_ep_free_request(b->out_ep, b->out_req);
+	if (b->cont_req)
+		usb_ep_free_request(b->in_ep, b->cont_req);
+
+	b->ep0_req = NULL;
+	b->in_req = NULL;
+	b->out_req = NULL;
+	b->cont_req = NULL;
+}
+
+static void aml_burn_disconnect(struct usb_gadget *gadget)
+{
+	struct aml_burn *b = &burn;
+
+	usb_ep_disable(b->in_ep);
+	usb_ep_disable(b->out_ep);
+	b->configured = false;
+	b->enumerated = false;
+	b->identify_window = false;
+	b->connect_start = get_timer(0);
+	b->in_done = false;
+}
+
+static void aml_burn_reset(struct usb_gadget *gadget)
+{
+	struct aml_burn *b = &burn;
+
+	/*
+	 * A bus reset drops the configuration; disable the endpoints so that
+	 * the next SET_CONFIGURATION re-activates them in hardware too.
+	 */
+	usb_ep_disable(b->in_ep);
+	usb_ep_disable(b->out_ep);
+	b->configured = false;
+	b->in_done = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Command handling							*/
+/* ------------------------------------------------------------------ */
+
+static int aml_cmd_download(int argc, char *const argv[], char *detail,
+			    u32 detail_sz)
+{
+	struct aml_burn *b = &burn;
+	u64 size;
+	int ret;
+
+	if (argc >= 2 && !strcmp(argv[1], "get_status")) {
+		if (b->img.active && b->img.complete)
+			return 0;
+		snprintf(detail, detail_sz, "not complete");
+		return -1;
+	}
+
+	if (argc >= 2 && !strcmp(argv[1], "is_ready")) {
+		if (b->img.active && !b->img.complete)
+			return 0;
+		snprintf(detail, detail_sz, "not ready");
+		return -1;
+	}
+
+	if (argc < 5) {
+		snprintf(detail, detail_sz,
+			 "usage: download <media> <part> <type> <size>");
+		return -1;
+	}
+
+	size = simple_strtoull(argv[4], NULL, 0);
+	ret = aml_img_begin(argv[1], argv[2], argv[3], size, &b->img);
+	if (ret) {
+		snprintf(detail, detail_sz, "cannot start download for %s",
+			 argv[2]);
+		return -1;
+	}
+
+	b->dl_bytes_since_cont = 0;
+	b->dl_last_write_ms = 0;
+	b->dl_cont_ms = 0;
+	b->up.active = false;
+
+	return 0;
+}
+
+static int aml_cmd_upload(int argc, char *const argv[], char *detail,
+			  u32 detail_sz)
+{
+	u64 size;
+	int ret;
+
+	if (argc < 5) {
+		snprintf(detail, detail_sz,
+			 "usage: upload <media> <part> <type> <size>");
+		return -1;
+	}
+
+	size = simple_strtoull(argv[4], NULL, 0);
+	ret = aml_up_begin(argv[1], argv[2], argv[3], size, &burn.up);
+	if (ret) {
+		snprintf(detail, detail_sz, "cannot start upload from %s",
+			 argv[2]);
+		return -1;
+	}
+
+	return 0;
+}
+
+static int aml_cmd_verify(int argc, char *const argv[], char *detail,
+			  u32 detail_sz)
+{
+	if (argc != 3 || strcmp(argv[1], "sha1sum")) {
+		snprintf(detail, detail_sz, "usage: verify sha1sum <sha1>");
+		return -1;
+	}
+
+	if (aml_img_verify_sha1(&burn.img, argv[2])) {
+		snprintf(detail, detail_sz, "sha1sum mismatch for %s",
+			 burn.img.part);
+		return -1;
+	}
+
+	return 0;
+}
+
+static int aml_cmd_burn_complete(int argc, char *const argv[], char *detail,
+				 u32 detail_sz)
+{
+	struct aml_burn *b = &burn;
+	u32 choice;
+
+	if (argc < 2) {
+		snprintf(detail, detail_sz, "burn_complete needs a choice");
+		return -1;
+	}
+
+	choice = simple_strtoul(argv[1], NULL, 0);
+
+	switch (choice) {
+	case AML_BURN_COMPLETE_QUERY:
+		return 0;
+	case AML_BURN_COMPLETE_POWEROFF_DIRECT:
+	case AML_BURN_COMPLETE_POWEROFF_AFTER_POWERKEY:
+		b->action = AML_ACT_POWEROFF;
+		b->exit_after_reply = true;
+		return 0;
+	case AML_BURN_COMPLETE_POWEROFF_AFTER_UNPLUG:
+		/* keep the gadget alive until the cable is pulled */
+		b->action = AML_ACT_NONE;
+		return 0;
+	case AML_BURN_COMPLETE_REBOOT_NORMAL:
+	case AML_BURN_COMPLETE_REBOOT_SDC_BURN:
+	case AML_BURN_COMPLETE_REBOOT_UPDATE:
+		b->action = AML_ACT_RESET;
+		b->exit_after_reply = true;
+		return 0;
+	default:
+		snprintf(detail, detail_sz, "bad burn_complete choice %u",
+			 choice);
+		return -1;
+	}
+}
+
+/*
+ * Execute one command string from the host.  This is the port of the vendor
+ * optimus_working() minus its run_command() fallback: only the commands below
+ * exist, anything else is rejected (no remote shell).
+ */
+static int aml_cmd_exec(char *line, char *out, u32 out_sz)
+{
+	struct aml_burn *b = &burn;
+	char *argv[8];
+	char detail[160];
+	int argc, ret;
+
+	memset(out, 0, out_sz);
+	memset(detail, 0, sizeof(detail));
+
+	argc = aml_split(line, argv, ARRAY_SIZE(argv));
+	if (!argc) {
+		snprintf(out, out_sz, "failed:no command at all");
+		return -1;
+	}
+
+	if (!strcmp(argv[0], "low_power")) {
+		/*
+		 * Vendor blanks the panel and limits the current; there is no
+		 * display in U-Boot, so nothing to do.
+		 */
+		ret = 0;
+	} else if (!strcmp(argv[0], "disk_initial")) {
+		aml_store_exit();
+		ret = aml_store_init();
+		if (ret)
+			snprintf(detail, sizeof(detail),
+				 "cannot init storage (%d)", ret);
+	} else if (!strcmp(argv[0], "bootloader_is_old")) {
+		/*
+		 * Always "new": the tool then skips erase_bootloader and does
+		 * not touch the boot partition.
+		 */
+		snprintf(out, out_sz, "failed:bootloader is new");
+		return -1;
+	} else if (!strcmp(argv[0], "download")) {
+		ret = aml_cmd_download(argc, argv, detail, sizeof(detail));
+	} else if (!strcmp(argv[0], "upload")) {
+		ret = aml_cmd_upload(argc, argv, detail, sizeof(detail));
+	} else if (!strcmp(argv[0], "verify")) {
+		ret = aml_cmd_verify(argc, argv, detail, sizeof(detail));
+	} else if (!strcmp(argv[0], "save_setting")) {
+		/*
+		 * The mainline port keeps no persistent env here
+		 * (CONFIG_ENV_IS_NOWHERE), so there is nothing to save.
+		 */
+		ret = 0;
+	} else if (!strcmp(argv[0], "burn_complete")) {
+		ret = aml_cmd_burn_complete(argc, argv, detail,
+					    sizeof(detail));
+	} else if (!strcmp(argv[0], "reset")) {
+		b->action = AML_ACT_RESET;
+		b->exit_after_reply = true;
+		ret = 0;
+	} else if (!strcmp(argv[0], "poweroff")) {
+		b->action = AML_ACT_POWEROFF;
+		b->exit_after_reply = true;
+		ret = 0;
+	} else if (!strcmp(argv[0], "echo")) {
+		ret = 0;
+	} else if (!strcmp(argv[0], "erase_bootloader")) {
+		snprintf(detail, sizeof(detail),
+			 "erase_bootloader disabled (boot partition is kept)");
+		ret = -1;
+	} else {
+		snprintf(detail, sizeof(detail), "unsupported command \"%s\"",
+			 argv[0]);
+		ret = -1;
+	}
+
+	if (!ret)
+		snprintf(out, out_sz, "success");
+	else if (detail[0])
+		snprintf(out, out_sz, "failed:%s", detail);
+	else
+		snprintf(out, out_sz, "failed:");
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Protocol work (runs from the main loop, never from the ISR)		*/
+/* ------------------------------------------------------------------ */
+
+static void aml_download_begin(struct aml_burn *b, u32 len)
+{
+	struct aml_burn_write_media wm;
+	u32 data_len, seq, sum;
+	u16 alg, ack;
+
+	if (!b->img.active) {
+		aml_fail_reply("no download command pending");
+		return;
+	}
+
+	if (len < 16) {
+		aml_fail_reply("short download command (%u bytes)", len);
+		return;
+	}
+
+	memset(&wm, 0, sizeof(wm));
+	memcpy(&wm, b->ep0_buf, min_t(u32, len, sizeof(wm)));
+
+	data_len = wm.user_data_len;
+	seq = wm.sequence_no;
+	sum = wm.data_check_sum;
+
+	if (len >= 0x20) {
+		alg = wm.data_check_alg;
+		ack = wm.bulk_in_ack_len;
+	} else {
+		/* old protocol: add-sum and 512 byte acknowledgements */
+		alg = AML_CKC_ALG_ADDSUM;
+		ack = AML_BURN_REPLY_SZ;
+	}
+
+	if (!ack || ack > AML_BURN_REPLY_SZ)
+		ack = AML_BURN_REPLY_SZ;
+
+	if (!data_len || data_len > AML_BURN_SLOT_SZ) {
+		aml_fail_reply("bad packet length 0x%x", data_len);
+		return;
+	}
+
+	if (seq < b->img.next_seq) {
+		/*
+		 * Retransmission of an already accepted packet: acknowledge it
+		 * again, do not write it twice.
+		 */
+		goto queue;
+	}
+
+	if (b->img.wire + data_len > b->img.total) {
+		aml_fail_reply("packet 0x%x past end of %s (0x%llx left)",
+			       data_len, b->img.part,
+			       (unsigned long long)(b->img.total -
+						    b->img.wire));
+		return;
+	}
+
+	/*
+	 * The vendor buffer manager only accepts short packets for the last
+	 * packet of an image ("only last transfer can less 64K").
+	 */
+	if (data_len < AML_BURN_SLOT_SZ &&
+	    b->img.wire + data_len != b->img.total) {
+		aml_fail_reply("short packet 0x%x at seq %u, 0x%llx left",
+			       data_len, seq,
+			       (unsigned long long)(b->img.total -
+						    b->img.wire));
+		return;
+	}
+
+queue:
+	b->out_len = data_len;
+	b->out_seq = seq;
+	b->out_sum = sum;
+	b->out_alg = alg;
+	b->out_ack = ack;
+	b->out_ready = false;
+	b->in_done = false;
+
+	b->out_req->buf = b->out_buf;
+	b->out_req->length = data_len;
+	b->out_req->zero = 0;
+	b->out_req->complete = aml_bulk_out_complete;
+
+	if (usb_ep_queue(b->out_ep, b->out_req, GFP_ATOMIC)) {
+		printf("aml_burn: bulk OUT queue failed\n");
+		aml_fail_reply("usb queue failed");
+	}
+}
+
+static void aml_download_store(struct aml_burn *b, u32 len, bool dup)
+{
+	struct aml_burn_img *img = &b->img;
+	unsigned long start = get_timer(0);
+	int ret = 0;
+
+	if (!dup) {
+		ret = aml_img_write(img, b->out_buf, len);
+		if (!ret)
+			img->next_seq++;
+	}
+
+	b->dl_last_write_ms = (u32)(get_timer(0) - start);
+
+	if (ret) {
+		aml_fail_reply("media error %d at seq %u, len %u", ret,
+			       b->out_seq, len);
+		return;
+	}
+
+	b->dl_bytes_since_cont += len;
+	debug("aml_burn: seq %u len 0x%x%s (%u ms)\n", b->out_seq, len,
+	      dup ? " (dup)" : "", b->dl_last_write_ms);
+	aml_bulk_reply("OK!!", b->out_ack);
+}
+
+/*
+ * Decide whether this packet gets an early "Continue:32" ack.  Only worth it
+ * when the previous write was slow, and only within the rate limits described
+ * at the top of the file.
+ */
+static bool aml_continue_due(struct aml_burn *b, u32 len)
+{
+	unsigned long now = get_timer(0);
+
+	if (b->dl_last_write_ms < AML_BURN_CONTINUE_SLOW_MS)
+		return false;
+
+	if (b->dl_cont_ms &&
+	    now - b->dl_cont_ms < AML_BURN_CONTINUE_MIN_MS)
+		return false;
+
+	/*
+	 * Vendor keeps 8 MiB between two Continues; the first one of a slow
+	 * stretch is allowed right away.  If a single packet already took
+	 * longer than the host's timeout budget, ignore the byte limit: losing
+	 * the link is worse than the extra re-read.
+	 */
+	if (b->dl_bytes_since_cont &&
+	    b->dl_bytes_since_cont + len < AML_BURN_CONTINUE_MIN_BYTES &&
+	    b->dl_last_write_ms < AML_BURN_CONTINUE_URGENT_MS)
+		return false;
+
+	return true;
+}
+
+static void aml_process_download(struct aml_burn *b)
+{
+	struct aml_burn_img *img = &b->img;
+	u32 len = b->out_req->actual;
+	int status = b->out_req->status;
+	bool dup = false;
+
+	if (status) {
+		aml_fail_reply("bulk OUT status %d at seq %u", status,
+			       b->out_seq);
+		return;
+	}
+
+	if (len > b->out_len)
+		len = b->out_len;
+
+	if (b->out_alg == AML_CKC_ALG_ADDSUM) {
+		u32 gen = aml_burn_add_sum(b->out_buf, len);
+
+		if (gen != b->out_sum) {
+			aml_fail_reply("Alg[%x]0x: genSum %x != org %x at seq %x, "
+				       "len %x, resend %d", b->out_alg, gen,
+				       b->out_sum, b->out_seq, len, 0);
+			return;
+		}
+	} else if (b->out_alg != AML_CKC_ALG_NONE) {
+		aml_fail_reply("checksum algorithm 0x%x not supported",
+			       b->out_alg);
+		return;
+	}
+
+	if (b->out_seq < img->next_seq) {
+		/* retransmission of an already accepted packet */
+		dup = true;
+	} else if (b->out_seq != img->next_seq) {
+		aml_fail_reply("sequence gap: got %u, want %u (len %u)",
+			       b->out_seq, img->next_seq, len);
+		return;
+	}
+
+	/*
+	 * The media write happens synchronously, so the host would see nothing
+	 * until it is done.  Keep it alive first, then do the real work.
+	 */
+	if (!dup && aml_continue_due(b, len)) {
+		debug("aml_burn: Continue:32 before seq %u (%u ms)\n",
+		      b->out_seq, b->dl_last_write_ms);
+		if (!aml_continue_reply(b)) {
+			b->dl_bytes_since_cont = 0;
+			b->dl_cont_ms = get_timer(0);
+		}
+	}
+
+	aml_download_store(b, len, dup);
+}
+
+static void aml_process_ep0_out(struct aml_burn *b)
+{
+	u32 len = b->ep0_out_actual;
+
+	if (len > AML_BURN_CMD_SZ)
+		len = AML_BURN_CMD_SZ;
+
+	/*
+	 * The host does not NUL terminate command strings: do it, and make sure
+	 * bytes left over from an earlier request are not parsed.
+	 */
+	b->ep0_buf[min_t(u32, len, AML_BURN_CMD_SZ - 1)] = '\0';
+
+	switch (b->ep0_request) {
+	case AM_REQ_TPL_CMD:
+		if (b->ep0_index != 1) {
+			debug("aml_burn: tplcmd subcode %u ignored\n",
+			      b->ep0_index);
+			break;
+		}
+		printf("aml_burn: tplcmd[%s]\n", (char *)b->ep0_buf);
+		aml_cmd_exec((char *)b->ep0_buf, (char *)b->result,
+			     sizeof(b->result));
+		break;
+
+	case AM_REQ_BULKCMD:
+		printf("aml_burn: bulkcmd[%s]\n", (char *)b->ep0_buf);
+		aml_cmd_exec((char *)b->ep0_buf, (char *)b->result,
+			     sizeof(b->result));
+		aml_bulk_reply(b->result, AML_BURN_REPLY_SZ);
+		break;
+
+	case AM_REQ_DOWNLOAD:
+		aml_download_begin(b, len);
+		break;
+
+	default:
+		break;
+	}
+}
+
+static void aml_process_pending(struct aml_burn *b)
+{
+	if (b->ep0_out_ready) {
+		b->ep0_out_ready = false;
+		aml_process_ep0_out(b);
+	}
+
+	if (b->out_ready) {
+		b->out_ready = false;
+		aml_process_download(b);
+	}
+
+	/* 0x33 header sent, stream the announced chunk over bulk IN. */
+	if (b->up_ep0_done && !b->up_xfer) {
+		u32 chunk = b->up_chunk;
+		int ret;
+
+		b->up_ep0_done = false;
+		b->up_chunk = 0;
+
+		if (!chunk) {
+			b->up.active = false;
+			return;
+		}
+
+		ret = aml_up_read(&b->up, b->up.done, b->out_buf, chunk);
+		if (ret) {
+			printf("aml_burn: upload read failed (%d)\n", ret);
+			b->up.active = false;
+			return;
+		}
+
+		b->up_xfer = true;
+		b->in_req->buf = b->out_buf;
+		b->in_req->length = chunk;
+		b->in_req->zero = 0;
+		b->in_req->complete = aml_bulk_in_complete;
+		if (usb_ep_queue(b->in_ep, b->in_req, GFP_ATOMIC)) {
+			b->up_xfer = false;
+			printf("aml_burn: bulk IN queue failed\n");
+			b->up.active = false;
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Entry point								*/
+/* ------------------------------------------------------------------ */
+
+int aml_usb_burn_run(unsigned int connect_timeout_ms,
+		     unsigned int identify_timeout_ms)
+{
+	struct aml_burn *b = &burn;
+	struct udevice *udc;
+	int ret;
+
+	memset(b, 0, sizeof(*b));
+	b->connect_ms = connect_timeout_ms ? connect_timeout_ms :
+			AML_BURN_DEFAULT_CONNECT_MS;
+	b->identify_ms = identify_timeout_ms;
+	b->action = AML_ACT_NONE;
+
+	ret = uclass_first_device_err(UCLASS_USB_GADGET_GENERIC, &udc);
+	if (ret) {
+		printf("aml_burn: no USB device controller in the device tree (%d)\n",
+		       ret);
+		return ret;
+	}
+
+	b->ep0_buf = memalign(ARCH_DMA_MINALIGN, AML_BURN_REPLY_SZ);
+	b->out_buf = memalign(ARCH_DMA_MINALIGN, AML_BURN_SLOT_SZ);
+	b->in_buf = memalign(ARCH_DMA_MINALIGN, AML_BURN_REPLY_SZ);
+	b->cont_buf = memalign(ARCH_DMA_MINALIGN, AML_BURN_REPLY_SZ);
+	if (!b->ep0_buf || !b->out_buf || !b->in_buf || !b->cont_buf) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+
+	aml_store_exit();
+
+	b->driver.function = "aml_burn";
+	b->driver.speed = USB_SPEED_HIGH;
+	b->driver.bind = aml_burn_bind;
+	b->driver.unbind = aml_burn_unbind;
+	b->driver.setup = aml_burn_setup;
+	b->driver.disconnect = aml_burn_disconnect;
+	b->driver.reset = aml_burn_reset;
+
+	printf("aml_burn: waiting for Amlogic USB Burning Tool (VID:PID %04x:%04x, %u ms)\n",
+	       AML_BURN_VID, AML_BURN_PID, b->connect_ms);
+
+	ret = usb_gadget_register_driver(&b->driver);
+	if (ret) {
+		printf("aml_burn: cannot register gadget driver (%d)\n", ret);
+		goto out_free;
+	}
+
+	b->running = true;
+	b->connect_start = get_timer(0);
+
+	while (b->running) {
+		if (ctrlc()) {
+			printf("\naml_burn: aborted by Ctrl-C\n");
+			ret = -EINTR;
+			break;
+		}
+
+		dm_usb_gadget_handle_interrupts(udc);
+		aml_process_pending(b);
+
+		if (b->exit_after_reply && b->in_done &&
+		    (long)(get_timer(0) - b->exit_deadline) >= 0) {
+			b->running = false;
+			break;
+		}
+
+		if (!b->enumerated) {
+			if (get_timer(b->connect_start) > b->connect_ms) {
+				printf("aml_burn: no host after %u ms\n",
+				       b->connect_ms);
+				ret = -ETIMEDOUT;
+				break;
+			}
+		} else if (b->identify_window && b->identify_ms &&
+			   !b->identified) {
+			if (get_timer(b->identify_start) > b->identify_ms) {
+				printf("aml_burn: no identify request within %u ms\n",
+				       b->identify_ms);
+				ret = -ETIMEDOUT;
+				break;
+			}
+		}
+	}
+
+	usb_gadget_unregister_driver(&b->driver);
+
+	if (b->action == AML_ACT_RESET) {
+		printf("aml_burn: burn complete, rebooting\n");
+		do_reset(NULL, 0, 0, NULL);
+	} else if (b->action == AML_ACT_POWEROFF) {
+		printf("aml_burn: burn complete, powering off\n");
+		if (IS_ENABLED(CONFIG_SYSRESET))
+			sysreset_walk(SYSRESET_POWER_OFF);
+		printf("aml_burn: power off not available, halting\n");
+	}
+
+out_free:
+	free(b->ep0_buf);
+	free(b->out_buf);
+	free(b->in_buf);
+	free(b->cont_buf);
+	b->ep0_buf = NULL;
+	b->out_buf = NULL;
+	b->in_buf = NULL;
+	b->cont_buf = NULL;
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Command								*/
+/* ------------------------------------------------------------------ */
+
+static int do_aml_burn(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	unsigned int connect_ms = AML_BURN_DEFAULT_CONNECT_MS;
+	unsigned int identify_ms = 0;
+	int ret;
+
+	if (argc > 1)
+		connect_ms = simple_strtoul(argv[1], NULL, 0);
+	if (argc > 2)
+		identify_ms = simple_strtoul(argv[2], NULL, 0);
+
+	ret = aml_usb_burn_run(connect_ms, identify_ms);
+
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(aml_burn, 3, 0, do_aml_burn,
+	   "enter Amlogic USB Burning Tool (vendor burn) mode",
+	   "[connect_timeout_ms [identify_timeout_ms]]\n"
+	   "    Enumerate as 1b8e:c003 (bulk 0x81/0x02, 512 B) and speak the\n"
+	   "    Amlogic v2 burn protocol.  With no host the command returns\n"
+	   "    after connect_timeout_ms (default 5000).");
diff --git a/drivers/usb/gadget/aml_burn/aml_burn_proto.h b/drivers/usb/gadget/aml_burn/aml_burn_proto.h
new file mode 100644
index 0000000..e42aee5
--- /dev/null
+++ b/drivers/usb/gadget/aml_burn/aml_burn_proto.h
@@ -0,0 +1,219 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Amlogic USB Burning Tool ("v2" burn protocol) - internal definitions.
+ *
+ * Protocol reference: mainline/docs/uboot-burn.md (vendor sources
+ * bl33/drivers/usb/gadget/v2_burning/{v2_usb_tool,v2_common}).
+ */
+
+#ifndef __AML_BURN_PROTO_H__
+#define __AML_BURN_PROTO_H__
+
+#include <blk.h>
+#include <linux/sizes.h>
+#include <part.h>
+
+/* USB identity: the Windows tool and pyamlboot match exactly on this pair. */
+#define AML_BURN_VID			0x1b8e
+#define AML_BURN_PID			0xc003
+#define AML_BURN_BCD_DEVICE		0x0007
+#define AML_BURN_BCD_USB		0x0200
+
+#define AML_BURN_EP0_MPS		64
+#define AML_BURN_BULK_EP_IN		0x81
+#define AML_BURN_BULK_EP_OUT		0x02
+#define AML_BURN_BULK_MPS_HS		512
+#define AML_BURN_BULK_MPS_FS		64
+
+/* One bulk "slot": the host never sends more than 64 KiB per 0x32 packet. */
+#define AML_BURN_SLOT_SZ		(64 * 1024)
+/* Largest reply the protocol uses (0x31/0x34 result, 0x32 ack). */
+#define AML_BURN_REPLY_SZ		512
+/* Command string buffer, must be NUL terminated (vendor CMD_BUFF_SIZE). */
+#define AML_BURN_CMD_SZ			512
+#define AML_BURN_PART_NAME_SZ		32
+
+/* identify (0x20): {ver_major, ver_minor, stage_major, stage_minor} */
+#define AML_BURN_ROM_VER_MAJOR		0
+#define AML_BURN_ROM_VER_MINOR		7
+#define AML_BURN_ROM_STAGE_MAJOR	0
+/*
+ * 0 = IPL/BootROM, 8 = SPL, 16 = TPL (U-Boot).  Must stay 16, otherwise the
+ * tool tries to download the DDR firmware and BL2 over AMLC.
+ */
+#define AML_BURN_ROM_STAGE_MINOR	16
+#define AML_BURN_IDENTIFY_LEN		8
+
+/* Vendor requests, see vendor usb_pcd.h. */
+#define AM_REQ_WRITE_MEM		0x01
+#define AM_REQ_READ_MEM			0x02
+#define AM_REQ_FILL_MEM			0x03
+#define AM_REQ_MODIFY_MEM		0x04
+#define AM_REQ_RUN_IN_ADDR		0x05
+#define AM_REQ_WRITE_AUX		0x06
+#define AM_REQ_READ_AUX			0x07
+#define AM_REQ_WR_LARGE_MEM		0x11
+#define AM_REQ_RD_LARGE_MEM		0x12
+#define AM_REQ_IDENTIFY_HOST		0x20
+#define AM_REQ_TPL_CMD			0x30
+#define AM_REQ_TPL_STAT			0x31
+#define AM_REQ_DOWNLOAD			0x32
+#define AM_REQ_UPLOAD			0x33
+#define AM_REQ_BULKCMD			0x34
+
+/* Checksum algorithms carried in the 0x32 command block. */
+#define AML_CKC_ALG_NONE		0x00ee
+#define AML_CKC_ALG_ADDSUM		0x00ef
+#define AML_CKC_ALG_CRC32		0x00f0
+
+/*
+ * Upload (readback, 0x33): the EP0 data stage returns two u32 words, a magic
+ * and the length of the bulk IN transfer that follows, see vendor
+ * optimus_buf_manager_get_command_data_for_upload_transfer().
+ */
+#define AML_BURN_UPLOAD_MAGIC		0xefe8
+#define AML_BURN_UPLOAD_HDR_SZ		16
+
+/*
+ * AO secure configuration word (Platform:Encrypt_reg in the vendor
+ * platform.conf, bit 4 = secure boot).  It sits behind the secure APB, a
+ * plain read aborts the bus, so the upload path reports zero ("not secure").
+ */
+#define AML_BURN_SECURE_REG		0xff800228
+
+/* burn_complete choices, see vendor optimus_download.h. */
+#define AML_BURN_COMPLETE_POWEROFF_DIRECT	0x00
+#define AML_BURN_COMPLETE_REBOOT_NORMAL		0x01
+#define AML_BURN_COMPLETE_POWEROFF_AFTER_POWERKEY 0x02
+#define AML_BURN_COMPLETE_POWEROFF_AFTER_UNPLUG	0x03
+#define AML_BURN_COMPLETE_REBOOT_SDC_BURN	0xdc
+#define AML_BURN_COMPLETE_REBOOT_UPDATE		0xeb
+#define AML_BURN_COMPLETE_QUERY			0xe1
+
+/*
+ * Command block of the "new protocol" 0x32 request (EP0 OUT data, 32 bytes,
+ * packed to 4).  Older hosts send no algorithm/ack length: they use ADDSUM
+ * and 512 byte acknowledgements.
+ */
+struct aml_burn_write_media {
+	u32 retry_times;
+	u32 user_data_len;	/* bytes of bulk OUT data that follows */
+	u32 sequence_no;	/* packet number, starts at 0 for every image */
+	u32 data_check_sum;
+	u16 data_check_alg;
+	u16 bulk_in_ack_len;
+	u8 reserved[12];
+} __packed;
+
+enum aml_burn_img_kind {
+	AML_IMG_NONE = 0,
+	AML_IMG_NORMAL,		/* raw partition image */
+	AML_IMG_DTB,		/* _aml_dtb / dtb partition */
+	AML_IMG_BOOTLOADER,	/* FIP (BL2+BL33), streamed to "bootloader" */
+	AML_IMG_SPARSE,		/* AOSP sparse image */
+};
+
+/* Streaming AOSP sparse decoder state. */
+enum aml_burn_sparse_stage {
+	AML_SPARSE_FILE_HDR = 0,
+	AML_SPARSE_CHUNK_HDR,
+	AML_SPARSE_RAW,
+	AML_SPARSE_FILL_PAT,
+	AML_SPARSE_CRC,
+};
+
+struct aml_burn_sparse {
+	u8 stage;
+	u32 blk_sz;
+	u32 total_chunks;
+	u32 chunks_done;
+	u32 chunk_type;
+	u64 out_off;		/* byte offset in the expanded image */
+	u32 out_left;		/* bytes of the current chunk still to emit */
+	u8 fill[4];
+	u8 carry[32];		/* header/fill bytes spanning packets */
+	u32 carry_len;
+	u32 need;		/* bytes `carry' has to collect, 0 = none */
+};
+
+struct aml_burn_img {
+	bool active;
+	bool complete;
+	bool failed;
+	int kind;
+	char part[AML_BURN_PART_NAME_SZ];
+	char type[16];
+	u64 total;		/* image size announced by the host */
+	u64 wire;		/* bytes accepted from the host so far */
+	u32 next_seq;		/* next expected 0x32 sequence number */
+	u64 media_off;		/* bytes written (normal images) */
+	struct aml_burn_sparse sparse;
+};
+
+/* Readback (0x33): where the bytes the host asks for come from. */
+enum aml_upload_kind {
+	AML_UP_NONE = 0,
+	AML_UP_MEM,		/* `upload mem <addr> ...' */
+	AML_UP_STORE,		/* `upload store <part> ...' */
+};
+
+struct aml_burn_upload {
+	bool active;
+	int kind;
+	u64 addr;		/* AML_UP_MEM: first byte to read */
+	u64 total;		/* bytes requested by the host */
+	u64 done;		/* bytes already sent */
+};
+
+/*
+ * Amlogic factory partition table ("MPT", vendor struct ptbl_rsv in
+ * drivers/mmc/aml_emmc_partition.c).  It lives at the start of the inherent
+ * "reserved" partition, i.e. 4 MiB (bootloader) + 32 MiB (gap) = 36 MiB.
+ * Entries carry names and sizes only; the offsets are derived from the sizes
+ * and the 8 MiB gap between partitions, exactly like the vendor does in
+ * _calculate_offset().
+ */
+#define AML_PTBL_MAX_PARTS	32
+#define AML_PTBL_MAGIC		"MPT"
+#define AML_PTBL_VERSION_1	"01.00.00"
+#define AML_PTBL_VERSION_2	"01.02.00"
+#define AML_PTBL_BOOT_SIZE	(4 * SZ_1M)
+#define AML_PTBL_BOOT_GAP	(32 * SZ_1M)
+#define AML_PTBL_OFFSET		(AML_PTBL_BOOT_SIZE + AML_PTBL_BOOT_GAP)
+#define AML_PTBL_GAP		(8 * SZ_1M)
+#define AML_PTBL_NAME_SZ	16
+/* sizeof(struct aml_ptbl) == 1304, rounded up to whole sectors */
+#define AML_PTBL_READ_SZ	2048
+
+struct aml_ptbl_entry {
+	u8 name[AML_PTBL_NAME_SZ];
+	u64 size;		/* bytes, ~0ull = "rest of the device" */
+	u64 offset;		/* computed, the stored value is ignored */
+	u32 mask_flags;
+	u32 reserved;		/* tail padding of the vendor struct */
+};
+
+struct aml_ptbl {
+	u8 magic[4];
+	u8 version[12];
+	u32 count;
+	u32 checksum;
+	struct aml_ptbl_entry part[AML_PTBL_MAX_PARTS];
+};
+
+/* aml_burn_storage.c */
+int aml_store_init(void);
+void aml_store_exit(void);
+int aml_store_select(const char *name);
+int aml_img_begin(const char *media, const char *part, const char *type,
+		  u64 size, struct aml_burn_img *img);
+int aml_img_write(struct aml_burn_img *img, const u8 *data, u32 len);
+int aml_img_verify_sha1(const struct aml_burn_img *img, const char *hex);
+int aml_up_begin(const char *media, const char *part, const char *type,
+		 u64 size, struct aml_burn_upload *up);
+int aml_up_read(struct aml_burn_upload *up, u64 off, u8 *buf, u32 len);
+
+/* aml_burn.c, shared with the validators in the protocol code */
+u32 aml_burn_add_sum(const void *data, u32 len);
+
+#endif /* __AML_BURN_PROTO_H__ */
diff --git a/drivers/usb/gadget/aml_burn/aml_burn_storage.c b/drivers/usb/gadget/aml_burn/aml_burn_storage.c
new file mode 100644
index 0000000..15d2526
--- /dev/null
+++ b/drivers/usb/gadget/aml_burn/aml_burn_storage.c
@@ -0,0 +1,923 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic USB Burning Tool ("v2" burn protocol) - storage backend.
+ *
+ * Replaces the vendor "store" layer (store_write_ops()/store_boot_write()/
+ * store_dtb_rw(), which speak the Amlogic proprietary partition table) with
+ * the mainline block layer: blk_dwrite()/blk_dread() on a partition looked up
+ * by name with part_get_info_by_name().
+ *
+ * Devices that still carry the vendor (raw "store") partition table do not
+ * expose a GPT/MBR, so the vendor "MPT" table is parsed from the start of the
+ * inherent "reserved" partition (byte offset 36 MiB) and, as a last resort, an
+ * environment override is used:
+ *
+ *	aml_burn_part_<name>=<start>:<size>	(units of blk_desc->blksz)
+ *
+ * e.g. aml_burn_part_boot=0x800:0x20000.  See docs/uboot-burn-port.md.
+ */
+
+#include <blk.h>
+#include <env.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/printk.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <part.h>
+#include <sparse_format.h>
+#include <u-boot/sha1.h>
+#include <vsprintf.h>
+
+#include "aml_burn_proto.h"
+
+#define AML_BURN_SHA1_CHUNK	AML_BURN_SLOT_SZ
+
+static struct blk_desc *store_desc;
+static struct disk_partition store_part;
+static bool store_part_valid;
+static char store_part_name[AML_BURN_PART_NAME_SZ];
+
+static u8 *store_wr_bounce;	/* AML_BURN_SLOT_SZ, DMA aligned */
+static u8 *store_rd_bounce;	/* AML_BURN_SLOT_SZ, DMA aligned */
+
+/* Vendor partition table, parsed once per storage (re-read on disk_initial). */
+static struct aml_ptbl store_ptbl;
+static bool store_ptbl_valid;
+static u8 store_ptbl_buf[AML_PTBL_READ_SZ] __aligned(ARCH_DMA_MINALIGN);
+
+static u64 store_part_bytes(void)
+{
+	if (!store_part_valid)
+		return 0;
+
+	return (u64)store_part.size * store_part.blksz;
+}
+
+int aml_store_init(void)
+{
+	const char *ifname = env_get("aml_burn_ifname");
+	const char *devstr = env_get("aml_burn_dev");
+	struct blk_desc *desc = NULL;
+	int ret;
+
+	if (!ifname)
+		ifname = "mmc";
+	if (!devstr)
+		devstr = "0";
+
+	ret = blk_get_device_by_str(ifname, devstr, &desc);
+	if (ret || !desc) {
+		printf("aml_burn: no block device %s %s (ret=%d)\n",
+		       ifname, devstr, ret);
+		return ret ? ret : -ENODEV;
+	}
+
+	store_desc = desc;
+
+	if (!store_wr_bounce) {
+		store_wr_bounce = memalign(ARCH_DMA_MINALIGN,
+					   AML_BURN_SLOT_SZ);
+		store_rd_bounce = memalign(ARCH_DMA_MINALIGN,
+					   AML_BURN_SLOT_SZ);
+		if (!store_wr_bounce || !store_rd_bounce)
+			return -ENOMEM;
+	}
+
+	printf("aml_burn: storage %s %s: %llu x %lu B\n", ifname, devstr,
+	       (unsigned long long)desc->lba,
+	       (unsigned long)desc->blksz);
+
+	return 0;
+}
+
+void aml_store_exit(void)
+{
+	store_part_valid = false;
+	store_part_name[0] = '\0';
+	store_ptbl_valid = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Amlogic factory ("MPT") partition table				*/
+/* ------------------------------------------------------------------ */
+
+/*
+ * Vendor checksum, version 1 has the bug the tables on the media were
+ * generated with: it sums the first entry `count' times.  Do not fix it, the
+ * stored value was computed the buggy way (see _calc_iptbl_check_v1()).
+ */
+static u32 ptbl_checksum(const struct aml_ptbl *t, int version)
+{
+	const u32 *p = (const u32 *)t->part;
+	u32 sum = 0;
+	int i, j;
+
+	if (version == 2) {
+		for (i = 0; i < (int)t->count *
+			     (int)(sizeof(struct aml_ptbl_entry) / 4); i++)
+			sum += p[i];
+		return sum;
+	}
+
+	for (i = 0; i < (int)t->count; i++)
+		for (j = 0; j < (int)(sizeof(struct aml_ptbl_entry) / 4); j++)
+			sum += p[j];
+
+	return sum;
+}
+
+/*
+ * Offsets are not stored: the vendor derives them from the sizes, with a
+ * 32 MiB gap after "bootloader" and 8 MiB between the other partitions.  A
+ * size of ~0ull means "everything up to the end of the device".
+ */
+static int ptbl_offsets(struct aml_ptbl *t, u64 capacity)
+{
+	u64 gap = AML_PTBL_BOOT_GAP;
+	u64 end;
+	int i;
+
+	t->part[0].offset = 0;
+	if (memcmp(t->part[0].name, "bootloader", sizeof("bootloader")))
+		gap = AML_PTBL_GAP;
+
+	for (i = 1; i < (int)t->count; i++) {
+		struct aml_ptbl_entry *p = &t->part[i];
+
+		p->offset = t->part[i - 1].offset + t->part[i - 1].size + gap;
+		end = p->offset + p->size;
+		if (p->size == ~0ULL || end < p->offset || end > capacity) {
+			if (p->offset >= capacity)
+				return -EINVAL;
+			p->size = capacity - p->offset;
+			t->count = i + 1;
+			break;
+		}
+		gap = AML_PTBL_GAP;
+	}
+
+	return 0;
+}
+
+static int ptbl_parse(struct blk_desc *desc)
+{
+	struct aml_ptbl *t = (struct aml_ptbl *)store_ptbl_buf;
+	u64 capacity = (u64)desc->lba * desc->blksz;
+	lbaint_t blk;
+	u32 blocks;
+	int version, i;
+
+	if (capacity < AML_PTBL_OFFSET + sizeof(*t)) {
+		debug("aml_burn: eMMC too small for an Amlogic table\n");
+		return -ENOSPC;
+	}
+
+	blk = AML_PTBL_OFFSET / desc->blksz;
+	blocks = DIV_ROUND_UP(sizeof(*t), desc->blksz);
+	if (blk_dread(desc, blk, blocks, store_ptbl_buf) != blocks) {
+		printf("aml_burn: cannot read the Amlogic partition table\n");
+		return -EIO;
+	}
+
+	if (memcmp(t->magic, AML_PTBL_MAGIC, sizeof(AML_PTBL_MAGIC))) {
+		debug("aml_burn: no Amlogic partition table (%4.4s)\n",
+		      t->magic);
+		return -ENOENT;
+	}
+
+	if (!memcmp(t->version, AML_PTBL_VERSION_1, 8)) {
+		version = 1;
+	} else if (!memcmp(t->version, AML_PTBL_VERSION_2, 8)) {
+		version = 2;
+	} else {
+		printf("aml_burn: unsupported Amlogic table version %8.8s\n",
+		       t->version);
+		return -ENOENT;
+	}
+
+	if (!t->count || t->count > AML_PTBL_MAX_PARTS) {
+		printf("aml_burn: bad Amlogic table partition count %u\n",
+		       t->count);
+		return -EINVAL;
+	}
+
+	if (ptbl_checksum(t, version) != t->checksum) {
+		printf("aml_burn: Amlogic table checksum mismatch (0x%x != 0x%x)\n",
+		       ptbl_checksum(t, version), t->checksum);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < (int)t->count; i++) {
+		if (!memchr(t->part[i].name, '\0', AML_PTBL_NAME_SZ)) {
+			printf("aml_burn: Amlogic table entry %d has no name\n",
+			       i);
+			return -EINVAL;
+		}
+	}
+
+	if (ptbl_offsets(t, capacity))
+		return -EINVAL;
+
+	memcpy(&store_ptbl, t, sizeof(store_ptbl));
+	printf("aml_burn: Amlogic partition table v%d, %u partitions\n",
+	       version, store_ptbl.count);
+
+	return 0;
+}
+
+static int store_select_ptbl(const char *name)
+{
+	struct blk_desc *desc = store_desc;
+	int i;
+
+	if (!store_ptbl_valid) {
+		if (ptbl_parse(desc))
+			return -ENOENT;
+		store_ptbl_valid = true;
+	}
+
+	for (i = 0; i < (int)store_ptbl.count; i++) {
+		const struct aml_ptbl_entry *p = &store_ptbl.part[i];
+
+		if (strncmp((const char *)p->name, name, AML_PTBL_NAME_SZ))
+			continue;
+
+		memset(&store_part, 0, sizeof(store_part));
+		store_part.start = p->offset / desc->blksz;
+		store_part.size = p->size / desc->blksz;
+		store_part.blksz = desc->blksz;
+		strlcpy((char *)store_part.name, name, sizeof(store_part.name));
+
+		printf("aml_burn: partition %s from Amlogic table: 0x%llx+0x%llx\n",
+		       name, (unsigned long long)p->offset,
+		       (unsigned long long)p->size);
+
+		return 0;
+	}
+
+	return -ENOENT;
+}
+
+/* Partition lookup by name, with the env override for unknown layouts. */
+static int store_select_env(const char *name)
+{
+	char var[64];
+	const char *val;
+	char *end;
+	u64 start, size;
+
+	snprintf(var, sizeof(var), "aml_burn_part_%s", name);
+	val = env_get(var);
+	if (!val)
+		return -ENOENT;
+
+	start = simple_strtoull(val, &end, 0);
+	if (end == val || *end != ':')
+		return -EINVAL;
+	size = simple_strtoull(end + 1, &end, 0);
+	if (end == val || size == 0)
+		return -EINVAL;
+
+	memset(&store_part, 0, sizeof(store_part));
+	store_part.start = start;
+	store_part.size = size;
+	store_part.blksz = store_desc->blksz;
+	strlcpy((char *)store_part.name, name, sizeof(store_part.name));
+
+	printf("aml_burn: partition %s from %s: %llu+%llu blocks\n", name,
+	       var, (unsigned long long)start, (unsigned long long)size);
+
+	return 0;
+}
+
+int aml_store_select(const char *name)
+{
+	int ret;
+
+	if (!name || !*name || strlen(name) >= AML_BURN_PART_NAME_SZ)
+		return -EINVAL;
+
+	if (!store_desc) {
+		ret = aml_store_init();
+		if (ret)
+			return ret;
+	}
+
+	ret = part_get_info_by_name(store_desc, name, &store_part);
+	if (ret < 0)
+		ret = store_select_ptbl(name);
+	if (ret < 0)
+		ret = store_select_env(name);
+	if (ret) {
+		printf("aml_burn: partition \"%s\" not found (no GPT/MBR, no Amlogic table entry; set aml_burn_part_%s)\n",
+		       name, name);
+	}
+
+	if (ret < 0) {
+		store_part_valid = false;
+		return -ENOENT;
+	}
+
+	store_part_valid = true;
+	strlcpy(store_part_name, name, sizeof(store_part_name));
+	printf("aml_burn: partition %s: start 0x%llx, %llu blocks of %lu B\n",
+	       name, (unsigned long long)store_part.start,
+	       (unsigned long long)store_part.size,
+	       (unsigned long)store_part.blksz);
+
+	return 0;
+}
+
+/*
+ * Read/write `len' bytes at byte offset `off' inside the selected partition.
+ * Writes are split so that every DMA buffer handed to the block layer is
+ * cache line aligned.
+ */
+static int store_write(u64 off, const u8 *data, u32 len)
+{
+	struct blk_desc *desc = store_desc;
+	u32 blksz = store_part.blksz;
+	lbaint_t blk;
+	u32 head;
+	const u8 *src = data;
+
+	if (!store_part_valid || !desc)
+		return -ENODEV;
+	if (!len)
+		return 0;
+	if (off + len > store_part_bytes()) {
+		printf("aml_burn: write 0x%llx+0x%x outside partition %s (0x%llx B)\n",
+		       (unsigned long long)off, len, store_part_name,
+		       (unsigned long long)store_part_bytes());
+		return -ENOSPC;
+	}
+
+	blk = store_part.start + off / blksz;
+	head = off % blksz;
+
+	if (head) {
+		u32 n = min_t(u32, len, blksz - head);
+
+		if (blk_dread(desc, blk, 1, store_wr_bounce) != 1)
+			return -EIO;
+		memcpy(store_wr_bounce + head, src, n);
+		if (blk_dwrite(desc, blk, 1, store_wr_bounce) != 1)
+			return -EIO;
+		src += n;
+		len -= n;
+		blk++;
+	}
+
+	while (len) {
+		u32 chunk = min_t(u32, len, AML_BURN_SLOT_SZ);
+		u32 blocks = chunk / blksz;
+		const u8 *buf;
+
+		if (blocks) {
+			u32 nbytes = blocks * blksz;
+
+			if ((unsigned long)src % ARCH_DMA_MINALIGN) {
+				memcpy(store_wr_bounce, src, nbytes);
+				buf = store_wr_bounce;
+			} else {
+				buf = src;
+			}
+			if (blk_dwrite(desc, blk, blocks, buf) != blocks)
+				return -EIO;
+			src += nbytes;
+			len -= nbytes;
+			blk += blocks;
+			continue;
+		}
+
+		/* trailing partial block: read-modify-write */
+		if (blk_dread(desc, blk, 1, store_wr_bounce) != 1)
+			return -EIO;
+		memcpy(store_wr_bounce, src, len);
+		if (blk_dwrite(desc, blk, 1, store_wr_bounce) != 1)
+			return -EIO;
+		len = 0;
+	}
+
+	return 0;
+}
+
+static int store_read(u64 off, u8 *data, u32 len)
+{
+	struct blk_desc *desc = store_desc;
+	u32 blksz = store_part.blksz;
+	lbaint_t blk;
+	u32 head;
+
+	if (!store_part_valid || !desc)
+		return -ENODEV;
+	if (!len)
+		return 0;
+	if (off + len > store_part_bytes())
+		return -ENOSPC;
+
+	blk = store_part.start + off / blksz;
+	head = off % blksz;
+
+	if (head) {
+		u32 n = min_t(u32, len, blksz - head);
+
+		if (blk_dread(desc, blk, 1, store_wr_bounce) != 1)
+			return -EIO;
+		memcpy(data, store_wr_bounce + head, n);
+		data += n;
+		len -= n;
+		blk++;
+	}
+
+	while (len) {
+		u32 blocks = min_t(u32, len / blksz,
+				   AML_BURN_SLOT_SZ / blksz);
+
+		if (!blocks) {
+			if (blk_dread(desc, blk, 1, store_wr_bounce) != 1)
+				return -EIO;
+			memcpy(data, store_wr_bounce, len);
+			len = 0;
+			break;
+		}
+
+		if (blk_dread(desc, blk, blocks, store_rd_bounce) != blocks)
+			return -EIO;
+		memcpy(data, store_rd_bounce, blocks * blksz);
+		data += blocks * blksz;
+		len -= blocks * blksz;
+		blk += blocks;
+	}
+
+	return 0;
+}
+
+static int store_write_fill(u64 off, const u8 *pattern, u32 len)
+{
+	u32 i;
+
+	for (i = 0; i + 4 <= AML_BURN_SLOT_SZ; i += 4)
+		memcpy(store_wr_bounce + i, pattern, 4);
+
+	while (len) {
+		u32 chunk = min_t(u32, len, AML_BURN_SLOT_SZ);
+		int ret;
+
+		ret = store_write(off, store_wr_bounce, chunk);
+		if (ret)
+			return ret;
+		off += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* AOSP sparse streaming decoder					*/
+/* ------------------------------------------------------------------ */
+
+static void sparse_need_hdr(struct aml_burn_sparse *s, u8 stage, u32 need)
+{
+	s->stage = stage;
+	s->need = need;
+	s->carry_len = 0;
+}
+
+static int sparse_stage_done(struct aml_burn_img *img)
+{
+	struct aml_burn_sparse *s = &img->sparse;
+	u16 type;
+	u32 csz, out_bytes;
+
+	switch (s->stage) {
+	case AML_SPARSE_FILE_HDR:
+	{
+		u16 hdr_sz = 0, chunk_sz = 0;
+
+		if (s->carry_len < 28)
+			return -EINVAL;
+		{
+			u32 magic;
+
+			memcpy(&magic, s->carry, 4);
+			if (magic != SPARSE_HEADER_MAGIC) {
+				printf("aml_burn: not a sparse image (magic 0x%08x)\n",
+				       magic);
+				return -EINVAL;
+			}
+			memcpy(&s->blk_sz, s->carry + 12, 4);
+			memcpy(&s->total_chunks, s->carry + 20, 4);
+			memcpy(&hdr_sz, s->carry + 8, 2);
+			memcpy(&chunk_sz, s->carry + 10, 2);
+		}
+		if (hdr_sz != 28 || chunk_sz != 12) {
+			printf("aml_burn: unsupported sparse header sizes %u/%u\n",
+			       hdr_sz, chunk_sz);
+			return -EINVAL;
+		}
+		if (!s->blk_sz || (s->blk_sz & 3) ||
+		    s->blk_sz < store_part.blksz ||
+		    (s->blk_sz % store_part.blksz)) {
+			printf("aml_burn: unsupported sparse block size %u\n",
+			       s->blk_sz);
+			return -EINVAL;
+		}
+		printf("aml_burn: sparse image, block size %u, %u chunks\n",
+		       s->blk_sz, s->total_chunks);
+		sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+		return 0;
+	}
+
+	case AML_SPARSE_CHUNK_HDR:
+		memcpy(&type, s->carry, 2);
+		memcpy(&csz, s->carry + 4, 4);
+		out_bytes = csz * s->blk_sz;
+		s->chunks_done++;
+
+		if (s->out_off + out_bytes > store_part_bytes()) {
+			printf("aml_burn: sparse chunk %u out of partition\n",
+			       s->chunks_done);
+			return -ENOSPC;
+		}
+
+		switch (type) {
+		case CHUNK_TYPE_RAW:
+			s->chunk_type = type;
+			s->need = 0;
+			s->carry_len = 0;
+			if (!out_bytes) {
+				sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+				return 0;
+			}
+			s->out_left = out_bytes;
+			s->stage = AML_SPARSE_RAW;
+			return 0;
+		case CHUNK_TYPE_FILL:
+			s->chunk_type = type;
+			if (!out_bytes) {
+				sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+				return 0;
+			}
+			s->out_left = out_bytes;
+			sparse_need_hdr(s, AML_SPARSE_FILL_PAT, 4);
+			return 0;
+		case CHUNK_TYPE_DONT_CARE:
+			s->out_off += out_bytes;
+			sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+			return 0;
+		case CHUNK_TYPE_CRC32:
+			sparse_need_hdr(s, AML_SPARSE_CRC, 4);
+			return 0;
+		default:
+			printf("aml_burn: unknown sparse chunk type 0x%04x\n",
+			       type);
+			return -EINVAL;
+		}
+
+	case AML_SPARSE_FILL_PAT:
+	{
+		int ret;
+
+		memcpy(s->fill, s->carry, 4);
+		ret = store_write_fill(s->out_off, s->fill, s->out_left);
+		if (ret)
+			return ret;
+		s->out_off += s->out_left;
+		s->out_left = 0;
+		sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+		return 0;
+	}
+
+	case AML_SPARSE_CRC:
+		/* CRC32 chunk: validated by the packer, not needed here */
+		sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sparse_feed(struct aml_burn_img *img, const u8 *data, u32 len)
+{
+	struct aml_burn_sparse *s = &img->sparse;
+
+	while (len) {
+		if (s->need) {
+			u32 n = min_t(u32, len, s->need - s->carry_len);
+			int ret;
+
+			memcpy(s->carry + s->carry_len, data, n);
+			s->carry_len += n;
+			data += n;
+			len -= n;
+			if (s->carry_len < s->need)
+				break;
+			ret = sparse_stage_done(img);
+			if (ret)
+				return ret;
+			continue;
+		}
+
+		if (s->stage == AML_SPARSE_RAW && s->out_left) {
+			u32 n = min_t(u32, len, s->out_left);
+			int ret;
+
+			ret = store_write(s->out_off, data, n);
+			if (ret)
+				return ret;
+			s->out_off += n;
+			s->out_left -= n;
+			data += n;
+			len -= n;
+			if (!s->out_left)
+				sparse_need_hdr(s, AML_SPARSE_CHUNK_HDR, 12);
+			continue;
+		}
+
+		printf("aml_burn: sparse stream desync at 0x%llx\n",
+		       (unsigned long long)img->wire);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Image handling							*/
+/* ------------------------------------------------------------------ */
+
+static int img_kind(const char *part, const char *type)
+{
+	if (!strcmp(type, "sparse"))
+		return AML_IMG_SPARSE;
+	if (!strcmp(part, "bootloader") || !strcmp(type, "bootloader"))
+		return AML_IMG_BOOTLOADER;
+	if (!strcmp(part, "_aml_dtb") || !strcmp(type, "dtb"))
+		return AML_IMG_DTB;
+	if (!strcmp(type, "normal"))
+		return AML_IMG_NORMAL;
+
+	return -EINVAL;
+}
+
+int aml_img_begin(const char *media, const char *part, const char *type,
+		  u64 size, struct aml_burn_img *img)
+{
+	int kind, ret;
+
+	memset(img, 0, sizeof(*img));
+
+	if (strcmp(media, "store")) {
+		printf("aml_burn: media \"%s\" not supported (only store)\n",
+		       media);
+		return -ENOTSUPP;
+	}
+
+	kind = img_kind(part, type);
+	if (kind < 0) {
+		printf("aml_burn: image type \"%s\" not supported\n", type);
+		return -ENOTSUPP;
+	}
+
+	if (!size) {
+		printf("aml_burn: bad image size 0x%llx\n",
+		       (unsigned long long)size);
+		return -EINVAL;
+	}
+
+	ret = aml_store_select(part);
+	if (ret == -ENOENT && kind == AML_IMG_DTB && !strcmp(part, "_aml_dtb"))
+		ret = aml_store_select("dtb");
+	if (ret)
+		return ret;
+
+	/* Sparse input is not comparable with the partition size. */
+	if (kind != AML_IMG_SPARSE && size > store_part_bytes()) {
+		printf("aml_burn: image 0x%llx > partition %s (0x%llx B)\n",
+		       (unsigned long long)size, part,
+		       (unsigned long long)store_part_bytes());
+		return -ENOSPC;
+	}
+
+	img->kind = kind;
+	img->active = true;
+	img->total = size;
+	img->next_seq = 0;
+	strlcpy(img->part, part, sizeof(img->part));
+	strlcpy(img->type, type, sizeof(img->type));
+
+	if (kind == AML_IMG_SPARSE)
+		sparse_need_hdr(&img->sparse, AML_SPARSE_FILE_HDR, 28);
+
+	printf("aml_burn: download %s/%s type %s size 0x%llx\n", media, part,
+	       type, (unsigned long long)size);
+
+	return 0;
+}
+
+int aml_img_write(struct aml_burn_img *img, const u8 *data, u32 len)
+{
+	int ret;
+
+	if (!img->active)
+		return -EPERM;
+	if (img->wire + len > img->total) {
+		printf("aml_burn: host sent 0x%x bytes past the end of %s\n",
+		       len, img->part);
+		return -EINVAL;
+	}
+
+	if (img->kind == AML_IMG_SPARSE) {
+		ret = sparse_feed(img, data, len);
+	} else {
+		ret = store_write(img->media_off, data, len);
+		if (!ret)
+			img->media_off += len;
+	}
+	if (ret) {
+		img->failed = true;
+		return ret;
+	}
+
+	img->wire += len;
+	if (img->wire == img->total) {
+		img->complete = true;
+		printf("aml_burn: %s complete (0x%llx bytes)\n", img->part,
+		       (unsigned long long)img->wire);
+	}
+
+	return 0;
+}
+
+static int img_sha1(const struct aml_burn_img *img, u8 *digest)
+{
+	sha1_context ctx;
+	u64 left = img->total;
+	u64 off = 0;
+
+	sha1_starts(&ctx);
+
+	while (left) {
+		u32 chunk = min_t(u64, left, AML_BURN_SHA1_CHUNK);
+		int ret;
+
+		ret = store_read(off, store_rd_bounce, chunk);
+		if (ret)
+			return ret;
+		sha1_update(&ctx, store_rd_bounce, chunk);
+		off += chunk;
+		left -= chunk;
+	}
+
+	sha1_finish(&ctx, digest);
+
+	return 0;
+}
+
+int aml_img_verify_sha1(const struct aml_burn_img *img, const char *hex)
+{
+	char sum[41];
+	u8 digest[20];
+	int i, ret;
+
+	if (!img->active || !img->complete)
+		return -EPERM;
+
+	if (img->kind == AML_IMG_SPARSE) {
+		printf("aml_burn: sha1 verification of sparse images is not supported\n");
+		return -ENOTSUPP;
+	}
+
+	ret = img_sha1(img, digest);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 20; i++)
+		sprintf(sum + i * 2, "%02x", digest[i]);
+	sum[40] = '\0';
+
+	if (strcasecmp(sum, hex)) {
+		printf("aml_burn: verify failed for %s: want %s, got %s\n",
+		       img->part, hex, sum);
+		return -EINVAL;
+	}
+
+	printf("aml_burn: verify ok for %s (%s)\n", img->part, sum);
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Readback (0x33)							*/
+/* ------------------------------------------------------------------ */
+
+/*
+ * Copy `len' bytes of the device address space.  The AO secure word is read
+ * through the secure APB, a normal access aborts the bus, so report it as
+ * zero: pyamlboot only asks for it to decide whether secure boot is on.
+ */
+static void aml_mem_read(u64 addr, u8 *buf, u32 len)
+{
+	const u64 reg = AML_BURN_SECURE_REG;
+	u64 end = addr + len;
+
+	if (end <= reg || addr >= reg + 4) {
+		memcpy(buf, (const void *)(uintptr_t)addr, len);
+		return;
+	}
+
+	if (addr < reg) {
+		u32 n = min_t(u32, (u32)(reg - addr), len);
+
+		memcpy(buf, (const void *)(uintptr_t)addr, n);
+		buf += n;
+		len -= n;
+		addr += n;
+	}
+
+	if (len) {
+		u32 n = min_t(u32, 4 - (u32)(addr - reg), len);
+
+		memset(buf, 0, n);
+		buf += n;
+		len -= n;
+		addr += n;
+	}
+
+	if (len)
+		memcpy(buf, (const void *)(uintptr_t)addr, len);
+}
+
+int aml_up_begin(const char *media, const char *part, const char *type,
+		 u64 size, struct aml_burn_upload *up)
+{
+	int ret;
+
+	memset(up, 0, sizeof(*up));
+
+	if (!size) {
+		printf("aml_burn: bad upload size 0x%llx\n",
+		       (unsigned long long)size);
+		return -EINVAL;
+	}
+
+	if (!strcmp(media, "mem")) {
+		char *endp;
+		u64 addr = simple_strtoull(part, &endp, 0);
+
+		if (endp == part || *endp) {
+			printf("aml_burn: upload mem needs a hex address\n");
+			return -ENOTSUPP;
+		}
+		up->kind = AML_UP_MEM;
+		up->addr = addr;
+	} else if (!strcmp(media, "store")) {
+		if (!strcmp(type, "sparse")) {
+			printf("aml_burn: sparse readback is not supported\n");
+			return -ENOTSUPP;
+		}
+		ret = aml_store_select(part);
+		if (ret)
+			return ret;
+		if (size > store_part_bytes()) {
+			printf("aml_burn: upload 0x%llx > partition %s (0x%llx B)\n",
+			       (unsigned long long)size, part,
+			       (unsigned long long)store_part_bytes());
+			return -ENOSPC;
+		}
+		up->kind = AML_UP_STORE;
+	} else {
+		printf("aml_burn: upload media \"%s\" not supported (mem, store)\n",
+		       media);
+		return -ENOTSUPP;
+	}
+
+	up->total = size;
+	up->active = true;
+
+	printf("aml_burn: upload %s/%s type %s size 0x%llx\n", media, part,
+	       type, (unsigned long long)size);
+
+	return 0;
+}
+
+int aml_up_read(struct aml_burn_upload *up, u64 off, u8 *buf, u32 len)
+{
+	if (!up->active)
+		return -EPERM;
+
+	if (off + len > up->total)
+		return -EINVAL;
+
+	if (up->kind == AML_UP_MEM) {
+		aml_mem_read(up->addr + off, buf, len);
+		return 0;
+	}
+
+	return store_read(off, buf, len);
+}
