OWNER(g:yandex_io)

LIBRARY()

INCLUDE(${ARCADIA_ROOT}/smart_devices/third_party/gecko_sdk/gecko.inc)

ADDINCL(
    GLOBAL smart_devices/third_party/gecko_sdk/platform/bootloader
)

PEERDIR(
    smart_devices/third_party/gecko_sdk/hardware/module
    smart_devices/third_party/gecko_sdk/platform/emlib
    smart_devices/third_party/gecko_sdk/platform/halconfig
    smart_devices/third_party/gecko_sdk/util/third_party/crypto/mbedtls
    smart_devices/third_party/gecko_sdk/util/third_party/crypto/sl_component/se_manager
)

IF (SL_BOOTLOADER_SIGNED_UPGRADE)
    CFLAGS(GLOBAL -DBOOTLOADER_ENFORCE_SIGNED_UPGRADE)
ENDIF()

IF (SL_BOOTLOADER_ENFORCE_ENCRYPTED_UPGRADE)
    CFLAGS(GLOBAL -DBOOTLOADER_ENFORCE_ENCRYPTED_UPGRADE)
ENDIF()

IF (SL_BOOTLOADER_USE_SYMMETRIC_KEY_FROM_SE_STORAGE)
    CFLAGS(GLOBAL -DBOOTLOADER_USE_SYMMETRIC_KEY_FROM_SE_STORAGE)
ENDIF()

IF (SL_BOOTLOADER_ENFORCE_SECURE_BOOT)
    CFLAGS(GLOBAL -DBOOTLOADER_ENFORCE_SECURE_BOOT)

    IF (SL_BOOTLOADER_SUPPORT_CERTIFICATES)
        CFLAGS(GLOBAL -DBOOTLOADER_SUPPORT_CERTIFICATES)

        IF (SL_BOOTLOADER_REJECT_DIRECT_SIGNED_IMG)
            CFLAGS(GLOBAL -DBOOTLOADER_REJECT_DIRECT_SIGNED_IMG)
        ENDIF()
    ENDIF()

    IF (SL_BOOTLOADER_ROLLBACK_PROTECTION)
        CFLAGS(GLOBAL -DBOOTLOADER_ROLLBACK_PROTECTION)

        IF (SL_BOOTLOADER_ROLLBACK_PROTECTION_MINIMUM_VERSION)
            CFLAGS(GLOBAL -DBOOTLOADER_ROLLBACK_PROTECTION_MINIMUM_VERSION=${SL_BOOTLOADER_ROLLBACK_PROTECTION_MINIMUM_VERSION})
        ENDIF()
    ENDIF()

    IF (SL_APPLICATION_WRITE_DISABLE)
        CFLAGS(GLOBAL -DAPPLICATION_WRITE_DISABLE)
    ENDIF()
ENDIF()

IF (SL_BOOTLOADER_FALLBACK_LEGACY_KEY)
    CFLAGS(GLOBAL -DBOOTLOADER_FALLBACK_LEGACY_KEY)
ENDIF()

IF (SL_BOOTLOADER_WRITE_DISABLE)
    CFLAGS(GLOBAL -DBOOTLOADER_WRITE_DISABLE)
ENDIF()

IF (SL_APPLICATION_VERIFICATION_SKIP_EM4_RST)
    CFLAGS(GLOBAL -DAPPLICATION_VERIFICATION_SKIP_EM4_RST)
ENDIF()

IF (SL_BOOTLOADER_PLUGIN_GPIO_ACTIVATION)
    CFLAGS(-DBTL_PLUGIN_GPIO_ACTIVATION)
ENDIF()

IF (SL_BOOTLOADER_SUPPORT_COMMUNICATION)
    CFLAGS(-DBOOTLOADER_SUPPORT_COMMUNICATION)
ENDIF()

IF (SL_BOOTLOADER_VERSION_MAIN_CUSTOMER)
    CFLAGS(-DBOOTLOADER_VERSION_MAIN_CUSTOMER=${SL_BOOTLOADER_VERSION_MAIN_CUSTOMER})
ENDIF()

CFLAGS(
    GLOBAL -DBTL_UPGRADE_LOCATION_BASE=32768
    GLOBAL "-DBTL_APP_SPACE_SIZE=((FLASH_BASE+FLASH_SIZE)-BTL_APPLICATION_BASE)"
    GLOBAL -DBTL_CONFIG_FILE=\"config/bootloader-configuration-stub.h\"

    -D__STARTUP_CLEAR_BSS
    -D__START=main
)

LINKER_SCRIPT(GCC/main_btl_main_flash_se.ld)

SRCS(
    btl_bootload.c
    btl_core.c
    btl_main.c

    GCC/main_btl_startup.c

    ../build/lib/libbootloader_efr32xg21_gcc.a
)

END()
