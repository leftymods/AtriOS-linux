IF (SL_CONFIG)
    INCLUDE(${ARCADIA_ROOT}/${SL_CONFIG})
ENDIF()

IF (SL_CONFIGURATION_HEADER)
    CFLAGS(-DCONFIGURATION_HEADER=\"\\\"${SL_CONFIGURATION_HEADER}\\\"\")
ENDIF()

IF (SL_APPLICATION_TOKEN_HEADER)
    CFLAGS(-DAPPLICATION_TOKEN_HEADER=\"\\\"${SL_APPLICATION_TOKEN_HEADER}\\\"\")
ENDIF()

IF (SL_APPLICATION_MFG_TOKEN_HEADER)
    CFLAGS(-DAPPLICATION_MFG_TOKEN_HEADER=\"\\\"${SL_APPLICATION_MFG_TOKEN_HEADER}\\\"\")
ENDIF()

IF (SL_APPLICATION_PRODUCT_ID)
    CFLAGS(-DCUSTOMER_APPLICATION_PRODUCT_ID="${SL_APPLICATION_PRODUCT_ID}")
ENDIF()

ADDINCL(
    smart_devices/third_party/gecko_sdk
)

IF (OS_NONE)
    NO_PLATFORM()
    NO_RUNTIME()

    IF (NOT SL_DEVICE)
        MESSAGE(FATAL_ERROR "Device not specified")
    ENDIF()

    INCLUDE(devices/${SL_DEVICE}.inc)

    CFLAGS(
        -fno-exceptions

        -D${SL_DEVICE_U}
        -D${SL_DEVICE_FAMILY_U}

        -DEZSP_UART

        -DEMBER_SERIAL1_MODE=EMBER_SERIAL_FIFO
        -DEMBER_SERIAL1_TX_QUEUE_SIZE=32
        -DEMBER_SERIAL1_RX_QUEUE_SIZE=64
        -DEMBER_SERIAL1_XONXOFF
    )

    IF (SL_FLOAT_ABI)
        CFLAGS(-mfloat-abi=${SL_FLOAT_ABI})
        LDFLAGS(-mfloat-abi=${SL_FLOAT_ABI})
    ENDIF()
ENDIF()
