{
    "meta": {
        "name": "quasar_symbols_yandexstation_2",
        "maintainer": "Ivan Kalinin <pupssman@yandex-team.ru>",
        "description": "Daemons yandexstation_2 symbols package",
        "default-format": "raw-package",
        "version": "{revision}.{branch}"
    },
    "include": [
        {
            "package": "smart_devices/platforms/yandexstation_2/packages/install_root.json",
            "targets_root": "/quasar"
        }
    ],
    "build": {
        "postprocessing_tool": {
            "targets": [
                "smart_devices/packages/postprocessing"
            ]
        }
    },
    "data": [
        {
            "source": {
                "type": "SANDBOX_RESOURCE",
                "id": "1225628919",
                "untar": true
            },
            "destination": {
                "path": "/toolchain_root/"
            }
        },
        {
            "source": {
                "type": "ARCADIA",
                "path": "yandex_io/local/bin/dump_syms"
            },
            "destination": {
                "path": "/package_bin/"
            }
        }
    ],
    "postprocess": [
        {
            "source": {
                "type": "BUILD_OUTPUT",
                "build_key": "postprocessing_tool",
                "path": "smart_devices/packages/postprocessing/postprocessing"
            },
            "arguments": [
                "toolchain_root"
            ]
        }
    ]
}
