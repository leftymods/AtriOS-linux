# SPDX-License-Identifier: GPL-2.0-only
#
# AtriOS mainline kernel fragment - Yandex Station Max (Amlogic S905X3 / SM1)
#
# Merged by scripts/build-kernel.sh on top of arm64 defconfig:
#   scripts/kconfig/merge_config.sh -m -O <build> <build>/.config configs/atrios.config
#
# Every symbol below was checked against the Linux v7.3 Kconfig sources.
# Where the name we asked for does not exist upstream, the comment says so and
# the real name is used - do not add the non-existent symbol back, it would
# silently do nothing (build-kernel.sh --strict reports such symbols).
#
# "not upstream" marks things that need the port in this tree (drivers/,
# patches/): those symbols only exist after scripts/apply.sh has wired them.

# --- SoC, clocks, pinctrl -------------------------------------------------
CONFIG_ARCH_MESON=y
CONFIG_COMMON_CLK_G12A=y		# "G12 and SM1 SoC clock controllers support"
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_G12A=y		# SM1 uses the G12A pinctrl/PADCTRL block
# NOTE: there is no CONFIG_GPIO_MESON in v7.3 - the GPIO chip is registered by
# pinctrl-meson (PINCTRL_MESON selects GPIOLIB). CONFIG_GPIO_MESON would be
# ignored by the build.
CONFIG_GPIOLIB=y

# --- Serial console -------------------------------------------------------
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y		# earlycon + ttyAML0 console (uart_AO)

# --- Storage: eMMC (sd_emmc_c) and SD (sd_emmc_b) -------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y
# NOTE: CONFIG_MMC_SDHCI_MESON does not exist in v7.3. The S905X3 eMMC/SD/SDIO
# controller is handled by MMC_MESON_GX only; SDHCI is used by other SoCs.

# --- Ethernet: dwmac-meson8b glue + internal GXL PHY ----------------------
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
CONFIG_PHYLIB=y
CONFIG_MESON_GXL_PHY=y

# --- USB (dwc3 in G12A/SM1, host mode for storage sticks) -----------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# --- Display: meson DRM + dw-hdmi, legacy fbdev for the vendor userspace --
CONFIG_DRM=y
CONFIG_DRM_MESON=y
# NOTE: the symbol is DRM_MESON_DW_HDMI, there is no CONFIG_MESON_DW_HDMI.
CONFIG_DRM_MESON_DW_HDMI=y
CONFIG_FB=y
# /dev/fb* needs FB_DEVICE in v7.3 (FB_CORE/FB_DEVICE split); the ring driver
# is opened by userspace as /dev/fb5.
CONFIG_FB_DEVICE=y
# Software fbdev helpers used by drivers/leds/trigger/ledtrig-ringfb.c.
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYSMEM_FOPS=y

# --- Front LED matrix 25x16 (SPI, Gowin FPGA on spicc1) -------------------
CONFIG_SPI=y
CONFIG_SPI_MESON_SPICC=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# NOTE: not upstream - patches/linux/0005 adds FB_ATRIOS_LEDPANEL and
# drivers/video/fbdev/atrios-ledpanel.c, bound by the &spicc1 node in the DTS.
CONFIG_FB_ATRIOS_LEDPANEL=y

# --- LED ring (2x IS31FL3236A + framebuffer trigger) ----------------------
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_IS31FL32XX=y		# patched by patches/linux/0002-*
# NOTE: not upstream. The Kconfig entry is added by scripts/apply.sh together
# with drivers/leds/trigger/ledtrig-ringfb.c.
CONFIG_LEDS_TRIGGER_RINGFB=y

# --- Ambient light sensor (vendor ltr308als01) ---------------------------
CONFIG_IIO=y
# NOTE: upstream symbol is LTRF216A (no IIO_ prefix); the DTS uses the
# upstream compatible liteon,ltr308, so no driver patch is needed.
# Its of_match table has "liteon,ltr308" / "liteon,ltrf216a", while the board
# DTS says "lite-on,ltr308als01" - the node will not probe until the DTS
# compatible (or the driver table) is fixed.  Reported, not worked around.
CONFIG_LTRF216A=y

# --- Input: gpio-keys and the rotary volume knob --------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y			# gpio-keys node (micmute, function)
CONFIG_INPUT_GPIO_ROTARY_ENCODER=y
# NOTE: INPUT_ROTARY_VOLUME is not upstream; patches/linux/0004 adds the
# symbol and drivers/input/misc/rotary-volume.c, matching the board DTS node
# compatible = "yandex,rotary-volume".
CONFIG_INPUT_ROTARY_VOLUME=y
# NOTE: INPUT_ATRIOS_KEYPAD is not upstream; patches/linux/0006 adds it and
# the DTS uses yandex,gpio-keypad (no gpio-keys node).
# symbol and drivers/input/misc/atrios-keypad.c.  The board DTS still carries
# the upstream gpio-keys node, but docs/buttons.md explains that these keys
# need the polling keypad model, so both are enabled until the DTS switches.
CONFIG_INPUT_ATRIOS_KEYPAD=y

# --- Bluetooth: RTL8822CS over UART (H5, serdev) --------------------------
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_RFKILL=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y		# H5 protocol
CONFIG_BT_HCIUART_RTL=y
# NOTE: there is no CONFIG_BT_HCIUART_MESON; the Meson UART is a plain serdev
# host and btrtl handles the RTL8822CS firmware download.

# --- Wi-Fi: RTL8822CS via rtw88/SDIO (modular) ----------------------------
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CS=m
CONFIG_RTW88_8822ES=m
# NOTE: RTL8822ES is not upstream in v7.3; patches/linux/0010+0011 add the
# SDIO ID, the 8822E tables and a 8822E hw_spec.  Firmware goes to
# /lib/firmware/rtw88/rtw8822e_fw.bin (mainline/firmware).


# --- Audio: SM1 AXG/G12A card + ported codecs ------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_MESON_CARD_UTILS=y
CONFIG_SND_MESON_CODEC_GLUE=m
CONFIG_SND_MESON_AXG_FIFO=y
CONFIG_SND_MESON_AXG_FRDDR=y
CONFIG_SND_MESON_AXG_TODDR=y
CONFIG_SND_MESON_AXG_TDM_FORMATTER=y
CONFIG_SND_MESON_AXG_TDM_INTERFACE=y
CONFIG_SND_MESON_AXG_TDMIN=y
CONFIG_SND_MESON_AXG_TDMOUT=y
CONFIG_SND_MESON_AXG_PDM=y
CONFIG_SND_MESON_AXG_SOUND_CARD=y
# NOTE: the three codecs are not upstream; patches/linux/0007..0009 add them.
CONFIG_SND_SOC_ES7210=m
CONFIG_SND_SOC_ES8156=m
CONFIG_SND_SOC_SY6045S=m

# --- Filesystems / early boot --------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y

# --- Regulators (fixed 20V amp rail in the board DTS) --------------------
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- Identify the build --------------------------------------------------
CONFIG_LOCALVERSION="-atrios"
